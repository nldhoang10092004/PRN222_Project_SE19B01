@model WebApplication1.Areas.Learner.Controllers.ListeningHubViewModel
@{
    ViewData["Title"] = "Trung Tâm Luyện Nghe (Listening Practice)";
    var levels = new[] { "ALL", "N5", "N4", "N3", "N2", "N1" };
}

<div class="container py-4">
    <!-- Header Hero Banner -->
    <div class="card border-0 rounded-4 shadow-sm text-white mb-4 overflow-hidden" style="background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <span class="badge bg-white text-danger font-monospace px-3 py-2 rounded-pill mb-3">
                        <i class="bi bi-headphones me-1"></i> LISTENING PRACTICE
                    </span>
                    <h1 class="fw-bold fs-2 mb-2">Trung Tâm Luyện Nghe Tiếng Nhật</h1>
                    <p class="text-white-50 mb-4">
                        Rèn luyện kỹ năng nghe hiểu JLPT qua các bài luyện nghe thực tế từ N5 đến N1 được thiết kế trực tiếp bởi giáo viên.
                    </p>
                    <div class="d-flex flex-wrap gap-3 text-white small">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-collection-play me-2 fs-5"></i>
                            <span><strong>@Model.TotalCount</strong> Bài luyện nghe</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle me-2 fs-5 text-warning"></i>
                            <span><strong>@Model.CompletedCount</strong> Bài đã đạt (≥80%)</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-center text-md-end mt-4 mt-md-0 d-none d-md-block">
                    <i class="bi bi-broadcast-pin text-white-50" style="font-size: 8rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- JLPT Level Filter Tabs -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
        <div class="btn-group p-1 bg-light rounded-pill shadow-sm" role="group">
            @foreach (var lvl in levels)
            {
                var isActive = Model.SelectedLevel == lvl;
                <a href="/learn/Practice/Listening?level=@lvl"
                   class="btn btn-sm rounded-pill px-3 py-2 text-decoration-none fw-semibold @(isActive ? "btn-danger shadow-sm text-white" : "btn-light text-secondary")">
                    @(lvl == "ALL" ? "Tất cả cấp độ" : $"Trình độ {lvl}")
                </a>
            }
        </div>
        <div class="text-muted small">
            Hiển thị <strong>@Model.Exercises.Count</strong> bài tập nghe
        </div>
    </div>

    <!-- Listening Exercise Cards Grid -->
    @if (Model.Exercises.Any())
    {
        <div class="row g-4">
            @foreach (var ex in Model.Exercises)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 rounded-4 shadow-sm hover-elevate transition-all">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 fw-bold fs-7">
                                    @ex.LevelName
                                </span>
                                @if (ex.BestScore.HasValue)
                                {
                                    <span class="badge @(ex.BestScore >= 80 ? "bg-success text-white" : "bg-warning text-dark") rounded-pill px-2.5 py-1">
                                        <i class="bi bi-award me-1"></i> Điểm tốt nhất: @ex.BestScore%
                                    </span>
                                }
                            </div>

                            <h5 class="fw-bold text-dark mb-2 line-clamp-2">@ex.Title</h5>

                            @if (!string.IsNullOrEmpty(ex.CourseTitle))
                            {
                                <div class="text-muted small mb-3">
                                    <i class="bi bi-journal-bookmark me-1 text-danger"></i> @ex.CourseTitle
                                    @if (!string.IsNullOrEmpty(ex.LessonTitle))
                                    {
                                        <span>• @ex.LessonTitle</span>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(ex.Content))
                            {
                                <p class="text-secondary small line-clamp-2 mb-4">@ex.Content</p>
                            }

                            <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between">
                                <div class="text-muted small">
                                    <i class="bi bi-question-circle me-1 text-primary"></i> @ex.QuestionCount câu hỏi
                                </div>
                                <a href="/learn/Practice/ListeningDetail/@ex.ExerciseId" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 fw-bold">
                                    <i class="bi bi-play-circle me-1"></i> Bắt đầu nghe
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 my-4 bg-light rounded-4">
            <i class="bi bi-headphones text-muted display-4 d-block mb-3"></i>
            <h5 class="fw-bold text-secondary">Chưa có bài luyện nghe nào ở trình độ này</h5>
            <p class="text-muted small mb-3">Giáo viên sẽ sớm bổ sung các bài nghe phù hợp cho bạn.</p>
            <a href="/learn/Practice/Listening?level=ALL" class="btn btn-danger btn-sm rounded-pill px-4">
                Xem tất cả bài nghe
            </a>
        </div>
    }
</div>

<style>
    .hover-elevate:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px -6px rgba(0,0,0,0.12) !important;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .transition-all {
        transition: all 0.25s ease-in-out;
    }
</style>
