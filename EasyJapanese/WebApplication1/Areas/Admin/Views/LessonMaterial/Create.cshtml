@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0 fw-bold">Thêm Tài liệu mới</h3>
    <a href="/admin/lesson-materials" class="btn btn-light">Quay lại</a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <form method="post" action="/admin/lesson-materials/create">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="lessonId" class="form-label">Bài học <span class="text-danger">*</span></label>
                <select name="lessonId" id="lessonId" class="form-select" required>
                    <option value="">-- Chọn bài học --</option>
                    @foreach (var lesson in ViewBag.Lessons)
                    {
                        <option value="@lesson.LessonId">@lesson.Title</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label for="title" class="form-label">Tên Tài liệu <span class="text-danger">*</span></label>
                <input type="text" name="title" id="title" class="form-control" placeholder="VD: Bài tập ngữ pháp" required>
            </div>

            <div class="mb-3">
                <label for="url" class="form-label">URL Tài liệu <span class="text-danger">*</span></label>
                <input type="url" name="url" id="url" class="form-control" placeholder="https://..." required>
                <div class="form-text">Nhập đường dẫn đến tài liệu (Google Drive, Dropbox, v.v.)</div>
            </div>

            <div class="mb-3">
                <label for="fileType" class="form-label">Loại File</label>
                <input type="text" name="fileType" id="fileType" class="form-control" placeholder="VD: PDF, Video, DOCX">
            </div>

            <div class="mb-3">
                <label for="sortOrder" class="form-label">Thứ tự sắp xếp</label>
                <input type="number" name="sortOrder" id="sortOrder" class="form-control" value="0">
                <div class="form-text">Số nhỏ hơn sẽ hiển thị trước</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Lưu</button>
                <a href="/admin/lesson-materials" class="btn btn-light">Hủy</a>
            </div>
        </form>
    </div>
</div>
