        border-bottom: 1px solid var(--color-border);
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .practice-heading i {
            color: var(--color-primary);
        }

    .practice-question {
        padding: 18px 20px;
        background: var(--color-bg-soft);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        margin-bottom: 16px;
    }

        .practice-question:last-of-type {
            margin-bottom: 20px;
        }

    .practice-question-text {
        display: flex;
