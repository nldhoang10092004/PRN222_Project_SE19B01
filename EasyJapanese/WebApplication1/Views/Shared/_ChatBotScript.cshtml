<script>
    (function () {
        const toggleBtn = document.getElementById('hjChatbotToggle');
        const closeBtn = document.getElementById('hjChatbotClose');
        const panel = document.getElementById('hjChatbotPanel');

        const tabButtons = document.querySelectorAll('.hj-chatbot-tab');
        const chatTab = document.getElementById('hjChatTab');
        const dictionaryTab = document.getElementById('hjDictionaryTab');
        const supportTab = document.getElementById('hjSupportTab');

        const chatForm = document.getElementById('hjChatForm');
        const chatInput = document.getElementById('hjChatInput');
        const chatMessages = document.getElementById('hjChatMessages');

        const dictionaryForm = document.getElementById('hjDictionaryForm');
        const dictionaryInput = document.getElementById('hjDictionaryInput');
        const dictionaryMessages = document.getElementById('hjDictionaryMessages');

        const supportForm = document.getElementById('hjSupportForm');
        const supportInput = document.getElementById('hjSupportInput');
        const supportMessages = document.getElementById('hjSupportMessages');

        if (!toggleBtn || !closeBtn || !panel ||
            !chatForm || !chatInput || !chatMessages ||
            !dictionaryForm || !dictionaryInput || !dictionaryMessages ||
            !supportForm || !supportInput || !supportMessages) {
            console.error('Không tìm thấy thành phần chatbot.');
            return;
        }

        let activeTab = 'chat';
        let history = [];
        let supportPollInterval = null;

        toggleBtn.addEventListener('click', function () {
            panel.classList.toggle('open');

            if (panel.classList.contains('open')) {
                focusCurrentInput();
                checkPollSupport();
            } else {
                stopPollSupport();
            }
        });

        closeBtn.addEventListener('click', function () {
            panel.classList.remove('open');
            stopPollSupport();
        });

        tabButtons.forEach(function (button) {
            button.addEventListener('click', function () {
                activeTab = button.dataset.tab;

                tabButtons.forEach(function (item) {
                    item.classList.toggle(
                        'active',
                        item.dataset.tab === activeTab
                    );
                });

                if (chatTab) chatTab.classList.toggle('active', activeTab === 'chat');
                if (dictionaryTab) dictionaryTab.classList.toggle('active', activeTab === 'dictionary');
                if (supportTab) supportTab.classList.toggle('active', activeTab === 'support');

                focusCurrentInput();
                checkPollSupport();
            });
        });

        window.openSupportChat = function () {
            panel.classList.add('open');
            const supportTabBtn = document.querySelector('.hj-chatbot-tab[data-tab="support"]');
            if (supportTabBtn) supportTabBtn.click();
        };

        function focusCurrentInput() {
            setTimeout(function () {
                if (activeTab === 'dictionary') {
                    dictionaryInput.focus();
                } else if (activeTab === 'support') {
                    supportInput.focus();
                } else {
                    chatInput.focus();
                }
            }, 50);
        }

        function checkPollSupport() {
            if (activeTab === 'support' && panel.classList.contains('open')) {
                loadSupportMessages();
                if (!supportPollInterval) {
                    supportPollInterval = setInterval(loadSupportMessages, 4000);
                }
            } else {
                stopPollSupport();
            }
        }

        function stopPollSupport() {
            if (supportPollInterval) {
                clearInterval(supportPollInterval);
                supportPollInterval = null;
            }
        }

        function escapeHtml(str) {
            return String(str ?? '').replace(
                /[&<>"']/g,
                function (c) {
                    return {
                        '&': '&amp;',
                        '<': '&lt;',
                        '>': '&gt;',
                        '"': '&quot;',
                        "'": '&#39;'
                    }[c];
                }
            );
        }

        function formatMessage(text) {
            return escapeHtml(text)
                .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                .replace(/\n/g, '<br>');
        }

        function appendMessage(container, text, type) {
            const div = document.createElement('div');

            div.className = 'hj-chatbot-msg ' + type;
            div.innerHTML = formatMessage(text);

            container.appendChild(div);
            scrollToBottom(container);
        }

        function appendDictionaryCard(container, card) {
            if (!card) {
                return false;
            }

            const div = document.createElement('div');
            div.className = 'hj-chatbot-dict-card';

            div.innerHTML =
                '<div class="hj-chatbot-dict-word">' +
                    escapeHtml(card.word || '') +
                '</div>' +

                (
                    card.reading
                        ? '<div class="hj-chatbot-dict-reading">' +
                            escapeHtml(card.reading) +
                          '</div>'
                        : ''
                ) +

                '<div class="hj-chatbot-dict-meaning">' +
                    escapeHtml(
                        (card.meanings || []).join('; ')
                    ) +
                '</div>';

            container.appendChild(div);
            scrollToBottom(container);

            return true;
        }

        function showTyping(container, id, text) {
            hideTyping(id);

            const div = document.createElement('div');
            div.className = 'hj-chatbot-typing';
            div.id = id;

            div.innerHTML =
                '<i class="bi bi-three-dots"></i> ' +
                escapeHtml(text);

            container.appendChild(div);
            scrollToBottom(container);
        }

        function hideTyping(id) {
            const el = document.getElementById(id);

            if (el) {
                el.remove();
            }
        }

        function scrollToBottom(container) {
            container.scrollTop = container.scrollHeight;
        }

        async function sendRequest(payload) {
            const response = await fetch('/Chat/SendMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            const data = await response.json();

            if (!response.ok) {
                throw new Error(
                    data.error ||
                    data.reply ||
                    'Có lỗi xảy ra.'
                );
            }

            return data;
        }

        let userSignalrConn = null;
        let currentTicketId = 0;
        let userEmail = '';
        let userFullName = '';

        async function initUserSignalR() {
            if (!userSignalrConn && window.signalR) {
                userSignalrConn = new signalR.HubConnectionBuilder()
                    .withUrl('/hubs/supportChat')
                    .withAutomaticReconnect()
                    .build();

                userSignalrConn.on('ReceiveMessage', function (data) {
                    if (data.ticketId === currentTicketId) {
                        appendSupportBubble(data.sender, data.messageText, data.sentAt);
                    }
                });

                try {
                    await userSignalrConn.start();
                    if (currentTicketId > 0) {
                        await userSignalrConn.invoke('JoinTicketGroup', currentTicketId);
                    }
                } catch (err) {
                    console.error('Lỗi kết nối SignalR User:', err);
                }
            }
        }

        async function loadSupportMessages() {
            try {
                const response = await fetch('/Chat/GetSupportMessages');
                if (!response.ok) return;
                const data = await response.json();

                currentTicketId = data.ticketId;
                userEmail = data.userEmail;
                userFullName = data.userFullName;

                renderSupportMessages(data.messages || []);
                await initUserSignalR();
                if (userSignalrConn && userSignalrConn.state === signalR.HubConnectionState.Connected) {
                    await userSignalrConn.invoke('JoinTicketGroup', currentTicketId);
                }
            } catch (err) {
                console.error('Lỗi tải tin nhắn support:', err);
            }
        }

        function appendSupportBubble(sender, messageText, sentAt) {
            const isUser = (sender === 'User');
            const div = document.createElement('div');
            div.className = 'hj-chatbot-msg ' + (isUser ? 'user' : 'admin');
            
            const timeSpan = sentAt ? ' <small style="font-size:10px; opacity:0.75; display:block; margin-top:2px;">' + escapeHtml(sentAt) + '</small>' : '';
            const senderPrefix = !isUser ? '<strong>[Admin]</strong> ' : '';
            div.innerHTML = senderPrefix + escapeHtml(messageText) + timeSpan;
            
            supportMessages.appendChild(div);
            scrollToBottom(supportMessages);
        }

        function renderSupportMessages(messages) {
            supportMessages.innerHTML = '<div class="hj-chatbot-msg bot">Xin chào! Nhập nội dung bên dưới để chat trực tiếp với đội ngũ Admin hỗ trợ.</div>';
            
            messages.forEach(m => {
                const div = document.createElement('div');
                const isUser = (m.sender === 'User');
                div.className = 'hj-chatbot-msg ' + (isUser ? 'user' : 'admin');
                
                const timeSpan = m.sentAt ? ' <small style="font-size:10px; opacity:0.75; display:block; margin-top:2px;">' + escapeHtml(m.sentAt) + '</small>' : '';
                const senderPrefix = !isUser ? '<strong>[Admin]</strong> ' : '';
                div.innerHTML = senderPrefix + escapeHtml(m.messageText) + timeSpan;
                
                supportMessages.appendChild(div);
            });
            scrollToBottom(supportMessages);
        }

        // TAB CHAT
        chatForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            const text = chatInput.value.trim();

            if (!text) {
                return;
            }

            appendMessage(chatMessages, text, 'user');

            chatInput.value = '';
            chatInput.disabled = true;

            showTyping(
                chatMessages,
                'hjChatTyping',
                'Đang trả lời...'
            );

            try {
                const data = await sendRequest({
                    message: text,
                    mode: 'chat',
                    history: history
                });

                hideTyping('hjChatTyping');

                appendMessage(
                    chatMessages,
                    data.reply ||
                    'Mình chưa có câu trả lời phù hợp.',
                    'bot'
                );

                history.push({
                    role: 'user',
                    content: text
                });

                history.push({
                    role: 'model',
                    content: data.reply || ''
                });
            } catch (error) {
                hideTyping('hjChatTyping');

                appendMessage(
                    chatMessages,
                    error.message ||
                    'Xin lỗi, có lỗi xảy ra.',
                    'bot'
                );
            } finally {
                chatInput.disabled = false;
                chatInput.focus();
            }
        });

        // TAB TỪ ĐIỂN
        dictionaryForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            const word = dictionaryInput.value.trim();

            if (!word) {
                return;
            }

            appendMessage(
                dictionaryMessages,
                word,
                'user'
            );

            dictionaryInput.value = '';
            dictionaryInput.disabled = true;

            showTyping(
                dictionaryMessages,
                'hjDictionaryTyping',
                'Đang tra từ...'
            );

            try {
                const data = await sendRequest({
                    message: word,
                    mode: 'dictionary',
                    history: []
                });

                hideTyping('hjDictionaryTyping');

                const hasCard = appendDictionaryCard(
                    dictionaryMessages,
                    data.dictionaryCard
                );

                if (!hasCard) {
                    appendMessage(
                        dictionaryMessages,
                        data.reply ||
                        'Không tìm thấy từ này.',
                        'bot'
                    );
                }
            } catch (error) {
                hideTyping('hjDictionaryTyping');

                appendMessage(
                    dictionaryMessages,
                    error.message ||
                    'Không thể tra từ lúc này.',
                    'bot'
                );
            } finally {
                dictionaryInput.disabled = false;
                dictionaryInput.focus();
            }
        });

        // TAB HỖ TRỢ ADMIN
        supportForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            const text = supportInput.value.trim();

            if (!text) {
                return;
            }

            supportInput.value = '';

            if (userSignalrConn && userSignalrConn.state === signalR.HubConnectionState.Connected && currentTicketId > 0) {
                try {
                    await userSignalrConn.invoke('SendUserMessage', currentTicketId, text, userEmail, userFullName);
                    return;
                } catch (err) {
                    console.error('Lỗi gửi SignalR user message:', err);
                }
            }

            try {
                const response = await fetch('/Chat/SendSupportMessage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ message: text })
                });

                const data = await response.json();
                if (response.ok && data.messages) {
                    renderSupportMessages(data.messages);
                } else {
                    appendMessage(supportMessages, data.error || 'Lỗi gửi tin nhắn.', 'bot');
                }
            } catch (error) {
                appendMessage(supportMessages, 'Không thể gửi tin nhắn hỗ trợ lúc này.', 'bot');
            } finally {
                supportInput.focus();
            }
        });
    })();
</script>