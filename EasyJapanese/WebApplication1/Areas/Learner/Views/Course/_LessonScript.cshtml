<script>
    (function () {
        const sidebar = document.getElementById('lessonSidebar');
        const toggleEl = document.getElementById('sidebarToggle');
        const icon = document.getElementById('toggleIcon');

        const tabItems = document.querySelectorAll('.lesson-tab-item');
        const tabPanels = document.querySelectorAll('.lesson-tab-panel');

        function escapeHtml(s) {
            return String(s).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }

        // ==========================================================
        // Toggle sidebar
        // ==========================================================
        if (toggleEl && sidebar && icon) {
            toggleEl.addEventListener('click', function () {
                const collapsed = sidebar.classList.toggle('collapsed');

                icon.className = collapsed
                    ? 'bi bi-layout-sidebar'
                    : 'bi bi-layout-sidebar-reverse';
            });
        }

        // ==========================================================
        // Chuyển tab ngang
        // ==========================================================
        function activateTab(item) {
            const targetId = item.getAttribute('data-panel');

            tabItems.forEach(function (tab) {
                tab.classList.remove('active');
            });
            item.classList.add('active');

            tabPanels.forEach(function (panel) {
                panel.classList.remove('active');
            });

            const targetPanel = document.getElementById(targetId);
            if (targetPanel) {
                targetPanel.classList.add('active');
            }
        }

        tabItems.forEach(function (item) {
            item.addEventListener('click', function () {
                activateTab(this);
            });
        });

        // Tab đầu tiên hiển thị theo mặc định
        if (tabItems.length > 0) {
            activateTab(tabItems[0]);
        }

        // ==========================================================
        // Audio player
        // ==========================================================
        let currentAudio = null;
        let currentButton = null;
        let currentProgressFill = null;

        document.querySelectorAll('.audio-play-btn[data-audio]').forEach(function (btn) {

            const audioUrl = btn.getAttribute('data-audio');

            if (!audioUrl) return;

            btn.addEventListener('click', function () {

                const url = this.getAttribute('data-audio');

                if (!url) return;

                const card = this.closest('.audio-card');
                const progressFill = card
                    ? card.querySelector('.audio-progress-fill')
                    : null;

                const iconEl = this.querySelector('i');

                // Nếu click đúng bài đang phát thì pause
                if (currentAudio && currentAudio._url === url) {

                    if (!currentAudio.paused) {
                        currentAudio.pause();

                        if (iconEl) {
                            iconEl.className = 'bi bi-play-fill';
                        }

                        return;
                    }

                    currentAudio.play();

                    if (iconEl) {
                        iconEl.className = 'bi bi-pause-fill';
                    }

                    return;
                }

                // Dừng audio cũ nếu đang phát
                if (currentAudio) {
                    currentAudio.pause();

                    if (currentButton) {
                        const oldIcon = currentButton.querySelector('i');

                        if (oldIcon) {
                            oldIcon.className = 'bi bi-play-fill';
                        }
                    }

                    if (currentProgressFill) {
                        currentProgressFill.style.width = '0%';
                    }
                }

                // Tạo audio mới
                currentAudio = new Audio(url);
                currentAudio._url = url;

                currentButton = this;
                currentProgressFill = progressFill;

                if (iconEl) {
                    iconEl.className = 'bi bi-pause-fill';
                }

                currentAudio.addEventListener('timeupdate', function () {
                    if (this.duration && progressFill) {
                        const percent = (this.currentTime / this.duration) * 100;
                        progressFill.style.width = percent + '%';
                    }
                });

                currentAudio.addEventListener('ended', function () {
                    if (iconEl) {
                        iconEl.className = 'bi bi-play-fill';
                    }

                    if (progressFill) {
                        progressFill.style.width = '0%';
                    }

                    currentAudio = null;
                    currentButton = null;
                    currentProgressFill = null;
                });

                currentAudio.addEventListener('error', function () {
                    if (iconEl) {
                        iconEl.className = 'bi bi-play-fill';
                    }

                    if (progressFill) {
                        progressFill.style.width = '0%';
                    }

                    alert('Không thể phát audio. Kiểm tra lại AudioUrl trong database.');

                    currentAudio = null;
                    currentButton = null;
                    currentProgressFill = null;
                });

                currentAudio.play().catch(function () {
                    if (iconEl) {
                        iconEl.className = 'bi bi-play-fill';
                    }

                    alert('Không thể phát audio. Kiểm tra lại AudioUrl trong database.');
                });
            });
        });

        // ==========================================================
        // Nút Practice của từng Exercise (ngữ pháp / đọc / nghe / kanji)
        // ==========================================================
        document.querySelectorAll('.btn-practice').forEach(function (button) {
            button.addEventListener('click', function () {
                const exerciseId = this.getAttribute('data-exercise-id');
                const exerciseTitle = this.getAttribute('data-exercise-title') || 'Luyện tập';

                if (!exerciseId) return;

                const area = document.getElementById('practice-' + exerciseId);
                if (!area) return;

                // Toggle: nếu đang mở và đã load rồi thì đóng lại
                if (area.classList.contains('opened')) {
                    area.classList.remove('opened');
                    return;
                }

                area.classList.add('opened');

                // Nếu đã load câu hỏi trước đó thì không load lại
                if (area.dataset.loaded === '1') return;

                area.innerHTML = '<div class="practice-loading"><i class="bi bi-arrow-repeat"></i> Đang tải câu hỏi...</div>';

                fetch('/learn/Course/ExercisePractice?exerciseId=' + exerciseId)
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        renderPractice(area, exerciseId, exerciseTitle, data.questions || []);
                        area.dataset.loaded = '1';
                    })
                    .catch(function () {
                        area.innerHTML = '<div class="practice-warning"><i class="bi bi-exclamation-triangle"></i> Không thể tải bài luyện tập. Vui lòng thử lại.</div>';
                    });
            });
        });

        function renderPractice(area, exerciseId, exerciseTitle, questions) {
            if (!questions.length) {
                area.innerHTML = '<div class="practice-empty"><i class="bi bi-inbox"></i> Bài luyện tập đang được cập nhật.</div>';
                return;
            }

            let html = '<div class="practice-box">';
            html += '<div class="practice-heading"><i class="bi bi-pencil-square"></i>' + escapeHtml(exerciseTitle) + '</div>';

            questions.forEach(function (q, qIndex) {
                html += '<div class="practice-question" data-question-id="' + q.questionId + '">';
                html += '<div class="practice-question-text">' + (qIndex + 1) + '. ' + escapeHtml(q.questionText) + '</div>';
                (q.options || []).forEach(function (opt) {
                    html += '<label class="practice-option">' +
                        '<input type="radio" name="practice-q-' + q.questionId + '" value="' + opt.optionId + '" />' +
                        '<span>' + escapeHtml(opt.answerText) + '</span>' +
                        '</label>';
                });
                html += '</div>';
            });

            html += '<button type="button" class="btn-submit-practice" data-exercise-id="' + exerciseId + '">Nộp bài</button>';
            html += '<div class="practice-result"></div>';
            html += '</div>';

            area.innerHTML = html;

            area.querySelector('.btn-submit-practice').addEventListener('click', function () {
                submitPractice(area, exerciseId, questions);
            });
        }

        function submitPractice(area, exerciseId, questions) {
            const answers = [];
            let unanswered = false;

            questions.forEach(function (q) {
                const checked = area.querySelector('input[name="practice-q-' + q.questionId + '"]:checked');
                if (!checked) {
                    unanswered = true;
                    return;
                }
                answers.push({ questionId: q.questionId, optionId: parseInt(checked.value, 10) });
            });

            if (unanswered) {
                alert('Vui lòng trả lời tất cả câu hỏi trước khi nộp bài.');
                return;
            }

            fetch('/learn/Course/CheckExercise', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ exerciseId: parseInt(exerciseId, 10), answers: answers })
            })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    let correctCount = 0;
                    (data.answers || []).forEach(function (result) {
                        const questionBlock = area.querySelector('.practice-question[data-question-id="' + result.questionId + '"]');
                        if (!questionBlock) return;

                        if (result.isCorrect) correctCount++;

                        questionBlock.querySelectorAll('.practice-option').forEach(function (label) {
                            const input = label.querySelector('input');
                            label.classList.remove('correct', 'incorrect');
                            if (parseInt(input.value, 10) === result.correctOptionId) {
                                label.classList.add('correct');
                            } else if (input.checked && !result.isCorrect) {
                                label.classList.add('incorrect');
                            }
                            input.disabled = true;
                        });
                    });

                    const resultBox = area.querySelector('.practice-result');
                    resultBox.innerHTML = '<div class="practice-score"><i class="bi bi-check-circle"></i>Kết quả: ' +
                        correctCount + ' / ' + questions.length + ' câu đúng</div>';

                    area.querySelector('.btn-submit-practice').disabled = true;
                })
                .catch(function () {
                    alert('Có lỗi khi nộp bài luyện tập. Vui lòng thử lại.');
                });
        }

        // ==========================================================
        // Đánh dấu hoàn thành bài học
        // ==========================================================
        const completeBtn = document.getElementById('btnCompleteLesson');
        if (completeBtn) {
            completeBtn.addEventListener('click', function () {
                if (completeBtn.classList.contains('completed')) return;

                const lessonId = parseInt(completeBtn.getAttribute('data-lesson-id'), 10);
                completeBtn.disabled = true;

                fetch('/learn/Course/UpdateProgress', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ lessonId: lessonId, isCompleted: true })
                })
                    .then(function (res) {
                        if (!res.ok) throw new Error('Không thể cập nhật tiến độ.');
                        return res.json();
                    })
                    .then(function () {
                        completeBtn.classList.add('completed');
                        const icon = completeBtn.querySelector('i');
                        const label = completeBtn.querySelector('.btn-complete-label');
                        if (icon) icon.className = 'bi bi-check-circle-fill';
                        if (label) label.textContent = 'Đã hoàn thành';

                        const currentLessonItem = document.querySelector('.lesson-list-item.active');
                        if (currentLessonItem) {
                            currentLessonItem.classList.add('completed');
                            const statusIcon = currentLessonItem.querySelector('.lesson-status-icon i');
                            if (statusIcon) statusIcon.className = 'bi bi-check-circle-fill';
                        }
                    })
                    .catch(function () {
                        completeBtn.disabled = false;
                        alert('Không thể lưu tiến độ. Vui lòng thử lại.');
                    });
            });
        }

    })();
</script>
