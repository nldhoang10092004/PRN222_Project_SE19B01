<style>
    :root {
        --lesson-sidebar-w: 280px;
        --lesson-sidebar-collapsed: 56px;
        --radius-full: 9999px;
    }

    /* SHELL */
    .lesson-shell {
        display: flex;
        min-height: calc(100vh - 60px);
        background: var(--color-bg-soft);
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
    }

    /* ═══ SIDEBAR ═══ */
    .lesson-sidebar {
        width: var(--lesson-sidebar-w);
        background: var(--color-bg);
        border-right: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        transition: width .22s ease;
        overflow: hidden;
        position: sticky;
        top: 60px;
        align-self: flex-start;
        height: calc(100vh - 60px);
    }

        .lesson-sidebar.collapsed {
            width: var(--lesson-sidebar-collapsed);
        }

    .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 16px;
        border-bottom: 1px solid var(--color-border);
        flex-shrink: 0;
    }

    .sidebar-course-title {
        font-size: 14px;
        font-weight: 700;
        color: var(--color-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: opacity .15s;
    }

    .lesson-sidebar.collapsed .sidebar-course-title {
        opacity: 0;
        width: 0;
    }

    .sidebar-toggle-btn {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: var(--color-bg-soft);
        color: var(--color-text-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
        cursor: pointer;
        transition: background .15s, color .15s;
    }

        .sidebar-toggle-btn:hover {
            background: var(--color-primary);
            color: var(--color-text-inverse);
        }

    .sidebar-lesson-list {
        flex: 1;
        overflow-y: auto;
        padding: 8px 0;
    }

    .lesson-list-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 16px;
        text-decoration: none;
        border-left: 3px solid transparent;
        transition: background .12s, border-color .12s;
        white-space: nowrap;
    }

        .lesson-list-item:hover {
            background: var(--color-bg-soft);
        }

        .lesson-list-item.active {
            border-left-color: var(--color-primary);
            background: var(--color-primary-soft);
        }

    .lesson-status-icon {
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        color: var(--color-text-subtle);
        flex-shrink: 0;
    }

    .lesson-list-item.completed .lesson-status-icon {
        color: #198754;
    }

    .lesson-list-item.active .lesson-status-icon {
        color: var(--color-primary);
    }

    .lesson-list-title {
        font-size: 13.5px;
        font-weight: 600;
        color: var(--color-text-muted);
        overflow: hidden;
        text-overflow: ellipsis;
        transition: opacity .15s;
    }

    .lesson-list-item.active .lesson-list-title {
        color: var(--color-primary);
        font-weight: 700;
    }

    .lesson-sidebar.collapsed .lesson-list-title {
        opacity: 0;
        width: 0;
    }

    .lesson-sidebar.collapsed .lesson-list-item {
        justify-content: center;
        padding: 10px 0;
    }

    /* ═══ MAIN ═══ */
    .lesson-main {
        flex: 1;
        min-width: 0;
        overflow-y: auto;
        padding: 24px 32px 60px;
    }

    .lesson-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }

    .lesson-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--color-text-subtle);
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: color .15s;
    }

        .lesson-back:hover {
            color: var(--color-primary);
        }

    .lesson-topbar-right {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    .btn-complete-lesson {
        background: var(--color-bg);
        color: #198754;
        border: 1.5px solid #198754;
        border-radius: var(--radius-full);
        font-weight: 700;
        font-size: 13.5px;
        padding: 9px 20px;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: background .15s, color .15s, opacity .15s;
    }

        .btn-complete-lesson:hover:not(:disabled) {
            background: #198754;
            color: #fff;
        }

        .btn-complete-lesson.completed {
            background: #198754;
            color: #fff;
            cursor: default;
            opacity: .9;
        }

    .btn-quiz {
        background: var(--color-primary);
        color: var(--color-text-inverse);
        border: none;
        border-radius: var(--radius-full);
        font-weight: 700;
        font-size: 13.5px;
        padding: 9px 20px;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: opacity .15s;
        text-decoration: none;
    }

        .btn-quiz:hover {
            opacity: .88;
            color: var(--color-text-inverse);
        }

    .lesson-header {
        margin-bottom: 18px;
    }

    .lesson-level {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--color-primary);
        display: block;
        margin-bottom: 4px;
    }

    .lesson-title {
        font-size: 25px;
        font-weight: 800;
        color: var(--color-text);
        margin: 0;
        line-height: 1.25;
    }

    /* ═══ VIDEO ═══ */
    .lesson-video-wrap {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        overflow: hidden;
        background: #0d1117;
        border-radius: 14px;
        box-shadow: var(--shadow-md);
        margin-bottom: 16px;
    }

        .lesson-video-wrap iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
        }

    .lesson-video-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

    .play-btn {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        border: 3px solid var(--color-primary);
        background: var(--color-primary-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform .2s, background .2s;
    }

        .play-btn:hover {
            transform: scale(1.08);
        }

        .play-btn i {
            font-size: 24px;
            color: var(--color-primary);
            margin-left: 4px;
        }

    .lesson-video-placeholder p {
        color: var(--color-text-subtle);
        font-size: 13px;
        margin: 0;
    }

    /* ═══ MÔ TẢ ═══ */
    .lesson-description {
        font-size: 14px;
        line-height: 1.75;
        color: var(--color-text-muted);
        padding: 14px 0 20px;
        border-bottom: 1px solid var(--color-border);
        margin-bottom: 4px;
    }

    /* ═══ TABS NGANG ═══ */
    .lesson-tabs-bar {
        display: flex;
        align-items: center;
        gap: 4px;
        border-bottom: 1px solid var(--color-border);
        margin-top: 20px;
        margin-bottom: 24px;
        overflow-x: auto;
    }

    .lesson-tab-item {
        padding: 12px 18px;
        font-size: 14px;
        font-weight: 600;
        color: var(--color-text-subtle);
        cursor: pointer;
        border-bottom: 2.5px solid transparent;
        white-space: nowrap;
        transition: color .15s, border-color .15s;
    }

        .lesson-tab-item:hover {
            color: var(--color-primary);
        }

        .lesson-tab-item.active {
            color: var(--color-primary);
            border-bottom-color: var(--color-primary);
            font-weight: 700;
        }

    .lesson-tab-panel {
        display: none;
    }

        .lesson-tab-panel.active {
            display: block;
            animation: panelIn .25s ease;
        }

    @@keyframes panelIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .panel-empty {
        text-align: center;
        padding: 40px 0;
        color: var(--color-text-subtle);
        font-size: 14px;
    }

        .panel-empty i {
            font-size: 34px;
            display: block;
            margin-bottom: 12px;
            opacity: .4;
        }

    /* ═══ KANJI ═══ */
    .kanji-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
        gap: 16px;
    }

    .kanji-card {
        border: 1px solid var(--color-border);
        border-radius: 14px;
        padding: 24px 12px;
        text-align: center;
        background: var(--color-bg-soft);
        transition: transform .18s, box-shadow .18s, border-color .18s;
    }

        .kanji-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
            border-color: var(--color-primary);
        }

    .kanji-char {
        font-size: 50px;
        line-height: 1;
        margin-bottom: 10px;
        color: var(--color-text);
        font-family: "Yu Mincho", "MS Mincho", "Hiragino Mincho Pro", serif;
    }

    .kanji-meta {
        font-size: 12.5px;
        color: var(--color-text-subtle);
        line-height: 1.6;
    }

    .kanji-stroke-section {
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid var(--color-border);
    }

    .kanji-stroke-label {
        font-size: 11px;
        font-weight: 600;
        color: var(--color-text-subtle);
        margin-bottom: 8px;
    }

    .kanji-stroke-gif {
        width: 100%;
        max-width: 120px;
        height: auto;
        border-radius: 8px;
        border: 1px solid var(--color-border);
        background: var(--color-bg);
    }

    .kanji-practice {
        margin-top: 12px;
    }

    /* Vùng luyện tập kanji dùng chung — full-width, nằm ngoài .kanji-grid */
    .kanji-practice-area {
        margin-top: 20px;
    }

        .kanji-practice-area:empty {
            display: none;
        }

    /* ═══ GRAMMAR ═══ */
    .grammar-item {
        padding: 18px 0;
        border-bottom: 1px solid var(--color-border);
    }

        .grammar-item:last-child {
            border-bottom: none;
        }

    .grammar-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: 8px;
    }

    .grammar-content {
        font-size: 14px;
        color: var(--color-text-muted);
        line-height: 1.75;
        background: var(--color-bg-soft);
        border-left: 3px solid var(--color-primary);
        padding: 12px 16px;
        border-radius: 0 10px 10px 0;
    }

    /* ═══ READING ═══ */
    .reading-item {
        margin-bottom: 28px;
    }

    .reading-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: 10px;
    }

    .reading-passage {
        background: var(--color-bg-soft);
        border-radius: 12px;
        padding: 20px 24px;
        border-left: 4px solid var(--color-primary);
        font-size: 17px;
        line-height: 2.2;
        color: var(--color-text);
        font-family: "Yu Mincho", "MS Mincho", serif;
    }

    /* ═══ LISTENING ═══ */
    .audio-card {
        display: flex;
        align-items: center;
        gap: 16px;
        background: var(--color-bg-soft);
        border: 1px solid var(--color-border);
        border-radius: 14px;
        padding: 16px 20px;
        margin-bottom: 12px;
    }

    .audio-play-btn {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--color-primary);
        color: var(--color-text-inverse);
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
        transition: opacity .15s;
        cursor: pointer;
    }

        .audio-play-btn:hover {
            opacity: .85;
        }

        .audio-play-btn:disabled {
            opacity: .35;
            cursor: default;
        }

    .audio-info {
        flex: 1;
        min-width: 0;
    }

    .audio-title {
        font-weight: 700;
        font-size: 14px;
        color: var(--color-text);
    }

    .audio-content {
        font-size: 12.5px;
        color: var(--color-text-subtle);
        margin-top: 2px;
    }

    .audio-progress {
        flex: 1;
        height: 4px;
        border-radius: 4px;
        background: var(--color-border);
        overflow: hidden;
        margin-top: 8px;
    }

    .audio-progress-fill {
        height: 100%;
        border-radius: 4px;
        background: var(--color-primary);
        width: 0%;
        transition: width .2s linear;
    }

    /* ═══ TÀI LIỆU ═══ */
    .material-card {
        display: flex;
        align-items: center;
        gap: 14px;
        background: var(--color-bg-soft);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 12px;
        text-decoration: none;
        transition: border-color .15s, box-shadow .15s;
    }

        .material-card:hover {
            border-color: var(--color-primary);
            box-shadow: var(--shadow-sm);
        }

    .material-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: var(--color-primary-soft);
        color: var(--color-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .material-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--color-text);
    }

    /* ═══ PRACTICE (giữ nguyên từ bản cũ) ═══ */
    .btn-practice {
        margin-top: 14px;
        border: 1px solid var(--color-primary);
        background: var(--color-bg);
        color: var(--color-primary);
        border-radius: 999px;
        padding: 7px 14px;
        font-size: 12.5px;
        font-weight: 700;
        cursor: pointer;
        transition: .15s;
    }

        .btn-practice:hover {
            background: var(--color-primary);
            color: var(--color-text-inverse);
        }

    .practice-area {
        display: none;
        margin-top: 16px;
    }

        .practice-area.opened {
            display: block;
        }

    .practice-box {
        background: var(--color-primary-soft);
        border: 1px solid var(--color-primary-light);
        border-radius: 14px;
        padding: 20px;
    }

    .practice-heading {
        font-size: 15px;
        font-weight: 800;
        color: var(--color-text);
        margin-bottom: 18px;
    }

        .practice-heading i {
            color: var(--color-primary);
            margin-right: 6px;
        }

    .practice-question {
        padding: 16px;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        margin-bottom: 14px;
    }

    .practice-question-text {
        font-size: 14px;
        line-height: 1.6;
        color: var(--color-text);
        margin-bottom: 12px;
    }

    .practice-option {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 9px 10px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 13.5px;
        margin-bottom: 4px;
        transition: .15s;
    }

        .practice-option:hover {
            background: var(--color-bg-soft);
        }

        .practice-option input {
            accent-color: var(--color-primary);
        }

    .practice-option.correct {
        background: rgba(25,135,84,.12);
        font-weight: 700;
        color: #198754;
    }

    .practice-option.incorrect {
        background: var(--color-primary-light);
        font-weight: 700;
        color: var(--color-primary);
    }

    .btn-submit-practice {
        border: none;
        background: var(--color-primary);
        color: var(--color-text-inverse);
        border-radius: 999px;
        padding: 10px 18px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }

        .btn-submit-practice:hover {
            opacity: .88;
        }

    .practice-loading {
        padding: 18px;
        text-align: center;
        color: var(--color-text-muted);
        font-size: 13px;
    }

    .practice-empty,
    .practice-warning {
        padding: 16px;
        border-radius: 10px;
        background: #fff7ed;
        color: #9a3412;
        font-size: 13px;
    }

        .practice-empty i {
            margin-right: 6px;
        }

    .practice-score {
        margin-top: 16px;
        padding: 14px;
        background: #ecfdf5;
        color: #065f46;
        border-radius: 10px;
        font-size: 14px;
    }

        .practice-score i {
            margin-right: 6px;
        }
</style>
