@model WebApplication1.Areas.Learner.Controllers.ComingSoonViewModel
@{
    ViewData["Title"] = $"{Model.FeatureName} - Hi Japan!";
    Layout = "~/Areas/Learner/Views/Shared/_LearnerLayout.cshtml";
}

<main class="hj-content">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-7">
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
                    <span class="hj-eyebrow mb-3">Sắp ra mắt</span>
                    <h3 class="fw-bold mb-2" style="font-family:'Outfit',sans-serif;">
                        @Model.FeatureName
                    </h3>
                    <p class="text-muted mb-4">@Model.Description</p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a href="/learn/Practice" class="btn btn-outline-secondary rounded-pill px-4">
                            Quay lại
                        </a>
                        <a asp-area="Learner" asp-controller="Course" asp-action="Index"
                           class="btn btn-primary rounded-pill px-4">
                            Luyện qua bài học
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>