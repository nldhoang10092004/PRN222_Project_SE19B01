@model IEnumerable<CoreLibrary.Data.Entities.Question>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var testId = ViewData["TestId"];
    var testTitle = ViewData["TestTitle"];
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin/placement-tests">Bài test Đầu vào</a></li>
            <li class="breadcrumb-item active" aria-current="page">@testTitle</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-0 fw-bold">Quản lý Câu hỏi</h3>
            <p class="text-muted">Bài test: @testTitle</p>
        </div>
        <a href="/admin/placement-questions/create?testId=@testId" class="btn btn-danger">Thêm câu hỏi mới</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        @if (Model.Any())
        {
            <div class="mb-3">
                <span class="badge bg-info">Tổng: @Model.Count() câu hỏi</span>
                <span class="badge bg-success">Tổng điểm: @Model.Sum(q => q.Points)</span>
            </div>

            @foreach (var question in Model)
            {
                <div class="card mb-3 border">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h6 class="fw-bold mb-2">
                                    <span class="badge bg-secondary me-2">Câu @question.SortOrder</span>
                                    @question.QuestionText
                                </h6>
                                <div class="mb-2">
                                    <span class="badge bg-primary">@question.QuestionType</span>
                                    <span class="badge bg-warning text-dark">@question.Points điểm</span>
                                    <span class="badge bg-info">@question.AnswerOptions.Count đáp án</span>
                                </div>

                                <div class="mt-3">
                                    <p class="mb-2 fw-semibold small text-muted">Đáp án:</p>
                                    <ul class="list-unstyled ms-3">
                                        @foreach (var option in question.AnswerOptions)
                                        {
                                            <li class="mb-1">
                                                @if (option.IsCorrect)
                                                {
                                                    <span class="badge bg-success me-2">✓</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-dark me-2">○</span>
                                                }
                                                @option.AnswerText
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>

                            <div class="btn-group-vertical" role="group">
                                <a href="/admin/placement-questions/edit/@question.QuestionId" class="btn btn-sm btn-warning">
                                    Sửa
                                </a>
                                <button type="button" class="btn btn-sm btn-danger" onclick="confirmDelete(@question.QuestionId, @question.SortOrder)">
                                    Xóa
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="text-center mt-4">
                <a href="/admin/placement-questions/create?testId=@testId" class="btn btn-danger">Thêm câu hỏi mới</a>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted">Chưa có câu hỏi nào. Hãy thêm câu hỏi đầu tiên!</p>
                <a href="/admin/placement-questions/create?testId=@testId" class="btn btn-danger">Thêm câu hỏi mới</a>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a href="/admin/placement-tests" class="btn btn-light">Quay lại danh sách</a>
    <a href="/admin/placement-tests/edit/@testId" class="btn btn-outline-primary">Chỉnh sửa thông tin bài test</a>
</div>

<form id="deleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        function confirmDelete(questionId, sortOrder) {
            if (confirm('Bạn có chắc chắn muốn xóa câu hỏi số ' + sortOrder + '?')) {
                const form = document.getElementById('deleteForm');
                form.action = '/admin/placement-questions/delete/' + questionId;
                form.submit();
            }
        }
    </script>
}
