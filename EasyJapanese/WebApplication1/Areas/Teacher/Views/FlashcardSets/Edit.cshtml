@model CoreLibrary.Data.Entities.FlashcardSet
@{
    Layout = "~/Areas/Teacher/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/teacher/flashcard-sets">Bộ Flashcards</a></li>
                <li class="breadcrumb-item"><a href="/teacher/flashcard-sets/details/@Model.FlashcardSetId">@Model.Title</a></li>
                <li class="breadcrumb-item active">Chỉnh sửa</li>
            </ol>
        </nav>
        <h3 class="fw-bold">Chỉnh Sửa Bộ Flashcards</h3>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form method="post" action="/teacher/flashcard-sets/edit/@Model.FlashcardSetId">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Tiêu đề bộ flashcards <span class="text-danger">*</span></label>
                            <input type="text" name="Title" value="@Model.Title" class="form-control" required maxlength="200" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Mô tả</label>
                            <textarea name="Description" class="form-control" rows="4">@Model.Description</textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Khóa học</label>
                            <select name="CourseId" class="form-select">
                                <option value="">Không gắn khóa học cụ thể</option>
                                @foreach (var course in ViewBag.Courses)
                                {
                                    <option value="@course.CourseId" selected="@(Model.CourseId == course.CourseId)">
                                        @course.Title
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">URL hình ảnh thumbnail</label>
                            <input type="url" name="ImageUrl" value="@Model.ImageUrl" class="form-control" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-2"></i>Lưu thay đổi
                            </button>
                            <a href="/teacher/flashcard-sets/details/@Model.FlashcardSetId" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-2"></i>Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Thông tin</h6>
                    <ul class="small text-muted mb-0">
                        <li class="mb-2">Bộ này hiện có <strong>@Model.Flashcards.Count</strong> flashcard(s)</li>
                        <li class="mb-2">Tạo lúc: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</li>
                        <li>Cập nhật lần cuối: @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
