@model WebApplication1.Models.Profile.ProfileViewModel
@using CoreLibrary.Const
@{
    ViewData["Title"] = "Thông tin tài khoản - Hi Japan!";
    Layout = Model.Role switch
    {
        RoleConst.ADMIN => "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml",
        RoleConst.MENTOR => "~/Areas/Teacher/Views/Shared/_TeacherLayout.cshtml",
        _ => "~/Areas/Learner/Views/Shared/_LearnerLayout.cshtml"
    };
    var actionPrefix = Model.Role == RoleConst.ADMIN ? "Admin" : Model.Role == RoleConst.MENTOR ? "Teacher" : "Learner";
    var activeTab = (ViewBag.ActiveTab as string) ?? "info";
}

@section Styles {
    <style>
        .card-premium {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(0, 0, 0, 0.05);
        }

        .btn-primary-warm {
            background: var(--color-primary, #C8102E);
            color: #fff;
            border: none;
        }

            .btn-primary-warm:hover {
                background: #a30d25;
                color: #fff;
            }

        .fw-500 {
            font-weight: 500;
        }

        .fw-600 {
            font-weight: 600;
        }

        .fade-in-up {
            animation: fadeInUp 0.5s ease-out;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="container mt-4">
        <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<div class="py-5" style="background-color: var(--color-bg, #f8f9fa);">
    <div class="container">
        <div class="row g-4 fade-in-up">

            <!-- Sidebar (không nằm trong form nào cả) -->
            <div class="col-lg-3">
                <div class="card-premium p-4 sticky-top" style="top: 100px;">
                    <div class="text-center mb-4">
                        <div class="position-relative d-inline-block">
                            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                            {
                                <img src="@Model.AvatarUrl" id="avatarPreviewImg" class="rounded-circle border border-4 border-white shadow-sm" style="width: 150px; height: 150px; object-fit: cover;" alt="Profile Picture">
                            }
                            else
                            {
                                <div id="avatarPreviewImg" class="rounded-circle border border-4 border-white shadow-sm d-flex align-items-center justify-content-center bg-secondary text-white" style="width: 150px; height: 150px; font-size: 3rem;">
                                    @(Model.FullName.Substring(0, 1).ToUpper())
                                </div>
                            }
                        </div>
                        <h4 class="mt-3 mb-1">@Model.FullName</h4>
                        <p class="text-muted small">@Model.Email</p>
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1 fw-bold small">
                            @(Model.Role == RoleConst.ADMIN ? "Quản trị viên" : Model.Role == RoleConst.MENTOR ? "Giảng viên" : "Học viên")
                        </span>
                    </div>

                    <div class="list-group list-group-flush" style="margin: 0 -24px;">
                        <a href="#" onclick="showTab('info'); return false;" id="tab-link-info" class="list-group-item list-group-item-action bg-transparent border-0 px-4 py-3"><i class="bi bi-person me-3"></i>Thông tin cá nhân</a>
                        <a href="#" onclick="showTab('security'); return false;" id="tab-link-security" class="list-group-item list-group-item-action bg-transparent border-0 px-4 py-3"><i class="bi bi-shield-lock me-3"></i>Bảo mật</a>
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div class="col-lg-9">

                <!-- Tab: Thông tin cá nhân (form riêng, độc lập) -->
                <form id="form-info" method="post" action="/@(actionPrefix)/Profile/Update" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div id="tab-content-info" class="card-premium p-4 p-md-5">
                        <h3 class="mb-4">Thông tin cá nhân</h3>

                        <div class="text-center mb-4">
                            <div class="position-relative d-inline-block">
                                <input type="file" name="avatarFile" id="avatarFile" class="d-none" accept="image/*" onchange="previewAvatar(this)">
                                <button type="button" onclick="document.getElementById('avatarFile').click();" class="btn btn-sm btn-primary-warm rounded-pill px-3">
                                    <i class="bi bi-camera-fill me-1"></i> Đổi ảnh đại diện
                                </button>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label text-muted fw-500">Họ và tên</label>
                                <input type="text" name="FullName" class="form-control p-3 bg-light border-0" value="@Model.FullName" style="border-radius: 8px;">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted fw-500">Email</label>
                                <input type="email" class="form-control p-3 bg-light border-0 text-muted" value="@Model.Email" readonly style="border-radius: 8px;">
                                <small class="text-muted d-block mt-1">Email không thể thay đổi.</small>
                            </div>

                            @if (Model.Role == RoleConst.STUDENT || Model.Role == RoleConst.MENTOR)
                            {
                                <div class="col-md-6">
                                    <label class="form-label text-muted fw-500">Số điện thoại</label>
                                    <input type="tel" name="PhoneNumber" class="form-control p-3 bg-light border-0" value="@Model.PhoneNumber" placeholder="Thêm số điện thoại" style="border-radius: 8px;">
                                </div>
                            }

                            @if (Model.Role == RoleConst.STUDENT)
                            {
                                <div class="col-md-6">
                                    <label class="form-label text-muted fw-500">Ngày sinh</label>
                                    <input type="date" name="DateOfBirth" class="form-control p-3 bg-light border-0" value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" style="border-radius: 8px;">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted fw-500">Mục tiêu JLPT</label>
                                    <select class="form-select p-3 bg-light border-0" style="border-radius: 8px;" disabled>
                                        @foreach (var level in new[] { "N5", "N4", "N3", "N2", "N1", "Cơ bản" })
                                        {
                                            <option value="@level" selected="@(Model.JlptLevel == level)">@level</option>
                                        }
                                    </select>
                                </div>
                            }

                            @if (Model.Role == RoleConst.MENTOR)
                            {
                                <div class="col-md-6">
                                    <label class="form-label text-muted fw-500">Chuyên môn</label>
                                    <input type="text" name="Expertise" class="form-control p-3 bg-light border-0" value="@Model.Expertise" placeholder="Ví dụ: Ngữ pháp N3-N2, Kanji" style="border-radius: 8px;">
                                </div>
                                <div class="col-12">
                                    <label class="form-label text-muted fw-500">Giới thiệu bản thân</label>
                                    <textarea name="Bio" class="form-control p-3 bg-light border-0" rows="4" placeholder="Một vài dòng giới thiệu về bạn...">@Model.Bio</textarea>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-end gap-3 pt-3 border-top mt-5">
                            <button type="button" class="btn btn-light px-4 rounded-pill">Hủy</button>
                            <button type="submit" class="btn btn-primary-warm px-5 rounded-pill">Lưu thay đổi</button>
                        </div>
                    </div>
                </form>

                <!-- Tab: Bảo mật (form riêng, độc lập, chỉ render khi active để tránh required-field ẩn) -->
                <div id="tab-content-security" class="card-premium p-4 p-md-5" style="display: none;">
                    <h3 class="mb-4">Đổi mật khẩu</h3>

                    @if (TempData["SecuritySuccessMessage"] != null)
                    {
                        <div class="alert alert-success rounded-3 border-0 shadow-sm mb-4">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SecuritySuccessMessage"]
                        </div>
                    }
                    @if (TempData["SecurityErrorMessage"] != null)
                    {
                        <div class="alert alert-danger rounded-3 border-0 shadow-sm mb-4">
                            <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["SecurityErrorMessage"]
                        </div>
                    }

                    <form id="form-security" method="post" action="/@(actionPrefix)/Profile/ChangePassword">
                        @Html.AntiForgeryToken()
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label text-muted fw-500">Mật khẩu hiện tại</label>
                                <input type="password" name="currentPassword" class="form-control p-3 bg-light border-0" style="border-radius: 8px;" required>
                            </div>
                            <div class="col-md-6"></div>
                            <div class="col-md-6">
                                <label class="form-label text-muted fw-500">Mật khẩu mới</label>
                                <input type="password" name="newPassword" class="form-control p-3 bg-light border-0" style="border-radius: 8px;" required>
                                <small class="text-muted d-block mt-1">Tối thiểu 8 ký tự, gồm cả chữ và số.</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted fw-500">Xác nhận mật khẩu mới</label>
                                <input type="password" name="confirmPassword" class="form-control p-3 bg-light border-0" style="border-radius: 8px;" required>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 pt-3 border-top mt-5">
                            <button type="submit" class="btn btn-primary-warm px-5 rounded-pill">Đổi mật khẩu</button>
                        </div>
                    </form>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewAvatar(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var el = document.getElementById('avatarPreviewImg');
                    if (el && el.tagName === 'IMG') {
                        el.src = e.target.result;
                    } else if (el) {
                        var img = document.createElement('img');
                        img.id = 'avatarPreviewImg';
                        img.className = 'rounded-circle border border-4 border-white shadow-sm';
                        img.style.width = '150px';
                        img.style.height = '150px';
                        img.style.objectFit = 'cover';
                        img.src = e.target.result;
                        el.replaceWith(img);
                    }
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function showTab(tab) {
            document.getElementById('tab-content-info').style.display = tab === 'info' ? '' : 'none';
            document.getElementById('tab-content-security').style.display = tab === 'security' ? '' : 'none';

            var infoLink = document.getElementById('tab-link-info');
            var securityLink = document.getElementById('tab-link-security');

            infoLink.classList.toggle('text-primary', tab === 'info');
            infoLink.classList.toggle('fw-600', tab === 'info');
            infoLink.classList.toggle('text-muted', tab !== 'info');
            infoLink.style.borderLeft = tab === 'info' ? '4px solid var(--color-primary, #C8102E)' : 'none';

            securityLink.classList.toggle('text-primary', tab === 'security');
            securityLink.classList.toggle('fw-600', tab === 'security');
            securityLink.classList.toggle('text-muted', tab !== 'security');
            securityLink.style.borderLeft = tab === 'security' ? '4px solid var(--color-primary, #C8102E)' : 'none';
        }

        document.addEventListener('DOMContentLoaded', function () {
            showTab('@activeTab');
        });
    </script>
}
