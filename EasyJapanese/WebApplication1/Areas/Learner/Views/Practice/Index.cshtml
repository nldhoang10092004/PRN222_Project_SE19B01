@model WebApplication1.Areas.Learner.Controllers.PracticeIndexViewModel
@{
    ViewData["Title"] = "Luyện tập - Hi Japan!";
    Layout = "~/Areas/Learner/Views/Shared/_LearnerLayout.cshtml";
}

<main class="hj-content">
    <div class="container py-5">

        <div class="mb-5">
            <span class="hj-eyebrow">Luyện tập</span>
            <h2 class="fw-bold mb-2" style="font-family:'Outfit',sans-serif;color:var(--color-navy);">
                Chọn kỹ năng bạn muốn luyện hôm nay
            </h2>
            <p class="text-muted mb-0">Mỗi ngày một chút — đều đặn là chìa khóa để tiến bộ.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <a href="/learn/Practice/Listening" class="hj-practice-card text-decoration-none">
                    <span class="hj-practice-card-mark hj-practice-card-mark--red">聞</span>
                    <h5 class="hj-practice-card-title">Luyện Nghe</h5>
                    <p class="hj-practice-card-desc">Bài nghe đa dạng từ N5 → N1 kèm transcript và câu hỏi.</p>
                    <span class="hj-practice-card-link">Bắt đầu →</span>
                </a>
            </div>

            <div class="col-md-6 col-lg-3">
                <a href="/learn/Writing" class="hj-practice-card text-decoration-none">
                    <span class="hj-practice-card-mark">書</span>
                    <h5 class="hj-practice-card-title">Luyện Viết</h5>
                    <p class="hj-practice-card-desc">Viết đoạn văn hoặc dịch câu — AI chấm điểm và sửa lỗi ngay lập tức.</p>
                    <span class="hj-practice-card-link">Bắt đầu →</span>
                </a>
            </div>

            <div class="col-md-6 col-lg-3">
                <a href="/learn/Practice/Reading" class="hj-practice-card text-decoration-none">
                    <span class="hj-practice-card-mark">読</span>
                    <h5 class="hj-practice-card-title">Luyện Đọc</h5>
                    <p class="hj-practice-card-desc">Đọc hiểu đa chủ đề, từ vựng Hán tự và ngữ pháp đi kèm.</p>
                    <span class="hj-practice-card-link">Bắt đầu →</span>
                </a>
            </div>

            <div class="col-md-6 col-lg-3">
                <a asp-area="Learner" asp-controller="Flashcard" asp-action="Index"
                   class="hj-practice-card text-decoration-none">
                    <span class="hj-practice-card-mark">語</span>
                    <h5 class="hj-practice-card-title">Flashcard</h5>
                    <p class="hj-practice-card-desc">Quản lý các bộ thẻ và ôn tập từ vựng theo SRS.</p>
                    <span class="hj-practice-card-link">Xem các bộ thẻ →</span>
                </a>
            </div>
        </div>

    </div>
</main>