        padding: 16px 20px;
        margin-bottom: 12px;
        text-decoration: none;
        transition: border-color .15s, box-shadow .15s;
    }

        .material-card:hover {
            border-color: var(--color-primary);
            box-shadow: var(--shadow-sm);
        }

    .material-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
