@model WebApplication1.Areas.Learner.Models.ReadingDetailViewModel
@{
    ViewData["Title"] = Model.Title + " - Luyện Đọc";
    Layout = "~/Areas/Learner/Views/Shared/_LearnerLayout.cshtml";
}

<main class="hj-content">
    <div class="container py-5">

        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/learn/Practice">Luyện tập</a></li>
                <li class="breadcrumb-item"><a href="/learn/Practice/Reading">Luyện Đọc</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>

        <h2 class="fw-bold mb-4" style="color:var(--color-navy);">@Model.Title</h2>

        <!-- Nội dung bài đọc -->
        <div class="card border-0 shadow-sm mb-5">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3" style="color:var(--color-primary);">Nội dung bài đọc</h5>
                <div class="reading-content" style="font-size:1.1rem;line-height:1.8;">
                    @Html.Raw(Model.Content.Replace("\n", "<br/>"))
                </div>
            </div>
        </div>

        <!-- Câu hỏi -->
        <form method="post" action="/learn/Practice/ReadingSubmit?id=@Model.ExerciseId">
            @Html.AntiForgeryToken()

            <h5 class="fw-bold mb-4" style="color:var(--color-navy);">Câu hỏi</h5>

            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var question = Model.Questions[i];
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <p class="fw-semibold mb-3">
                            <span class="badge bg-danger me-2">Câu @(i + 1)</span>
                            @question.QuestionText
                        </p>

                        @foreach (var option in question.AnswerOptions)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio"
                                       name="answers[@question.QuestionId]"
                                       value="@option.OptionId"
                                       id="q@(question.QuestionId)_o@(option.OptionId)"
                                       required>
                                <label class="form-check-label" for="q@(question.QuestionId)_o@(option.OptionId)">
                                    @option.AnswerText
                                </label>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="d-flex gap-3 mt-4">
                <button type="submit" class="btn btn-danger btn-lg">Nộp bài</button>
                <a href="/learn/Practice/Reading" class="btn btn-light btn-lg">Quay lại</a>
            </div>
        </form>

    </div>
</main>
