<script>
    (function () {
        const sidebar = document.getElementById('lessonSidebar');
        const toggleEl = document.getElementById('sidebarToggle');
        const icon = document.getElementById('toggleIcon');

        const navItems = document.querySelectorAll('.sidebar-nav-item');
        const panels = document.querySelectorAll('.lesson-panel');

        // ==========================================================
        // Toggle sidebar
        // ==========================================================
        if (toggleEl && sidebar && icon) {
            toggleEl.addEventListener('click', function () {
                const collapsed = sidebar.classList.toggle('collapsed');

                icon.className = collapsed
                    ? 'bi bi-layout-sidebar'
                    : 'bi bi-layout-sidebar-reverse';
            });
        }

        // ==========================================================
        // Chuyển tab nội dung
        // ==========================================================
        navItems.forEach(function (item) {
            item.addEventListener('click', function () {
                const targetId = this.getAttribute('data-panel');

                // Nếu sidebar đang thu nhỏ thì mở lại
                if (sidebar && sidebar.classList.contains('collapsed')) {
                    sidebar.classList.remove('collapsed');

                    if (icon) {
                        icon.className = 'bi bi-layout-sidebar-reverse';
                    }
                }

                // Bỏ active ở menu cũ
                navItems.forEach(function (nav) {
                    nav.classList.remove('active');
                });

                // Active menu vừa click
                this.classList.add('active');

                // Ẩn toàn bộ panel
                panels.forEach(function (panel) {
                    panel.classList.remove('active');
                });

                // Hiện panel tương ứng
                const targetPanel = document.getElementById(targetId);

                if (targetPanel) {
                    targetPanel.classList.add('active');
                }
            });
        });

        // ==========================================================
        // Audio player
        // ==========================================================
        let currentAudio = null;
        let currentButton = null;
        let currentProgressFill = null;

        document.querySelectorAll('.audio-play-btn[data-audio]').forEach(function (btn) {

            const audioUrl = btn.getAttribute('data-audio');

            if (!audioUrl) return;

            btn.addEventListener('click', function () {

                const url = this.getAttribute('data-audio');

                if (!url) return;

                const card = this.closest('.audio-card');
                const progressFill = card
                    ? card.querySelector('.audio-progress-fill')
                    : null;

                const iconEl = this.querySelector('i');

                // Nếu click đúng bài đang phát thì pause
                if (currentAudio && currentAudio._url === url) {

                    if (!currentAudio.paused) {
                        currentAudio.pause();

                        if (iconEl) {
                            iconEl.className = 'bi bi-play-fill';
                        }

                        return;
                    }

                    currentAudio.play();

                    if (iconEl) {
                        iconEl.className = 'bi bi-pause-fill';
                    }

                    return;
                }

                // Dừng audio cũ nếu đang phát
                if (currentAudio) {
                    currentAudio.pause();

                    if (currentButton) {
                        const oldIcon = currentButton.querySelector('i');

                        if (oldIcon) {
                            oldIcon.className = 'bi bi-play-fill';
                        }
                    }

                    if (currentProgressFill) {
                        currentProgressFill.style.width = '0%';
                    }
                }

                // Tạo audio mới
                currentAudio = new Audio(url);
                currentAudio._url = url;

                currentButton = this;
                currentProgressFill = progressFill;

                if (iconEl) {
                    iconEl.className = 'bi bi-pause-fill';
                }

                currentAudio.addEventListener('timeupdate', function () {
                    if (this.duration && progressFill) {
                        const percent = (this.currentTime / this.duration) * 100;
                        progressFill.style.width = percent + '%';
                    }
                });

                currentAudio.addEventListener('ended', function () {
                    if (iconEl) {
                        iconEl.className = 'bi bi-play-fill';
                    }

                    if (progressFill) {
                        progressFill.style.width = '0%';
                    }

                    currentAudio = null;
                    currentButton = null;
                    currentProgressFill = null;
                });

                currentAudio.addEventListener('error', function () {
                    if (iconEl) {
                        iconEl.className = 'bi bi-play-fill';
                    }

                    if (progressFill) {
                        progressFill.style.width = '0%';
                    }

                    alert('Không thể phát audio. Kiểm tra lại AudioUrl trong database.');

                    currentAudio = null;
                    currentButton = null;
                    currentProgressFill = null;
                });

                currentAudio.play().catch(function () {
                    if (iconEl) {
                        iconEl.className = 'bi bi-play-fill';
                    }

                    alert('Không thể phát audio. Kiểm tra lại AudioUrl trong database.');
                });
            });
        });

        // ==========================================================
        // Nút Practice của từng Exercise (mở ngay trong trang)
        // ==========================================================
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        document.querySelectorAll('.btn-practice').forEach(function (button) {
            button.addEventListener('click', function () {
                const exerciseId = this.getAttribute('data-exercise-id');
                const exerciseTitle = this.getAttribute('data-exercise-title') || '';

                if (!exerciseId) return;

                const area = document.getElementById('practice-' + exerciseId);
                if (!area) return;

                // Đang mở -> đóng lại
                if (area.classList.contains('opened')) {
                    area.classList.remove('opened');
                    return;
                }

                area.classList.add('opened');
                area.setAttribute('data-exercise-title', exerciseTitle);

                // Đã load rồi thì không gọi lại API nữa
                if (area.getAttribute('data-loaded') === '1') return;

                loadPractice(exerciseId, exerciseTitle, area);
            });
        });

        function loadPractice(exerciseId, exerciseTitle, area) {
            area.innerHTML =
                '<div class="practice-loading"><i class="bi bi-hourglass-split"></i> Đang tải bài luyện tập...</div>';

            fetch('/learn/Course/ExercisePractice?exerciseId=' + encodeURIComponent(exerciseId))
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    const questions = (data && data.questions) || [];

                    if (!questions.length) {
                        area.innerHTML =
                            '<div class="practice-empty"><i class="bi bi-info-circle"></i> Bài luyện tập đang được cập nhật.</div>';
                        return;
                    }

                    renderPractice(exerciseId, exerciseTitle, questions, area);
                    area.setAttribute('data-loaded', '1');
                })
                .catch(function () {
                    area.innerHTML =
                        '<div class="practice-warning"><i class="bi bi-exclamation-triangle"></i> Không tải được bài luyện tập. Vui lòng thử lại.</div>';
                });
        }

        function renderPractice(exerciseId, exerciseTitle, questions, area) {
            let html = '<div class="practice-box">';
            html += '<div class="practice-heading"><i class="bi bi-pencil-square"></i> ' + escapeHtml(exerciseTitle) + '</div>';

            questions.forEach(function (q, index) {
                html += '<div class="practice-question" id="pq-' + q.questionId + '">';
                html += '<div class="practice-question-text">' + (index + 1) + '. ' + escapeHtml(q.questionText) + '</div>';

                (q.options || []).forEach(function (opt) {
                    html += '<label class="practice-option">' +
                        '<input type="radio" name="q_' + q.questionId + '" value="' + opt.optionId + '"> ' +
                        '<span>' + escapeHtml(opt.answerText) + '</span>' +
                        '</label>';
                });

                html += '<div class="question-feedback" id="feedback-' + q.questionId + '"></div>';
                html += '</div>';
            });

            html += '<button type="button" class="btn-submit-practice" data-exercise-id="' + exerciseId + '">Nộp bài</button>';
            html += '<div class="practice-result" id="result-' + exerciseId + '"></div>';
            html += '</div>';

            area.innerHTML = html;

            const submitBtn = area.querySelector('.btn-submit-practice');
            submitBtn.addEventListener('click', function () {
                submitPractice(exerciseId, questions, area, submitBtn);
            });
        }

        function submitPractice(exerciseId, questions, area, submitBtn) {
            const answers = [];
            let unanswered = 0;

            questions.forEach(function (q) {
                const checked = area.querySelector('input[name="q_' + q.questionId + '"]:checked');

                if (checked) {
                    answers.push({ questionId: q.questionId, optionId: parseInt(checked.value, 10) });
                } else {
                    unanswered++;
                }
            });

            const resultEl = document.getElementById('result-' + exerciseId);

            if (unanswered > 0) {
                if (resultEl) {
                    resultEl.innerHTML =
                        '<div class="practice-warning"><i class="bi bi-exclamation-triangle"></i> Bạn còn ' + unanswered + ' câu chưa trả lời.</div>';
                }
                return;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = 'Đang chấm...';

            fetch('/learn/Course/CheckExercise', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ exerciseId: parseInt(exerciseId, 10), answers: answers })
            })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    const results = (data && data.answers) || [];
                    let correctCount = 0;

                    results.forEach(function (r) {
                        const qEl = document.getElementById('pq-' + r.questionId);
                        const feedbackEl = document.getElementById('feedback-' + r.questionId);
                        if (!qEl) return;

                        const selectedInput = qEl.querySelector('input[type="radio"]:checked');

                        qEl.querySelectorAll('.practice-option').forEach(function (optLabel) {
                            const input = optLabel.querySelector('input');
                            const optId = parseInt(input.value, 10);

                            if (optId === r.correctOptionId) {
                                optLabel.classList.add('option-correct');
                            } else if (selectedInput && parseInt(selectedInput.value, 10) === optId) {
                                optLabel.classList.add('option-wrong');
                            }

                            input.disabled = true;
                        });

                        if (r.isCorrect) {
                            correctCount++;
                            qEl.classList.add('question-correct');
                            if (feedbackEl) feedbackEl.innerHTML = '<span class="feedback-correct"><i class="bi bi-check-circle"></i> Chính xác</span>';
                        } else {
                            qEl.classList.add('question-wrong');
                            if (feedbackEl) feedbackEl.innerHTML = '<span class="feedback-wrong"><i class="bi bi-x-circle"></i> Chưa đúng</span>';
                        }
                    });

                    if (resultEl) {
                        resultEl.innerHTML =
                            '<div class="practice-score"><i class="bi bi-award"></i> Bạn đúng ' + correctCount + '/' + results.length + ' câu.' +
                            '<button type="button" class="btn-retry-practice" data-exercise-id="' + exerciseId + '">Làm lại</button></div>';

                        resultEl.querySelector('.btn-retry-practice').addEventListener('click', function () {
                            area.setAttribute('data-loaded', '0');
                            loadPractice(exerciseId, area.getAttribute('data-exercise-title') || '', area);
                        });
                    }

                    submitBtn.style.display = 'none';
                })
                .catch(function () {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Nộp bài';
                    if (resultEl) {
                        resultEl.innerHTML =
                            '<div class="practice-warning"><i class="bi bi-exclamation-triangle"></i> Có lỗi khi chấm bài. Vui lòng thử lại.</div>';
                    }
                });
        }

    })();
</script>