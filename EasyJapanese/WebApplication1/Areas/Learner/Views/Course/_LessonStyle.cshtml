        border-left: 4px solid var(--color-primary);
        font-size: 17px;
        line-height: 2.2;
        color: var(--color-text);
        font-family: "Yu Mincho", "MS Mincho", serif;
    }

    /* ═══ LISTENING ═══ */
    .audio-card {
        display: flex;
        align-items: center;
        gap: 16px;
        background: var(--color-bg-soft);
