@model IEnumerable<CoreLibrary.Data.Entities.CommunityPost>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var categoryFilter = ViewData["CategoryFilter"]?.ToString() ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-chat-square-quote-fill text-danger me-2"></i>Quản lý Bài viết Cộng đồng</h3>
        <p class="text-muted small mb-0">Duyệt bài, ghim tin tức nổi bật và quản lý nội dung chia sẻ của học viên.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">

        <form method="get" class="row g-2 mb-4">
            <div class="col-md-5">
                <input type="text" name="searchString" value="@ViewData["SearchString"]" class="form-control rounded-3" placeholder="Tìm kiếm theo tiêu đề hoặc người đăng...">
            </div>
            <div class="col-md-4">
                <select name="categoryFilter" class="form-select rounded-3" onchange="this.form.submit()">
                    <option value="">Tất cả chủ đề</option>
                    <option value="Kinh nghiệm học" selected="@(categoryFilter == "Kinh nghiệm học")">Kinh nghiệm học</option>
                    <option value="Văn hóa" selected="@(categoryFilter == "Văn hóa")">Văn hóa Nhật Bản</option>
                    <option value="Từ vựng" selected="@(categoryFilter == "Từ vựng")">Từ vựng</option>
                    <option value="Ngữ pháp" selected="@(categoryFilter == "Ngữ pháp")">Ngữ pháp</option>
                    <option value="Kanji" selected="@(categoryFilter == "Kanji")">Kanji</option>
                    <option value="Công việc" selected="@(categoryFilter == "Công việc")">Công việc / Email</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-danger rounded-3 w-100"><i class="bi bi-search me-1"></i> Lọc</button>
                <a href="/admin/community" class="btn btn-light rounded-3">Reset</a>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Tiêu đề</th>
                        <th>Chủ đề</th>
                        <th>Tác giả</th>
                        <th>Tương tác</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var post in Model)
                    {
                        <tr>
                            <td><strong>#@post.PostId</strong></td>
                            <td style="max-width: 280px;">
                                <div class="fw-bold text-dark text-truncate">@post.Title</div>
                                @if (post.IsPinned)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-pin-angle-fill me-1"></i>Đã ghim</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-secondary bg-opacity-10 text-dark px-2.5 py-1">@post.Category</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark small">@post.AuthorName</div>
                                <span class="text-muted" style="font-size: 0.75rem;">@post.AuthorRole</span>
                            </td>
                            <td class="small text-muted">
                                <div><i class="bi bi-heart-fill text-danger me-1"></i>@post.LikeCount lượt thích</div>
                                <div><i class="bi bi-chat-dots me-1"></i>@post.CommunityComments.Count bình luận</div>
                            </td>
                            <td>
                                @if (post.IsApproved)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1">Đang hiển thị</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2.5 py-1">Đã ẩn</span>
                                }
                            </td>
                            <td class="small text-muted">@post.CreatedAt.ToString("HH:mm dd/MM/yyyy")</td>
                            <td class="text-end">
                                <a href="/admin/community/details/@post.PostId" class="btn btn-sm btn-outline-primary" title="Xem chi tiết bài viết & quản lý bình luận">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <form method="post" action="/admin/community/toggle-pin/@post.PostId" class="d-inline ms-1">
                                    <button type="submit" class="btn btn-sm @(post.IsPinned ? "btn-warning" : "btn-outline-warning")" title="@(post.IsPinned ? "Bỏ ghim" : "Ghim lên đầu")">
                                        <i class="bi bi-pin-angle"></i>
                                    </button>
                                </form>
                                <form method="post" action="/admin/community/toggle-approval/@post.PostId" class="d-inline ms-1">
                                    <button type="submit" class="btn btn-sm @(post.IsApproved ? "btn-outline-secondary" : "btn-outline-success")" title="@(post.IsApproved ? "Ẩn bài" : "Duyệt hiển thị")">
                                        <i class="bi @(post.IsApproved ? "bi-eye-slash" : "bi-check-lg")"></i>
                                    </button>
                                </form>
                                <form method="post" action="/admin/community/delete-post/@post.PostId" class="d-inline ms-1" onsubmit="return confirm('Bạn có chắc muốn xóa vĩnh viễn bài viết này?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa bài viết">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không có bài viết nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
