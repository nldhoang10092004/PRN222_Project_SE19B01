        color: var(--color-text-muted);
        font-size: 13px;
    }

    .practice-empty,
    .practice-warning {
        padding: 16px;
        border-radius: 10px;
        background: #fff7ed;
        color: #9a3412;
        font-size: 13px;
    }

        .practice-empty i,
        .practice-warning i {
            margin-right: 6px;
        }

    .practice-score-holder {
        margin-top: 14px;
    }

    .practice-score {
        padding: 14px 18px;
        background: #ecfdf5;
        color: #065f46;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

        .practice-score i {
            margin-right: 6px;
        }

