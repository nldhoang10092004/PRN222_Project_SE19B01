        padding: 16px 20px;
        margin-bottom: 12px;
    }

    .audio-play-btn {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--color-primary);
        color: var(--color-text-inverse);
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
        transition: opacity .15s;
        cursor: pointer;
    }

        .audio-play-btn:hover {
            opacity: .85;
        }

        .audio-play-btn:disabled {
            opacity: .35;
            cursor: default;
        }

    .audio-info {
        flex: 1;
        min-width: 0;
    }

    .audio-title {
        font-weight: 700;
        font-size: 14px;
        color: var(--color-text);
    }

    .audio-content {
        font-size: 12.5px;
        color: var(--color-text-subtle);
        margin-top: 2px;
    }

    .audio-progress {
        flex: 1;
        height: 4px;
        border-radius: 4px;
        background: var(--color-border);
