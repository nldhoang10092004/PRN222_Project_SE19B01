        }

    .lesson-tab-panel {
        display: none;
    }

        .lesson-tab-panel.active {
            display: block;
            animation: panelIn .25s ease;
        }

    @@keyframes panelIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .panel-empty {
        text-align: center;
        padding: 40px 0;
        color: var(--color-text-subtle);
        font-size: 14px;
    }

        .panel-empty i {
            font-size: 34px;
            display: block;
            margin-bottom: 12px;
            opacity: .4;
        }

    /* ═══ GRAMMAR ═══ */
    .grammar-item {
        padding: 18px 0;
        border-bottom: 1px solid var(--color-border);
    }

        .grammar-item:last-child {
            border-bottom: none;
