@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Admin Dashboard CSS (Dùng chung) -->
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}

<div class="container-fluid py-5" style="background-color: var(--bg-page); min-height: calc(100vh - 80px);">
    <div class="container">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-3 mb-4">
                <div class="bg-white rounded-4 shadow-sm p-4 h-100 border-0" style="position: sticky; top: 100px;">
                    <div class="mb-4">
                        <h4 class="fw-bold text-danger mb-1"><i class="bi bi-mortarboard-fill me-2"></i>Giảng viên</h4>
                        <p class="text-muted small fw-semibold mb-0">EasyJapanese System</p>
                    </div>
                    
                    <nav class="nav flex-column gap-2 admin-sidebar-nav-nested">
                        <a href="/Teacher/Dashboard" class="nav-link rounded-pill fw-bold @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active bg-danger text-white" : "text-dark hover-bg-light")">
                            <i class="bi bi-grid-1x2-fill me-2"></i> Tổng quan
                        </a>
                        <a href="/Teacher/Courses" class="nav-link rounded-pill fw-bold @(ViewContext.RouteData.Values["controller"]?.ToString() == "Courses" ? "active bg-danger text-white" : "text-dark hover-bg-light")">
                            <i class="bi bi-book-half me-2"></i> Khóa học của tôi
                        </a>
                        <a href="/Teacher/Flashcards" class="nav-link rounded-pill fw-bold @(ViewContext.RouteData.Values["controller"]?.ToString() == "Flashcards" ? "active bg-danger text-white" : "text-dark hover-bg-light")">
                            <i class="bi bi-collection-fill me-2"></i> Bộ Flashcard
                        </a>
                        <a href="/Teacher/Quizzes" class="nav-link rounded-pill fw-bold @(ViewContext.RouteData.Values["controller"]?.ToString() == "Quizzes" ? "active bg-danger text-white" : "text-dark hover-bg-light")">
                            <i class="bi bi-ui-checks me-2"></i> Bài tập (Quizzes)
                        </a>
                        <a href="/Teacher/Reviews" class="nav-link rounded-pill fw-bold @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reviews" ? "active bg-danger text-white" : "text-dark hover-bg-light")">
                            <i class="bi bi-star-fill me-2"></i> Đánh giá học viên
                        </a>
                    </nav>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-9">
                <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border-0">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
