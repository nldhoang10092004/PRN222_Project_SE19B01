        border-radius: 10px;
        cursor: pointer;
        font-size: 13.5px;
        background: var(--color-bg);
        transition: border-color .15s, background .15s;
    }

        .practice-option:hover {
            border-color: var(--color-primary);
        }

        .practice-option input {
            accent-color: var(--color-primary);
            flex-shrink: 0;
        }

        .practice-option.correct {
