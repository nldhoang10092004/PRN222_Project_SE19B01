@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Admin Dashboard CSS -->
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}

<div class="admin-dashboard-layout jp-bg-pattern">
    <!-- Sidebar -->
    <div class="admin-sidebar shadow-sm">
        <div class="p-4">
            <div class="mb-4">
                <h5 class="fw-bold mb-1" style="color: var(--color-primary);"><i class="bi bi-shield-lock me-2"></i>Admin Panel</h5>
                <p class="text-muted small fw-semibold mb-0" style="letter-spacing: 0.5px;">Quản trị hệ thống</p>
            </div>
            
            <nav class="nav flex-column jp-sidebar-nav mt-3">
                <a href="/admin/dashboard" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="bi bi-bar-chart-fill me-3"></i> Thống kê
                </a>
                <a href="/admin" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")">
                    <i class="bi bi-people-fill me-3"></i> Người dùng
                </a>
                <a href="/Admin/Courses" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Courses" ? "active" : "")">
                    <i class="bi bi-book-half me-3"></i> Khóa học
                </a>
                <a href="/admin/community" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Community" ? "active" : "")">
                    <i class="bi bi-chat-square-quote-fill me-3"></i> Quản lý Cộng đồng
                </a>
                <a href="/admin/exams" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Exams" ? "active" : "")">
                    <i class="bi bi-file-earmark-check-fill me-3"></i> Đề thi Đầu vào
                </a>
                <a href="/admin/placement-tests" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PlacementTest" ? "active" : "")">
                    <i class="bi bi-clipboard-check me-3"></i> Bài test Đầu vào
                </a>
                <a href="/admin/lesson-materials" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "LessonMaterial" ? "active" : "")">
                    <i class="bi bi-file-earmark-text me-3"></i> Tài liệu Bài học
                </a>
                <a href="/admin/reading-exercises" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ReadingExercise" ? "active" : "")">
                    <i class="bi bi-book-fill me-3"></i> Bài Đọc Luyện tập
                </a>
                <a href="/Admin/Transactions" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transactions" ? "active" : "")">
                    <i class="bi bi-credit-card-fill me-3"></i> Giao dịch
                </a>
                <a href="/Admin/Vouchers" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vouchers" ? "active" : "")">
                    <i class="bi bi-ticket-perforated-fill me-3"></i> Vouchers
                </a>
                <a href="/admin/tickets" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tickets" ? "active" : "")">
                    <i class="bi bi-headset me-3"></i> Ticket Support
                </a>
            </nav>
        </div>
    </div>

    <!-- Main Content -->
    <div class="admin-main-content">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
