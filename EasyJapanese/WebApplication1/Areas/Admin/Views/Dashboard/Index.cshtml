@model IEnumerable<CoreLibrary.Data.Entities.Transaction>
@{
    ViewData["Title"] = "Tổng quan hệ thống";
}

<!-- ═══ BANNER ═══ -->
<div class="jp-banner mb-5">
    <div class="jp-banner-kanji">管</div>
    <p class="jp-banner-jp mb-0">ようこそ — CHÀO MỪNG QUAY TRỞ LẠI</p>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="jp-banner-title">Dashboard Quản trị 👋</h1>
            <p class="jp-banner-sub">Hệ thống của Hi Japan! đang vận hành ổn định và bảo mật.</p>
        </div>
        <button class="btn btn-jp-outline-light"><i class="bi bi-download me-1"></i> Xuất báo cáo</button>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- Card 1 -->
    <div class="col-md-3">
        <div class="card border-0 jp-omni-card h-100 rounded-4">
            <div class="card-body d-flex align-items-center justify-content-between p-4">
                <div>
                    <p class="jp-stat-title">Doanh thu</p>
                    <h3 class="jp-stat-value">@(((decimal)ViewData["MonthlyRevenue"]!).ToString("N0"))đ</h3>
                    <small class="text-success fw-bold"><i class="bi bi-arrow-up-short"></i> Tháng này</small>
                </div>
                <div class="jp-stat-icon-neutral">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
        </div>
    </div>
    <!-- Card 2 -->
    <div class="col-md-3">
        <div class="card border-0 jp-omni-card h-100 rounded-4">
            <div class="card-body d-flex align-items-center justify-content-between p-4">
                <div>
                    <p class="jp-stat-title">Học viên mới</p>
                    <h3 class="jp-stat-value">@ViewData["NewStudents"]</h3>
                    <small class="text-success fw-bold"><i class="bi bi-arrow-up-short"></i> Tháng này</small>
                </div>
                <div class="jp-stat-icon-neutral">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <!-- Card 3 -->
    <div class="col-md-3">
        <div class="card border-0 jp-omni-card h-100 rounded-4">
            <div class="card-body d-flex align-items-center justify-content-between p-4">
                <div>
                    <p class="jp-stat-title">Chờ duyệt</p>
                    <h3 class="jp-stat-value">0</h3>
                    <a href="/admin/orders" class="small text-decoration-none text-danger fw-semibold">Xem chi tiết <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="jp-stat-icon-neutral">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
        </div>
    </div>
    <!-- Card 4 -->
    <div class="col-md-3">
        <div class="card border-0 jp-omni-card h-100 rounded-4">
            <div class="card-body d-flex align-items-center justify-content-between p-4">
                <div>
                    <p class="jp-stat-title">Khóa học active</p>
                    <h3 class="jp-stat-value">@ViewData["ActiveCourses"]</h3>
                    <small class="text-muted">Đang hoạt động</small>
                </div>
                <div class="jp-stat-icon-neutral">
                    <i class="bi bi-book-half"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="jp-omni-card rounded-4 h-100">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <h5 class="fw-bold mb-0">Hoạt động đăng ký gần đây</h5>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-muted fw-semibold small text-uppercase">Học viên</th>
                                <th class="text-muted fw-semibold small text-uppercase">Gói/Khóa học</th>
                                <th class="text-muted fw-semibold small text-uppercase">Ngày giờ</th>
                                <th class="text-muted fw-semibold small text-uppercase">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tx in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@(tx.Student?.FullName ?? "User_" + tx.StudentId)</div>
                                    </td>
                                    <td>@(tx.Plan?.PlanName ?? "Gói/Khóa học")</td>
                                    <td>@tx.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if(tx.PaymentStatus == "Paid")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">Thành công</span>
                                        }
                                        else if(tx.PaymentStatus == "Pending")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-2">Đang chờ</span>
                                        }
                                        else if(tx.PaymentStatus == "Failed")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2">Thất bại</span>
                                        }
                                        else if(tx.PaymentStatus == "Refunded")
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2">Đã hoàn tiền</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark rounded-pill px-3 py-2">@tx.PaymentStatus</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">Chưa có giao dịch nào</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="jp-omni-card rounded-4 h-100">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <h5 class="fw-bold mb-0">Thao tác nhanh</h5>
            </div>
            <div class="card-body p-4">
                <div class="d-grid gap-3">
                    <a href="/admin/users" class="btn btn-light border text-start py-3 px-4 d-flex align-items-center rounded-3 text-decoration-none text-dark">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-person-lines-fill fs-5"></i>
                        </div>
                        <div class="fw-semibold">Quản lý người dùng</div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
