        flex-shrink: 0;
    }

    .lesson-list-item.completed .lesson-status-icon {
        color: #16a34a;
    }

    .lesson-list-item.active .lesson-status-icon {
        color: #dc2626;
    }

    .lesson-list-title {
        font-size: 13.5px;
        font-weight: 600;
        color: #334155;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: opacity .15s;
    }

    .lesson-list-item.active .lesson-list-title {
        color: #dc2626;
        font-weight: 700;
    }

    .lesson-sidebar.collapsed .lesson-list-title {
        opacity: 0;
        width: 0;
    }

    .lesson-sidebar.collapsed .lesson-list-item {
        justify-content: center;
        padding: 11px 0;
    }

    /* ═══ MAIN ═══ */
    .lesson-main {
        flex: 1;
        min-width: 0;
        padding: 24px 44px 80px;
        background: #ffffff;
        width: 100%;
    }

    .lesson-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .lesson-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 600;
        background: #ffffff;
        padding: 7px 16px;
        border-radius: 9999px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
        transition: all .15s ease;
    }

        .lesson-back:hover {
            color: #dc2626;
            border-color: #fca5a5;
            background: #fef2f2;
        }

    .lesson-topbar-right {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
    }

    .btn-complete-lesson {
        background: #ffffff;
        color: #16a34a;
        border: 1.5px solid #16a34a;
        border-radius: var(--radius-full);
        font-weight: 700;
        font-size: 13.5px;
        padding: 8px 20px;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
        transition: all .15s ease;
    }

        .btn-complete-lesson:hover:not(:disabled) {
            background: #16a34a;
            color: #fff;
        }

        .btn-complete-lesson.completed {
            background: #16a34a;
            color: #fff;
            cursor: default;
            opacity: .95;
        }

    .btn-quiz {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        color: #ffffff;
        border: none;
        border-radius: var(--radius-full);
        font-weight: 700;
        font-size: 13.5px;
        padding: 9px 22px;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
        transition: all .15s ease;
        text-decoration: none;
    }

        .btn-quiz:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(220, 38, 38, 0.35);
            color: #ffffff;
        }

    .lesson-header {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 20px 24px;
        margin-bottom: 24px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.02);
    }

    .lesson-level {
        display: inline-block;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: #dc2626;
        background: #fef2f2;
        padding: 3px 10px;
        border-radius: 9999px;
        margin-bottom: 8px;
        border: 1px solid #fee2e2;
    }

    .lesson-title {
        font-size: 24px;
        font-weight: 800;
        color: #0f172a;
        margin: 0;
        line-height: 1.3;
    }

    /* ═══ VIDEO ═══ */
    .lesson-video-wrap {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        overflow: hidden;
        background: #090d16;
        border-radius: 16px;
        box-shadow: 0 12px 32px -8px rgba(0,0,0,0.22);
        margin-bottom: 28px;
        border: 1px solid #1e293b;
    }

        .lesson-video-wrap iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
            border-radius: 16px;
        }

    .lesson-video-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

    .play-btn {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        border: 3px solid var(--color-primary);
        background: var(--color-primary-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform .2s, background .2s;
    }

        .play-btn:hover {
            transform: scale(1.08);
        }

        .play-btn i {
            font-size: 24px;
            color: var(--color-primary);
            margin-left: 4px;
        }

    .lesson-video-placeholder p {
        color: var(--color-text-subtle);
        font-size: 13px;
        margin: 0;
    }

    /* ═══ MÔ TẢ ═══ */
    .lesson-description {
        font-size: 14px;
        line-height: 1.75;
        color: var(--color-text-muted);
        padding: 14px 0 20px;
        border-bottom: 1px solid var(--color-border);
        margin-bottom: 4px;
    }

    /* ═══ TABS NGANG ═══ */
    .lesson-tabs-bar {
        display: flex;
        align-items: center;
        gap: 4px;
        border-bottom: 1px solid var(--color-border);
        margin-top: 20px;
        margin-bottom: 24px;
        overflow-x: auto;
    }

    .lesson-tab-item {
        padding: 12px 18px;
        font-size: 14px;
        font-weight: 600;
        color: var(--color-text-subtle);
        cursor: pointer;
