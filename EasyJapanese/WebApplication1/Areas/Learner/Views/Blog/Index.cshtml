@model CoreWeb.Areas.Learner.Models.CommunityIndexViewModel
@{
    ViewData["Title"] = "Cộng đồng - Hi Japan!";
    Layout = null;

    string GetCatCss(string cat)
    {
        return cat switch
        {
            "Kinh nghiệm học" => "tag-experience",
            "Văn hóa" => "tag-culture",
            "Từ vựng" => "tag-vocab",
            "Ngữ pháp" => "tag-grammar",
            "Kanji" => "tag-kanji",
            "Công việc" => "tag-business",
            _ => "tag-experience"
        };
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/assets/css/style.css" asp-append-version="true">
    @await Html.PartialAsync("_BlogStyle")
</head>
<body>

    <!-- ═══ NAVBAR ═══ -->
    <nav class="hj-nav">
        <div class="container d-flex align-items-center justify-content-between">
            <a asp-area="Learner" asp-controller="Dashboard" asp-action="Index" class="hj-brand">
                <div class="hj-brand-dot">H</div>Hi Japan!
            </a>
            <ul class="d-none d-md-flex list-unstyled mb-0 gap-4">
                <li><a asp-area="Learner" asp-controller="Dashboard" asp-action="Index" class="hj-nav-link">Tổng quan</a></li>
                <li><a asp-area="Learner" asp-controller="Course" asp-action="Index" class="hj-nav-link">Khóa học</a></li>
                <li><a asp-area="Learner" asp-controller="Document" asp-action="Index" class="hj-nav-link">Tài liệu</a></li>
                <li><a asp-area="Learner" asp-controller="Blog" asp-action="Index" class="hj-nav-link active">Cộng đồng</a></li>
            </ul>
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn btn-danger btn-sm rounded-pill px-3 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#createPostModal">
                    <i class="bi bi-pencil-square me-1"></i>Đăng bài
                </button>
                <div class="dropdown d-flex align-items-center">
                    <button class="btn p-0 border-0 shadow-none d-flex align-items-center justify-content-center" id="ddUser" data-bs-toggle="dropdown" aria-expanded="false" style="background: transparent; outline: none;">
                        <div class="hj-avatar">@(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())</div>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="ddUser">
                        <li><span class="dropdown-item-text fw-600 small text-muted px-3 pt-2">@Model.FullName</span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item py-2" href="/learn/blog"><i class="bi bi-chat-square-quote me-2"></i>Bài viết của tôi</a></li>
                        <li><a class="dropdown-item py-2 text-danger" href="/Login/Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- ═══ HERO ═══ -->
    <div class="hj-hero">
        <div class="hj-hero-kanji">読</div>
        <div class="container">
            <p class="mb-2" style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.6);">
                コミュニティ — Cộng đồng
            </p>
            <h1 style="font-family:'Outfit',sans-serif;font-size:34px;font-weight:800;color:#fff;margin-bottom:10px;">
                Góc chia sẻ Hi Japan!
            </h1>
            <p style="font-size:15px;color:rgba(255,255,255,.85);max-width:480px;line-height:1.65;margin:0;">
                Bí kíp học tập, văn hóa Nhật Bản, kinh nghiệm thi JLPT —
                được đóng góp bởi giáo viên và cộng đồng học viên.
            </p>
        </div>
    </div>

    <!-- ═══ MAIN ═══ -->
    <main style="padding: 28px 0 72px;">
        <div class="container">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row g-5">

                <!-- ── LEFT COLUMN ── -->
                <div class="col-lg-8">

                    <!-- Search Bar & Filter pills -->
                    <form method="get" action="/learn/blog" class="mb-3">
                        <div class="input-group shadow-sm rounded-pill overflow-hidden border border-light">
                            <input type="text" name="search" value="@Model.SearchQuery" class="form-control px-4 py-2 border-0" placeholder="Tìm bài viết, từ khóa tiếng Nhật...">
                            @if (!string.IsNullOrEmpty(Model.CurrentCategory))
                            {
                                <input type="hidden" name="category" value="@Model.CurrentCategory" />
                            }
                            <button type="submit" class="btn btn-danger px-4"><i class="bi bi-search"></i> Tìm</button>
                        </div>
                    </form>

                    <div class="hj-filter-bar fade-in">
                        <a href="/learn/blog" class="hj-filter-pill @(string.IsNullOrEmpty(Model.CurrentCategory) ? "active" : "")">Tất cả</a>
                        @foreach (var cat in new[] { "Kinh nghiệm học", "Văn hóa", "Từ vựng", "Ngữ pháp", "Kanji", "Công việc" })
                        {
                            <a href="/learn/blog?category=@Uri.EscapeDataString(cat)" class="hj-filter-pill @(Model.CurrentCategory == cat ? "active" : "")">@cat</a>
                        }
                    </div>

                    <!-- Featured post -->
                    @if (Model.FeaturedPost != null && string.IsNullOrEmpty(Model.CurrentCategory) && string.IsNullOrEmpty(Model.SearchQuery) && Model.Page == 1)
                    {
                        var fp = Model.FeaturedPost;
                        <div class="hj-featured mt-4 mb-5 fade-in d1 shadow-sm">
                            <div class="row g-0">
                                <div class="col-md-5">
                                    <img src="@(string.IsNullOrEmpty(fp.ImageUrl) ? "https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?q=80&w=900&auto=format&fit=crop" : fp.ImageUrl)" class="hj-featured-img" alt="@fp.Title">
                                </div>
                                <div class="col-md-7 d-flex flex-column justify-content-center p-4 p-lg-5">
                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <span class="hj-tag @GetCatCss(fp.Category)">@fp.Category</span>
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1"><i class="bi bi-pin-angle-fill me-1"></i>Nổi bật</span>
                                        <span class="text-muted small ms-auto"><i class="bi bi-calendar3 me-1"></i>@fp.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <a href="/learn/blog/details/@fp.PostId" class="hj-featured-title">@fp.Title</a>
                                    <p style="font-size:14px;color:#6b7280;line-height:1.7;margin-bottom:20px;">
                                        @(fp.Content.Length > 160 ? fp.Content.Substring(0, 157) + "..." : fp.Content)
                                    </p>
                                    <div class="d-flex align-items-center justify-content-between mt-auto flex-wrap gap-2">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="hj-author-avatar">@(string.IsNullOrEmpty(fp.AuthorName) ? "A" : fp.AuthorName.Substring(0, 1).ToUpper())</div>
                                            <div>
                                                <div style="font-size:13.5px;font-weight:600;">@fp.AuthorName</div>
                                                <div style="font-size:12px;color:#6b7280;">@(fp.AuthorRole == "Teacher" ? "Giáo viên" : "Học viên")</div>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-3 text-muted small">
                                            <span><i class="bi bi-heart-fill text-danger me-1"></i>@fp.LikeCount</span>
                                            <span><i class="bi bi-chat-dots me-1"></i>@fp.Comments.Count</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Post grid -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="hj-section-title fade-in mb-0">Bài viết mới nhất</h2>
                        <span class="text-muted small">Tổng cộng: <strong>@Model.TotalCount</strong> bài viết</span>
                    </div>

                    @if (Model.Posts != null && Model.Posts.Any())
                    {
                        <div class="row g-4">
                            @foreach (var p in Model.Posts)
                            {
                                <div class="col-md-6 fade-in">
                                    <div class="hj-post-card h-100 d-flex flex-column">
                                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://images.unsplash.com/photo-1528360983277-13d401cdc186?q=80&w=900&auto=format&fit=crop" : p.ImageUrl)" class="hj-post-card-img" alt="@p.Title">
                                        <div class="p-4 d-flex flex-column flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="hj-tag @GetCatCss(p.Category)">@p.Category</span>
                                                <span class="text-muted style-date" style="font-size:11.5px;">@p.CreatedAt.ToString("dd/MM/yyyy")</span>
                                            </div>
                                            <a href="/learn/blog/details/@p.PostId" class="hj-post-card-title">@p.Title</a>
                                            <p style="font-size:13px;color:#6b7280;line-height:1.65;flex-grow:1;margin-bottom:16px;">
                                                @(p.Content.Length > 120 ? p.Content.Substring(0, 117) + "..." : p.Content)
                                            </p>
                                            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                                <div class="d-flex align-items-center gap-2 text-muted small">
                                                    <span><i class="bi bi-eye me-1"></i>@p.ViewCount</span>
                                                    <span><i class="bi bi-heart me-1 text-danger"></i>@p.LikeCount</span>
                                                    <span><i class="bi bi-chat me-1"></i>@p.Comments.Count</span>
                                                </div>
                                                <a href="/learn/blog/details/@p.PostId" class="hj-read-more">Xem bài <i class="bi bi-arrow-right"></i></a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1)
                        {
                            <div class="d-flex justify-content-center mt-5">
                                <nav>
                                    <ul class="pagination mb-0">
                                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                            <a class="page-link rounded-start-pill" href="/learn/blog?category=@Model.CurrentCategory&search=@Model.SearchQuery&page=@(Model.Page - 1)">Trước</a>
                                        </li>
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                                <a class="page-link" href="/learn/blog?category=@Model.CurrentCategory&search=@Model.SearchQuery&page=@i">@i</a>
                                            </li>
                                        }
                                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link rounded-end-pill" href="/learn/blog?category=@Model.CurrentCategory&search=@Model.SearchQuery&page=@(Model.Page + 1)">Sau</a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 bg-white rounded-4 shadow-sm border">
                            <i class="bi bi-journal-x fs-1 text-muted d-block mb-3"></i>
                            <h5 class="fw-bold text-dark">Chưa có bài viết nào</h5>
                            <p class="text-muted small mb-3">Hãy là người đầu tiên chia sẻ bài viết mới cho cộng đồng!</p>
                            <button type="button" class="btn btn-danger rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createPostModal">
                                <i class="bi bi-pencil-square me-1"></i>Đăng bài ngay
                            </button>
                        </div>
                    }
                </div>

                <!-- ── RIGHT SIDEBAR ── -->
                <div class="col-lg-4">

                    <!-- Write CTA -->
                    <div class="hj-write-cta mb-4 fade-in d2">
                        <div style="font-family:'Outfit',sans-serif;font-size:17px;font-weight:700;margin-bottom:6px;">
                            Chia sẻ kinh nghiệm của bạn
                        </div>
                        <p style="font-size:13px;color:rgba(255,255,255,.82);line-height:1.6;margin-bottom:16px;">
                            Bạn có mẹo hay khi học tiếng Nhật? Viết bài và truyền cảm hứng cho cộng đồng Hi Japan!
                        </p>
                        <button class="btn-hj-light" data-bs-toggle="modal" data-bs-target="#createPostModal">✍️ Viết bài ngay</button>
                    </div>

                    <!-- Popular tags -->
                    <div class="hj-sidebar-card mb-4 fade-in d3">
                        <div class="hj-sidebar-title">Chủ đề phổ biến</div>
                        <div>
                            @foreach (var tag in new[] {
                                "JLPT N5","JLPT N4","JLPT N3","JLPT N2","JLPT N1",
                                "Kanji","Từ vựng","Ngữ pháp","Luyện nghe",
                                "Anime","Du học Nhật","Làm việc tại Nhật","Văn hóa"
                            })
                            {
                                <a href="/learn/blog?search=@Uri.EscapeDataString(tag)" class="hj-tag-pill">@tag</a>
                            }
                        </div>
                    </div>

                    <!-- Recent posts -->
                    <div class="hj-sidebar-card fade-in d4">
                        <div class="hj-sidebar-title">Bài viết gần đây</div>
                        <ul class="list-unstyled mb-0">
                            @foreach (var rp in Model.RecentPosts)
                            {
                                <li style="padding:10px 0;border-bottom:1px solid var(--color-border);">
                                    <a href="/learn/blog/details/@rp.PostId"
                                       style="font-size:13.5px;font-weight:600;color:var(--color-text);text-decoration:none;line-height:1.4;display:block;margin-bottom:4px;"
                                       onmouseover="this.style.color='var(--color-primary)'"
                                       onmouseout="this.style.color='var(--color-text)'">
                                        @rp.Title
                                    </a>
                                    <span class="hj-post-meta">
                                        <i class="bi bi-clock me-1"></i>@rp.CreatedAt.ToString("dd/MM/yyyy") · <i class="bi bi-eye ms-1 me-1"></i>@rp.ViewCount
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>

                </div>
            </div>
        </div>
    </main>

    <!-- Modal Tạo bài viết mới -->
    <div class="modal fade" id="createPostModal" tabindex="-1" aria-labelledby="createPostModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-danger text-white py-3">
                    <h5 class="modal-title fw-bold" id="createPostModalLabel"><i class="bi bi-pencil-square me-2"></i>Đăng bài viết mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="/learn/blog/create" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tiêu đề bài viết <span class="text-danger">*</span></label>
                            <input type="text" name="title" required class="form-control rounded-3" placeholder="Ví dụ: Lộ trình học 50 Kanji N4 dễ nhớ nhất...">
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Chủ đề <span class="text-danger">*</span></label>
                                <select name="category" class="form-select rounded-3" required>
                                    <option value="Kinh nghiệm học">Kinh nghiệm học</option>
                                    <option value="Văn hóa">Văn hóa Nhật Bản</option>
                                    <option value="Từ vựng">Từ vựng</option>
                                    <option value="Ngữ pháp">Ngữ pháp</option>
                                    <option value="Kanji">Kanji</option>
                                    <option value="Công việc">Công việc / Email</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Tải ảnh minh họa lên từ máy</label>
                                <input type="file" name="imageFile" accept="image/*" class="form-control rounded-3">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nội dung bài viết <span class="text-danger">*</span></label>
                            <textarea name="content" required rows="7" class="form-control rounded-3" placeholder="Chia sẻ chi tiết kinh nghiệm, danh sách từ vựng, hoặc thắc mắc của bạn..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light py-3">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Đăng bài viết</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/main.js" asp-append-version="true"></script>
</body>
</html>
