@model CoreWeb.Areas.Learner.Models.LessonViewModel

@{
    ViewData["Title"] = Model.LessonTitle + " - Hi Japan!";
}

@section Styles {
    @await Html.PartialAsync("_LessonStyle")
}

<div class="lesson-shell">

    <!-- ═══════════════════════════════════════
         SIDEBAR: danh sách bài học
    ═══════════════════════════════════════ -->
    <aside class="lesson-sidebar" id="lessonSidebar">
        <div class="sidebar-header">
            <span class="sidebar-course-title">@Model.CourseTitle</span>
            <div class="sidebar-toggle-btn" id="sidebarToggle">
                <i class="bi bi-layout-sidebar-reverse" id="toggleIcon"></i>
            </div>
        </div>

        <nav class="sidebar-lesson-list">
            @foreach (var lesson in Model.AllLessons)
            {
                <a href="/learn/Course/Lesson/@lesson.LessonId"
                   class="lesson-list-item @(lesson.IsCurrent ? "active" : "") @(lesson.IsCompleted ? "completed" : "")">
                    <span class="lesson-status-icon">
                        @if (lesson.IsCompleted)
                        {
                            <i class="bi bi-check-circle-fill"></i>
                        }
                        else if (lesson.IsCurrent)
                        {
                            <i class="bi bi-play-circle-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-circle"></i>
                        }
                    </span>
                    <span class="lesson-list-title">@lesson.Title</span>
                </a>
            }
        </nav>
    </aside>

    <!-- ═══════════════════════════════════════
         MAIN CONTENT
    ═══════════════════════════════════════ -->
    <main class="lesson-main" id="lessonMain">

        <div class="lesson-topbar">
            <a href="/learn/Course/Detail/@Model.CourseId" class="lesson-back">
                <i class="bi bi-arrow-left"></i>
                @Model.CourseTitle
            </a>

            <div class="lesson-topbar-right">
                <button type="button"
                        id="btnCompleteLesson"
                        class="btn-complete-lesson @(Model.IsCompleted ? "completed" : "")"
                        data-lesson-id="@Model.LessonId"
                        @(Model.IsCompleted ? "disabled" : "")>
                    <i class="bi bi-@(Model.IsCompleted ? "check-circle-fill" : "check-circle")"></i>
                    <span class="btn-complete-label">@(Model.IsCompleted ? "Đã hoàn thành" : "Đánh dấu hoàn thành")</span>
                </button>

                <a asp-area="Learner"
                   asp-controller="Quiz"
                   asp-action="Start"
                   asp-route-courseId="@Model.CourseId"
                   class="btn-quiz">
                    Làm Quiz cuối khóa
                    <i class="bi bi-patch-check"></i>
                </a>
            </div>
        </div>

        <div class="lesson-header">
            <span class="lesson-level">@Model.LevelName</span>
            <h1 class="lesson-title">@Model.LessonTitle</h1>
        </div>

        <!-- ═══ VIDEO ═══ -->
        <div class="lesson-video-wrap">
            @if (!string.IsNullOrEmpty(Model.VideoUrl))
            {
                <iframe src="@Model.VideoUrl" allowfullscreen></iframe>
            }
            else
            {
                <div class="lesson-video-placeholder">
                    <div class="play-btn">
                        <i class="bi bi-play-fill"></i>
                    </div>
                    <p>Video bài giảng đang được cập nhật</p>
                </div>
            }
        </div>

        <!-- ═══ MÔ TẢ BÀI HỌC (không phải tab) ═══ -->
        @if (!string.IsNullOrEmpty(Model.Content))
        {
            <div class="lesson-description">
                @Html.Raw(Model.Content.Replace("\n", "<br/>"))
            </div>
        }

        <!-- ═══ TABS NGANG ═══ -->
        <div class="lesson-tabs-bar">
            @if (Model.KanjiItems.Any())
            {
                <div class="lesson-tab-item" data-panel="panel-kanji">Kanji</div>
            }
            @if (Model.GrammarItems.Any())
            {
                <div class="lesson-tab-item" data-panel="panel-grammar">Ngữ pháp</div>
            }
            @if (Model.ReadingItems.Any())
            {
                <div class="lesson-tab-item" data-panel="panel-reading">Đọc</div>
            }
            @if (Model.ListeningItems.Any())
            {
                <div class="lesson-tab-item" data-panel="panel-listening">Nghe</div>
            }
            <div class="lesson-tab-item" data-panel="panel-materials">Tài liệu</div>
        </div>

        <!-- ═══ PANEL: KANJI ═══ -->
        @if (Model.KanjiItems.Any())
        {
            <div id="panel-kanji" class="lesson-tab-panel">
                @foreach (var item in Model.KanjiItems)
                {
                    <div class="reading-item">
                        <div class="reading-title">@item.Title</div>

                        @if (!string.IsNullOrEmpty(item.Content))
                        {
                            <div class="reading-passage">
                                @Html.Raw(item.Content.Replace("\n", "<br/>"))
                            </div>
                        }

                        <button type="button"
                                class="btn-practice"
                                data-exercise-id="@item.ExerciseId"
                                data-exercise-title="@item.Title">
                            <i class="bi bi-pencil-square"></i>
                            Làm bài kanji
                        </button>

                        <div id="practice-@item.ExerciseId" class="practice-area"></div>
                    </div>
                }
            </div>
        }

        <!-- ═══ PANEL: NGỮ PHÁP ═══ -->
        @if (Model.GrammarItems.Any())
        {
            <div id="panel-grammar" class="lesson-tab-panel">
                @{ int grammarIndex = 1; }
                @foreach (var item in Model.GrammarItems)
                {
                    <div class="grammar-item">
                        <div class="grammar-title">@grammarIndex. @item.Title</div>

                        @if (!string.IsNullOrEmpty(item.Content))
                        {
                            <div class="grammar-content">
                                @Html.Raw(item.Content.Replace("\n", "<br/>"))
                            </div>
                        }

                        <button type="button"
                                class="btn-practice"
                                data-exercise-id="@item.ExerciseId"
                                data-exercise-title="@item.Title">
                            <i class="bi bi-pencil-square"></i>
                            Luyện tập ngữ pháp
                        </button>

                        <div id="practice-@item.ExerciseId" class="practice-area"></div>
                    </div>
                    grammarIndex++;
                }
            </div>
        }

        <!-- ═══ PANEL: ĐỌC HIỂU ═══ -->
        @if (Model.ReadingItems.Any())
        {
            <div id="panel-reading" class="lesson-tab-panel">
                @foreach (var item in Model.ReadingItems)
                {
                    <div class="reading-item">
                        <div class="reading-title">@item.Title</div>

                        @if (!string.IsNullOrEmpty(item.Content))
                        {
                            <div class="reading-passage">
                                @Html.Raw(item.Content.Replace("\n", "<br/>"))
                            </div>
                        }

                        <button type="button"
                                class="btn-practice"
                                data-exercise-id="@item.ExerciseId"
                                data-exercise-title="@item.Title">
                            <i class="bi bi-pencil-square"></i>
                            Làm bài đọc hiểu
                        </button>

                        <div id="practice-@item.ExerciseId" class="practice-area"></div>
                    </div>
                }
            </div>
        }

        <!-- ═══ PANEL: LUYỆN NGHE ═══ -->
        @if (Model.ListeningItems.Any())
        {
            <div id="panel-listening" class="lesson-tab-panel">
                @foreach (var item in Model.ListeningItems)
                {
                    <div class="audio-card">
                        <button class="audio-play-btn"
                                type="button"
                                @(string.IsNullOrEmpty(item.AudioUrl) ? "disabled" : "")
                                data-audio="@(item.AudioUrl ?? "")"
                                title="@(string.IsNullOrEmpty(item.AudioUrl) ? "Audio đang cập nhật" : "Phát audio")">
                            <i class="bi bi-play-fill"></i>
                        </button>

                        <div class="audio-info">
                            <div class="audio-title">@item.Title</div>

                            @if (!string.IsNullOrEmpty(item.Content))
                            {
                                <div class="audio-content">@item.Content</div>
                            }

                            @if (!string.IsNullOrEmpty(item.AudioUrl))
                            {
                                <div class="audio-progress">
                                    <div class="audio-progress-fill"></div>
                                </div>
                            }
                            else
                            {
                                <div class="audio-content">Audio đang được cập nhật</div>
                            }

                            <button type="button"
                                    class="btn-practice"
                                    data-exercise-id="@item.ExerciseId"
                                    data-exercise-title="@item.Title">
                                <i class="bi bi-pencil-square"></i>
                                Làm bài nghe
                            </button>

                            <div id="practice-@item.ExerciseId" class="practice-area"></div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- ═══ PANEL: TÀI LIỆU ═══ -->
        <div id="panel-materials" class="lesson-tab-panel">
            @if (Model.MaterialItems.Any())
            {
                @foreach (var material in Model.MaterialItems)
                {
                    <a class="material-card" href="@material.Url" target="_blank" rel="noopener noreferrer">
                        <span class="material-icon">
                            @if (material.FileType == "pdf")
                            {
                                <i class="bi bi-file-earmark-pdf"></i>
                            }
                            else if (material.FileType == "slide")
                            {
                                <i class="bi bi-file-earmark-slides"></i>
                            }
                            else
                            {
                                <i class="bi bi-link-45deg"></i>
                            }
                        </span>
                        <span class="material-title">@material.Title</span>
                    </a>
                }
            }
            else
            {
                <div class="panel-empty">
                    <i class="bi bi-folder2-open"></i>
                    Tài liệu đang được cập nhật.
                </div>
            }
        </div>

    </main>
</div>

@section Scripts {
    @await Html.PartialAsync("_LessonScript")
}
