@model CoreLibrary.Data.Entities.Exercise
@{
    Layout = "~/Areas/Teacher/Views/Shared/_TeacherLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div class="d-flex align-items-center">
        <a href="/teacher/exercises" class="btn btn-sm btn-light rounded-circle me-3" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;">
            <i class="bi bi-arrow-left fs-5"></i>
        </a>
        <div>
            <h3 class="mb-1 fw-bold">Biên soạn Câu hỏi Bài tập</h3>
            <p class="text-muted small mb-0">Bài tập: <span class="text-dark fw-bold">@Model.Title</span> (@(Model.Questions?.Count ?? 0) câu hỏi)</p>
        </div>
    </div>
    <button class="btn btn-jp-outline" data-bs-toggle="modal" data-bs-target="#importExcelModal">
        <i class="bi bi-file-earmark-excel-fill text-success me-1"></i> Nhập từ Excel
    </button>
</div>

<div class="card border-0 jp-omni-card rounded-4 p-4 mb-4">
    <h5 class="fw-bold mb-3"><i class="bi bi-paperclip me-2"></i>Tài liệu đính kèm</h5>
    <form asp-action="UpdateAssets" asp-route-exerciseId="@Model.ExerciseId" method="post" enctype="multipart/form-data">
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label small fw-bold text-muted">Nội dung / Hướng dẫn</label>
                <textarea name="content" class="form-control rounded-3" rows="3" placeholder="Mô tả nội dung bài tập">@Model.Content</textarea>
            </div>

            @if (Model.ExerciseType == "Listening")
            {
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted">File âm thanh (Audio)</label>
                    <input type="file" name="audioFile" class="form-control rounded-3" accept="audio/*" />
                    @if (!string.IsNullOrEmpty(Model.AudioUrl))
                    {
                        <div class="mt-2">
                            <audio controls class="w-100" style="height: 40px;">
                                <source src="@Model.AudioUrl" />
                                Trình duyệt không hỗ trợ audio.
                            </audio>
                        </div>
                    }
                </div>
            }

            @if (Model.ExerciseType == "Kanji")
            {
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted">Hình ảnh Thứ tự nét (Stroke Order)</label>
                    <input type="file" name="strokeOrderFile" class="form-control rounded-3" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.StrokeOrderUrl))
                    {
                        <div class="mt-2">
                            <img src="@Model.StrokeOrderUrl" class="rounded-3 border" style="max-height: 100px;" alt="Stroke order" />
                        </div>
                    }
                </div>
            }
        </div>

        <div class="d-flex justify-content-end mt-3">
            <button type="submit" class="btn btn-jp-primary rounded-3">
                <i class="bi bi-check-lg me-1"></i> Lưu tài liệu đính kèm
            </button>
        </div>
    </form>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Question list -->
    <div class="col-lg-8">
        <div class="d-flex flex-column gap-4">
            @{
                int index = 1;
            }
            @foreach (var q in Model.Questions.OrderBy(x => x.QuestionId))
            {
                var optsList = q.AnswerOptions.ToList();

                <div class="card border-0 jp-omni-card rounded-4 p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-semibold">
                            Câu hỏi @index (@q.Points điểm)
                        </span>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-link text-primary p-0" data-bs-toggle="modal" data-bs-target="#editQuestionModal-@q.QuestionId">
                                <i class="bi bi-pencil-square fs-5"></i>
                            </button>
                            <form asp-action="DeleteQuestion" asp-route-exerciseId="@Model.ExerciseId" method="post" onsubmit="return confirm('Bạn chắc chắn muốn xóa câu hỏi này?');" class="m-0">
                                <input type="hidden" name="questionId" value="@q.QuestionId" />
                                <button type="submit" class="btn btn-link text-danger p-0">
                                    <i class="bi bi-trash3-fill fs-5"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3">@q.QuestionText</h5>

                    <div class="d-flex flex-column gap-2 mt-2">
                        @foreach (var opt in optsList)
                        {
                            <div class="d-flex align-items-center p-3 rounded-3 border @(opt.IsCorrect ? "border-success text-success fw-bold" : "bg-light border-light text-dark")" style="@(opt.IsCorrect ? "background-color: rgba(25, 135, 84, 0.1) !important;" : "")">
                                <i class="bi @(opt.IsCorrect ? "bi-check-circle-fill" : "bi-circle") me-3"></i>
                                <span>@opt.AnswerText</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Edit Question Modal -->
                <div class="modal fade" id="editQuestionModal-@q.QuestionId" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content rounded-4 border-0 shadow-lg">
                            <div class="modal-header border-0 pb-0">
                                <h5 class="modal-title fw-bold">Chỉnh sửa Câu hỏi</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form asp-action="EditQuestion" asp-route-exerciseId="@Model.ExerciseId" method="post">
                                <input type="hidden" name="questionId" value="@q.QuestionId" />
                                <div class="modal-body p-4">
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-muted">Nội dung câu hỏi</label>
                                        <textarea name="questionText" class="form-control rounded-3" rows="3" required>@q.QuestionText</textarea>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-muted">Số điểm</label>
                                        <input type="number" name="points" class="form-control rounded-3" value="@q.Points" min="1" required />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small fw-bold text-muted d-block">Các lựa chọn & Đáp án đúng</label>
                                        <div class="d-flex flex-column gap-3 mt-2">
                                            @for (int i = 0; i < 4; i++)
                                            {
                                                var existingText = i < optsList.Count ? optsList[i].AnswerText : "";
                                                var isCorrect = i < optsList.Count && optsList[i].IsCorrect;
                                                <div class="input-group">
                                                    <div class="input-group-text bg-light border-end-0">
                                                        <input type="radio" name="correctIndex" value="@i" @(isCorrect ? "checked" : "") class="form-check-input" />
                                                    </div>
                                                    <input type="text" name="options" class="form-control" value="@existingText" placeholder="Đáp án @(i + 1)" required />
                                                </div>
                                            }
                                        </div>
                                        <small class="text-muted d-block mt-2"><i class="bi bi-info-circle me-1"></i>Tích chọn nút tròn bên trái đáp án để chọn làm đáp án đúng.</small>
                                    </div>
                                </div>
                                <div class="modal-footer border-0 pt-0">
                                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                                    <button type="submit" class="btn btn-jp-primary rounded-3">Lưu thay đổi</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                index++;
            }

            @if (!Model.Questions.Any())
            {
                <div class="card border-0 jp-omni-card rounded-4 p-5 text-center text-muted">
                    <i class="bi bi-patch-question fs-1 mb-3"></i>
                    <h5>Bài tập chưa có câu hỏi nào</h5>
                    <p class="small mb-0">Hãy soạn thảo câu hỏi mới ở khung biên soạn bên phải.</p>
                </div>
            }
        </div>
    </div>

    <!-- Create Question Sidebar -->
    <div class="col-lg-4">
        <div class="card border-0 jp-omni-card rounded-4 p-4 sticky-top" style="top: 100px; z-index: 5;">
            <h5 class="fw-bold mb-4"><i class="bi bi-plus-circle-fill text-danger me-2"></i>Thêm câu hỏi mới</h5>
            <form asp-action="CreateQuestion" asp-route-exerciseId="@Model.ExerciseId" method="post">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted">Nội dung câu hỏi</label>
                    <textarea name="questionText" class="form-control rounded-3" rows="3" placeholder="Nhập câu hỏi..." required></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted">Số điểm</label>
                    <input type="number" name="points" class="form-control rounded-3" value="10" min="1" required />
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted d-block">Các lựa chọn & Đáp án đúng</label>
                    <div class="d-flex flex-column gap-3 mt-2">
                        @for (int i = 0; i < 4; i++)
                        {
                            <div class="input-group">
                                <div class="input-group-text bg-light border-end-0">
                                    <input type="radio" name="correctIndex" value="@i" @(i == 0 ? "checked" : "") class="form-check-input" />
                                </div>
                                <input type="text" name="options" class="form-control" placeholder="Đáp án @(i + 1)" required />
                            </div>
                        }
                    </div>
                    <small class="text-muted d-block mt-2"><i class="bi bi-info-circle me-1"></i>Tích chọn nút tròn bên trái đáp án để chọn làm đáp án đúng.</small>
                </div>

                <button type="submit" class="btn btn-jp-primary w-100 rounded-3 py-2">
                    <i class="bi bi-check-lg me-1"></i> Lưu câu hỏi
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Import Excel Modal -->
<div class="modal fade" id="importExcelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-excel-fill text-success me-2"></i>Nhập Câu hỏi từ Excel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ImportExcel" asp-route-exerciseId="@Model.ExerciseId" method="post" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Chọn file Excel (.xlsx)</label>
                        <input type="file" name="excelFile" class="form-control rounded-3" accept=".xlsx" required />
                    </div>
                    <div class="bg-light p-3 rounded-3 small text-muted">
                        <div class="fw-bold mb-1"><i class="bi bi-info-circle me-1"></i>Cấu trúc file Excel mẫu:</div>
                        <ul class="mb-2 ps-3">
                            <li>Cột A: Nội dung câu hỏi</li>
                            <li>Cột B: Điểm số (ví dụ: 10)</li>
                            <li>Cột C, D, E, F: Đáp án 1, 2, 3, 4</li>
                            <li>Cột G: Số thứ tự đáp án đúng (từ 1 đến 4)</li>
                            <li>Dòng 1 là dòng tiêu đề (Header), hệ thống sẽ tự động bỏ qua.</li>
                        </ul>
                        <div class="text-end">
                            <a href="/templates/quizzes_template.xlsx" download class="btn btn-sm btn-link text-decoration-none p-0 text-success fw-bold"><i class="bi bi-download me-1"></i>Tải file Excel mẫu</a>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-jp-primary rounded-3">Bắt đầu nhập</button>
                </div>
            </form>
        </div>
    </div>
</div>
