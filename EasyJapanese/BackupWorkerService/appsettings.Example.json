{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=EasyJapaneseDB;User Id=sa;Password=your-password;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "Backup": {
    "BackupDirectory": "C:\\SqlBackups\\EasyJapanese",
    "RetentionDays": 7
  },
  "MembershipExpiry": {
    "RemindBeforeDays": 3
  },
  "Reconciliation": {
    "PendingThresholdMinutes": 30
  },
  "PayOS": {
    "ClientId": "your-client-id-from-payos",
    "ApiKey": "your-api-key-from-payos",
    "ChecksumKey": "your-checksum-key-from-payos"
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 465,
    "User": "your-gmail@gmail.com",
    "AppPassword": "your-gmail-app-password",
    "FromAddress": "noreply@yourdomain.com",
    "FromName": "Hi Japan!"
  }
}
