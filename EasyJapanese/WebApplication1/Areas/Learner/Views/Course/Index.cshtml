@model IEnumerable<CoreLibrary.Data.Entities.Course>
@{
    ViewData["Title"] = "Danh Sách Khóa Học - Hi Japan!";

    bool hasMembership = ViewBag.HasMembership ?? false;
    int? recommendedLevelId = ViewBag.RecommendedLevelId as int?;
    string? recommendedLevelName = ViewBag.RecommendedLevelName as string;
    var enrolledIds = (ViewBag.EnrolledCourseIds as HashSet<int>) ?? new HashSet<int>();

    // Group theo Level.SortOrder rồi Level.LevelName
    var groups = (Model ?? Enumerable.Empty<CoreLibrary.Data.Entities.Course>())
        .GroupBy(c => new { c.Level?.LevelName, SortOrder = c.Level?.SortOrder ?? 99 })
        .OrderBy(g => g.Key.SortOrder)
        .ToList();

    string LevelDesc(string? lvl) => lvl switch
    {
        "N5" => "Sơ cấp — Cơ bản tiếng Nhật",
        "N4" => "Tiền trung cấp — Giao tiếp hàng ngày",
        "N3" => "Trung cấp — Đọc hiểu & Hội thoại",
        "N2" => "Cao cấp — Tiếng Nhật chuyên sâu",
        "N1" => "Thành thạo — Gần như người bản ngữ",
        _ => lvl ?? ""
    };
}

@section Styles {
    @await Html.PartialAsync("_CourseStyle")
}

<!-- ═══ HERO — full width ═══ -->
<div class="hj-hero">
    <div class="hj-hero-kanji">学</div>
    <div class="container">
        <p class="hj-hero-eyebrow">講座 — Khóa học</p>
        <h1 class="hj-hero-title">Danh sách khóa học</h1>
        <p class="hj-hero-sub">
            @if (!hasMembership)
            {
                <text>Đăng ký membership để mở khoá toàn bộ nội dung N5 → N1.</text>
            }
            else if (recommendedLevelName != null)
            {
                <text>Trình độ gợi ý của bạn: <strong>@recommendedLevelName</strong> — nhưng bạn có thể học bất kỳ cấp độ nào.</text>
            }
            else
            {
                <text>Lựa chọn khoá học phù hợp với mục tiêu — học từ N5 đến N1.</text>
            }
        </p>
    </div>
</div>

<!-- ═══ COURSE LIST — full width bg ═══ -->
<div class="hj-course-list-section">
    <div class="container">

        @if (!groups.Any())
        {
            <div class="hj-empty text-center py-5 fade-in">
                <div style="font-size:40px;" class="mb-3">📚</div>
                <h5 class="fw-bold mb-2">Chưa có khóa học nào</h5>
                <p class="text-muted mb-0">
                    @if (!hasMembership)
                    {
                        <text>Đăng ký membership để xem toàn bộ khóa học.</text>
                    }
                    else
                    {
                        <text>Khóa học sẽ sớm được cập nhật.</text>
                    }
                </p>
                @if (!hasMembership)
                {
                    <a asp-area="Learner" asp-controller="Membership" asp-action="Plans"
                       class="btn-hj-course d-inline-block mt-4" style="width:auto;padding:10px 28px;">
                        Xem gói học →
                    </a>
                }
            </div>
        }
        else
        {
            @foreach (var group in groups)
            {
                var levelName = group.Key.LevelName ?? "N5";
                bool isRecommended = recommendedLevelId.HasValue
                && group.First().LevelId == recommendedLevelId.Value;

                <div class="hj-level-group fade-in">

                    <!-- Group header -->
                    <div class="hj-level-group-header">
                        <span class="hj-level-group-badge"
                              style="@(isRecommended ? "background:var(--color-primary);box-shadow:0 2px 8px rgba(200,16,46,.35);" : "")">
                            @levelName
                        </span>
                        <span class="hj-level-group-title">
                            @LevelDesc(levelName)
                        </span>
                        @if (isRecommended)
                        {
                            <span style="font-size:11.5px;font-weight:700;color:var(--color-primary);
                                                     background:rgba(200,16,46,.08);padding:3px 12px;
                                                     border-radius:var(--radius-full);white-space:nowrap;">
                                ⭐ Phù hợp với bạn
                            </span>
                        }
                        <div class="hj-level-group-line"></div>
                        <span class="text-muted" style="font-size:13px;white-space:nowrap;">
                            @group.Count() khoá
                        </span>
                    </div>

                    <!-- Cards -->
                    <div class="row g-4">
                        @{
                            int di = 1;
                        }
                        @foreach (var course in group)
                        {
                            bool isEnrolled = enrolledIds.Contains(course.CourseId);
                            bool isAccessible = course.IsFree || hasMembership;

                            <div class="col-md-6 col-lg-4 fade-in d@(di)">
                                <div class="hj-course-card @(!isAccessible ? "hj-locked" : "")">

                                    <div class="hj-course-thumb">
                                        <span class="hj-level-badge">@levelName</span>

                                        @if (course.IsFree)
                                        {
                                            <span class="hj-free-badge">Miễn phí</span>
                                        }
                                        else if (!isAccessible)
                                        {
                                            <span class="hj-locked-badge">
                                                <i class="bi bi-lock-fill"></i> Khoá
                                            </span>
                                        }

                                    日
                                </div>

                                <div class="hj-course-body">
                                    <h3 class="hj-course-title">@course.Title</h3>
                                    <p class="hj-course-desc">
                                        @(string.IsNullOrEmpty(course.Description)
                                                                        ? "Khóa học đang cập nhật mô tả."
                                                                        : course.Description)
                            </p>

                                        <hr class="hj-divider">

                                        <!-- Mentor -->
                                        <div class="hj-mentor-row">
                                @if (!string.IsNullOrEmpty(course.Mentor?.AvatarUrl))
                                            {
                                                <img src="@course.Mentor.AvatarUrl"
                                                     class="hj-mentor-avt"
                                                     alt="@course.Mentor.FullName">
                                            }
                                            else
                                            {
                                                <div class="hj-mentor-avt-fallback">
                                                    @((course.Mentor?.FullName ?? "G").Substring(0, 1).ToUpper())
                                                </div>
                                            }
                                            <div>
                                                <div class="hj-mentor-name">
                                                    @(course.Mentor?.FullName ?? "Đang cập nhật")
                                                </div>
                                                <div class="hj-mentor-exp">
                                                    @(course.Mentor?.Expertise ?? "Giảng viên Hi Japan!")
                                                </div>
                                            </div>
                                        </div>

                                        <!-- CTA -->
                                        @if (isAccessible)
                                        {
                                            <a href="/learn/Course/Detail/@course.CourseId"
                                               class="btn-hj-course mt-auto @(isEnrolled ? "enrolled" : "")">
                                                @(isEnrolled ? "Tiếp tục học" : "Vào học ngay")
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-area="Learner" asp-controller="Membership" asp-action="Plans"
                                               class="btn-hj-course mt-auto"
                                               style="border-color:var(--color-navy);color:var(--color-navy);">
                                                <i class="bi bi-lock me-1"></i>Mở khoá membership
                                            </a>
                                        }
                                    </div>

                                </div>
                            </div>
                            if (di < 6) di++;
                        }
                    </div>

                </div>
            }

            <!-- Nếu không có membership, hiện CTA upgrade ở cuối -->
            @if (!hasMembership)
            {
                <div class="text-center pt-2 pb-4 fade-in">
                    <p class="text-muted mb-3" style="font-size:14px;">
                        Đăng ký membership để mở khoá tất cả khoá học N5 → N1.
                    </p>
                    <a asp-area="Learner" asp-controller="Membership" asp-action="Plans"
                       class="btn-hj-course d-inline-block"
                       style="width:auto;padding:11px 32px;
                                      background:var(--color-primary);color:#fff;border-color:var(--color-primary);">
                        Xem gói học →
                    </a>
                </div>
            }
        }

    </div>
</div>
