<style>
    .hj-chatbot {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 1050;
    }

    .hj-chatbot-toggle {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--color-primary, #c8102e);
        color: #fff;
        border: none;
        font-size: 22px;
        box-shadow: 0 6px 18px rgba(200,16,46,.35);
        cursor: pointer;
        transition: transform .15s;
    }

        .hj-chatbot-toggle:hover {
            transform: scale(1.06);
        }

    .hj-chatbot-panel {
        position: absolute;
        bottom: 70px;
        right: 0;
        width: 360px;
        height: 520px;
        max-height: calc(100vh - 120px);
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0,0,0,.18);
        border: 1px solid var(--color-border, #e4e0db);
        display: none;
        flex-direction: column;
        overflow: hidden;
    }

        .hj-chatbot-panel.open {
            display: flex;
        }

    .hj-chatbot-header {
        flex-shrink: 0;
        background: var(--color-primary, #c8102e);
        color: #fff;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 700;
        font-size: 14px;
    }

    .hj-chatbot-header-title {
        display: flex;
        align-items: center;
        gap: 7px;
    }

