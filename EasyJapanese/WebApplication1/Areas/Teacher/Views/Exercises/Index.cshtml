@model IEnumerable<CoreLibrary.Data.Entities.Exercise>
@{
    Layout = "~/Areas/Teacher/Views/Shared/_TeacherLayout.cshtml";
    var courses = ViewBag.Courses as List<CoreLibrary.Data.Entities.Course> ?? new List<CoreLibrary.Data.Entities.Course>();
    int? selectedCourseId = ViewBag.SelectedCourseId;
    var lessonsByCourse = ViewBag.LessonsByCourse as Dictionary<int, List<dynamic>> ?? new Dictionary<int, List<dynamic>>();
    var lessonsJson = System.Text.Json.JsonSerializer.Serialize(
        lessonsByCourse.ToDictionary(
            kv => kv.Key,
            kv => kv.Value.Select(l => new { lessonId = (int)l.LessonId, title = (string)l.Title }).ToList<object>()
        )
    );
    var exerciseTypes = new[] { "Grammar", "Kanji", "Listening", "Reading", "Vocabulary" };
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="mb-1 fw-bold">Danh sách Bài tập (Exercise)</h3>
        <p class="text-muted small mb-0">Quản lý bài tập thực hành gắn với từng bài giảng — không lưu kết quả làm bài của học viên.</p>
    </div>
    @if (courses.Any())
    {
        <div class="d-flex gap-2">
            <button class="btn btn-jp-outline" data-bs-toggle="modal" data-bs-target="#importExerciseSetModal">
                <i class="bi bi-file-earmark-excel-fill text-success me-1"></i> Nhập từ Excel
            </button>
            <button class="btn btn-jp-primary" data-bs-toggle="modal" data-bs-target="#createExerciseModal">
                <i class="bi bi-plus-lg me-1"></i> Tạo Bài tập mới
            </button>
        </div>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 jp-omni-card rounded-4 p-4 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-9">
            <label class="form-label small fw-bold text-muted">Lọc theo Khóa học</label>
            <select name="courseId" class="form-select rounded-3">
                <option value="">Tất cả các khóa học</option>
                @foreach (var c in courses)
                {
                    <option value="@c.CourseId" selected="@(selectedCourseId == c.CourseId)">@c.Title</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-jp-primary w-100 rounded-3">Lọc danh sách</button>
        </div>
    </form>
</div>

<div class="row g-4">
    @foreach (var exercise in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 jp-omni-card h-100 rounded-4">
                <div class="card-body p-4 d-flex flex-column">

                    <!-- Header: badges + dropdown neo cố định góc phải, không phụ thuộc flex -->
                    <div class="position-relative mb-3" style="padding-right: 36px;">
                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1 fw-bold small d-inline-block"
                              style="max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: top;">
                            @exercise.Course?.Title
                        </span>
                        @if (exercise.Lesson != null)
                        {
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1 fw-bold small d-inline-block ms-1"
                                  style="max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: top;">
                                @exercise.Lesson.Title
                            </span>
                        }

                        <div class="dropdown position-absolute" style="top: 0; right: 0;">
                            <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical fs-5"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm">
                                <li>
                                    <button class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#editExerciseModal-@exercise.ExerciseId">
                                        <i class="bi bi-pencil me-2 text-muted"></i> Chỉnh sửa
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#importExcelModal-@exercise.ExerciseId">
                                        <i class="bi bi-file-earmark-excel-fill me-2 text-success"></i> Nhập từ Excel
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-action="Delete" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa Bài tập này và các câu hỏi liên quan?');">
                                        <input type="hidden" name="exerciseId" value="@exercise.ExerciseId" />
                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                            <i class="bi bi-trash3 me-2"></i> Xóa Bài tập
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1 fw-bold small mb-2 align-self-start">
                        @exercise.ExerciseType
                    </span>
                    <h5 class="fw-bold mb-2">@exercise.Title</h5>

                    <div class="border-top border-light pt-3 mt-auto">
                        <div class="row g-2 text-center text-muted small">
                            <div class="col-6 border-end">
                                <span class="d-block">Loại</span>
                                <span class="fw-bold text-dark">@exercise.ExerciseType</span>
                            </div>
                            <div class="col-6">
                                <span class="d-block">Câu hỏi</span>
                                <span class="fw-bold text-dark">@(exercise.Questions?.Count ?? 0) câu</span>
                            </div>
                        </div>
                    </div>

                    <a href="/teacher/exercises/questions/@exercise.ExerciseId" class="btn btn-jp-outline w-100 mt-4 text-decoration-none">
                        <i class="bi bi-gear-fill me-1"></i> Soạn câu hỏi
                    </a>
                </div>
            </div>
        </div>

        <!-- Edit Modal -->
        <div class="modal fade" id="editExerciseModal-@exercise.ExerciseId" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow-lg">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold">Chỉnh sửa Bài tập</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form asp-action="Edit" method="post">
                        <input type="hidden" name="ExerciseId" value="@exercise.ExerciseId" />
                        <div class="modal-body p-4">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Khóa học liên kết</label>
                                <select name="CourseId" class="form-select rounded-3 exercise-course-select" required>
                                    @foreach (var c in courses)
                                    {
                                        <option value="@c.CourseId" selected="@(exercise.CourseId == c.CourseId)">@c.Title</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Bài học (tùy chọn)</label>
                                <select name="lessonId" class="form-select rounded-3 exercise-lesson-select" data-selected="@exercise.LessonId">
                                    <option value="">-- Không gắn với bài học cụ thể --</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Loại Bài tập</label>
                                <select name="ExerciseType" class="form-select rounded-3" required>
                                    @foreach (var t in exerciseTypes)
                                    {
                                        <option value="@t" selected="@(exercise.ExerciseType == t)">@t</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Tiêu đề Bài tập</label>
                                <input type="text" name="Title" class="form-control rounded-3" value="@exercise.Title" placeholder="Ví dụ: Luyện tập Từ vựng Bài 1" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Nội dung / Hướng dẫn</label>
                                <textarea name="Content" class="form-control rounded-3" rows="3" placeholder="Mô tả nội dung bài tập">@exercise.Content</textarea>
                            </div>
                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="form-label small fw-bold text-muted">Audio URL (tùy chọn)</label>
                                    <input type="text" name="AudioUrl" class="form-control rounded-3" value="@exercise.AudioUrl" placeholder="https://..." />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-bold text-muted">Stroke Order URL (tùy chọn)</label>
                                    <input type="text" name="StrokeOrderUrl" class="form-control rounded-3" value="@exercise.StrokeOrderUrl" placeholder="https://..." />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-jp-primary rounded-3">Cập nhật</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Import Excel Modal -->
        <div class="modal fade" id="importExcelModal-@exercise.ExerciseId" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow-lg">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-excel-fill text-success me-2"></i>Nhập Câu hỏi từ Excel</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form asp-action="ImportExcel" asp-route-exerciseId="@exercise.ExerciseId" method="post" enctype="multipart/form-data">
                        <div class="modal-body p-4 text-start">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Bài tập nhận câu hỏi</label>
                                <input type="text" class="form-control rounded-3 bg-light" value="@exercise.Title" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Chọn file Excel (.xlsx)</label>
                                <input type="file" name="excelFile" class="form-control rounded-3" accept=".xlsx" required />
                            </div>
                            <div class="bg-light p-3 rounded-3 small text-muted">
                                <div class="fw-bold mb-1"><i class="bi bi-info-circle me-1"></i>Cấu trúc file Excel mẫu:</div>
                                <ul class="mb-2 ps-3">
                                    <li>Cột A: Nội dung câu hỏi</li>
                                    <li>Cột B: Điểm số (ví dụ: 10)</li>
                                    <li>Cột C, D, E, F: Đáp án A, B, C, D</li>
                                    <li>Cột G: Số thứ tự đáp án đúng (từ 1 đến 4)</li>
                                    <li>Dòng 1 là tiêu đề (Header), hệ thống tự động bỏ qua.</li>
                                </ul>
                                <div class="text-end">
                                    <a href="/templates/quizzes_template.xlsx" download class="btn btn-sm btn-link text-decoration-none p-0 text-success fw-bold"><i class="bi bi-download me-1"></i>Tải file Excel mẫu</a>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-jp-primary rounded-3">Bắt đầu nhập</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="bi bi-patch-question fs-1 mb-3"></i>
            <h5>Chưa có Bài tập nào được tạo</h5>
            <p class="small">Chọn khóa học hoặc bấm "Tạo Bài tập mới" để bắt đầu thiết lập bài tập thực hành.</p>
        </div>
    }
</div>

<!-- Create Modal -->
<div class="modal fade" id="createExerciseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Tạo Bài tập mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Khóa học liên kết</label>
                        <select name="CourseId" class="form-select rounded-3 exercise-course-select" required>
                            @foreach (var c in courses)
                            {
                                <option value="@c.CourseId" selected="@(selectedCourseId == c.CourseId)">@c.Title</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Bài học (tùy chọn)</label>
                        <select name="lessonId" class="form-select rounded-3 exercise-lesson-select">
                            <option value="">-- Không gắn với bài học cụ thể --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Loại Bài tập</label>
                        <select name="ExerciseType" class="form-select rounded-3" required>
                            @foreach (var t in exerciseTypes)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Tiêu đề Bài tập</label>
                        <input type="text" name="Title" class="form-control rounded-3" placeholder="Ví dụ: Luyện tập Kanji N5" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Nội dung / Hướng dẫn</label>
                        <textarea name="Content" class="form-control rounded-3" rows="3" placeholder="Mô tả nội dung bài tập"></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Audio URL (tùy chọn)</label>
                            <input type="text" name="AudioUrl" class="form-control rounded-3" placeholder="https://..." />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Stroke Order URL (tùy chọn)</label>
                            <input type="text" name="StrokeOrderUrl" class="form-control rounded-3" placeholder="https://..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-jp-primary rounded-3">Tạo Bài tập</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Import Exercise Set Modal -->
<div class="modal fade" id="importExerciseSetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-excel-fill text-success me-2"></i>Nhập Bộ Bài tập từ Excel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ImportExerciseSet" method="post" enctype="multipart/form-data">
                <div class="modal-body p-4 text-start">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Khóa học liên kết</label>
                        <select name="courseId" class="form-select rounded-3" required>
                            @foreach (var c in courses)
                            {
                                <option value="@c.CourseId" selected="@(selectedCourseId == c.CourseId)">@c.Title</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Loại Bài tập</label>
                        <select name="exerciseType" class="form-select rounded-3" required>
                            @foreach (var t in exerciseTypes)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Tiêu đề Bài tập</label>
                        <input type="text" name="title" class="form-control rounded-3" placeholder="Ví dụ: Luyện tập Kanji N5" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Nội dung / Hướng dẫn</label>
                        <textarea name="content" class="form-control rounded-3" rows="2" placeholder="Mô tả nội dung bài tập"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Chọn file Excel câu hỏi (.xlsx)</label>
                        <input type="file" name="excelFile" class="form-control rounded-3" accept=".xlsx" required />
                    </div>
                    <div class="bg-light p-3 rounded-3 small text-muted">
                        <div class="fw-bold mb-1"><i class="bi bi-info-circle me-1"></i>Cấu trúc file Excel mẫu:</div>
                        <ul class="mb-2 ps-3">
                            <li>Cột A: Nội dung câu hỏi</li>
                            <li>Cột B: Điểm số (ví dụ: 10)</li>
                            <li>Cột C, D, E, F: Đáp án A, B, C, D</li>
                            <li>Cột G: Số thứ tự đáp án đúng (từ 1 đến 4)</li>
                            <li>Dòng 1 là tiêu đề (Header), hệ thống tự động bỏ qua.</li>
                        </ul>
                        <div class="text-end">
                            <a href="/templates/quizzes_template.xlsx" download class="btn btn-sm btn-link text-decoration-none p-0 text-success fw-bold"><i class="bi bi-download me-1"></i>Tải file Excel mẫu</a>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-jp-primary rounded-3">Tạo & Nhập câu hỏi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const lessonsByCourse = @Html.Raw(lessonsJson);

    function populateLessonSelect(courseSelect, lessonSelect) {
        const courseId = courseSelect.value;
        const lessons = lessonsByCourse[courseId] || [];
        const selected = lessonSelect.getAttribute('data-selected') || '';
        lessonSelect.innerHTML = '<option value="">-- Không gắn với bài học cụ thể --</option>';
        lessons.forEach(l => {
            const opt = document.createElement('option');
            opt.value = l.lessonId;
            opt.textContent = l.title;
            if (String(l.lessonId) === selected) opt.selected = true;
            lessonSelect.appendChild(opt);
        });
    }

    document.querySelectorAll('.modal').forEach(modal => {
        const cs = modal.querySelector('.exercise-course-select');
        const ls = modal.querySelector('.exercise-lesson-select');
        if (!cs || !ls) return;
        populateLessonSelect(cs, ls);
        cs.addEventListener('change', () => populateLessonSelect(cs, ls));
    });
</script>
