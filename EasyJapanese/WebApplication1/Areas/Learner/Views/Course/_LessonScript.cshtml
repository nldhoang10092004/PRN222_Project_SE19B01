<script>
    (function () {
        const sidebar = document.getElementById('lessonSidebar');
        const toggleEl = document.getElementById('sidebarToggle');
        const icon = document.getElementById('toggleIcon');

        const tabItems = document.querySelectorAll('.lesson-tab-item');
        const tabPanels = document.querySelectorAll('.lesson-tab-panel');

        function escapeHtml(s) {
            return String(s).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }

        // ==========================================================
        // Toggle sidebar
        // ==========================================================
        if (toggleEl && sidebar && icon) {
            toggleEl.addEventListener('click', function () {
                const collapsed = sidebar.classList.toggle('collapsed');

                icon.className = collapsed
                    ? 'bi bi-layout-sidebar'
                    : 'bi bi-layout-sidebar-reverse';
            });
        }

        // ==========================================================
        // Chuyển tab ngang
        // ==========================================================
        function activateTab(item) {
            const targetId = item.getAttribute('data-panel');

            tabItems.forEach(function (tab) {
                tab.classList.remove('active');
            });
            item.classList.add('active');

            tabPanels.forEach(function (panel) {
                panel.classList.remove('active');
            });

            const targetPanel = document.getElementById(targetId);
            if (targetPanel) {
                targetPanel.classList.add('active');
            }
        }

        tabItems.forEach(function (item) {
            item.addEventListener('click', function () {
                activateTab(this);
            });
        });

        // Tab đầu tiên hiển thị theo mặc định
        if (tabItems.length > 0) {
            activateTab(tabItems[0]);
        }

        // ==========================================================
        // Audio player
        // ==========================================================
        let currentAudio = null;
        let currentButton = null;
        let currentProgressFill = null;

        document.querySelectorAll('.audio-play-btn[data-audio]').forEach(function (btn) {

            const audioUrl = btn.getAttribute('data-audio');

            if (!audioUrl) return;

            btn.addEventListener('click', function () {

                const url = this.getAttribute('data-audio');

                if (!url) return;

                const card = this.closest('.audio-card');
                const progressFill = card
                    ? card.querySelector('.audio-progress-fill')
                    : null;

                const iconEl = this.querySelector('i');

                // Nếu click đúng bài đang phát thì pause
                if (currentAudio && currentAudio._url === url) {

                    if (!currentAudio.paused) {
                        currentAudio.pause();

                        if (iconEl) {
                            iconEl.className = 'bi bi-play-fill';
                        }

                        return;
                    }

                    currentAudio.play();

                    if (iconEl) {
                        iconEl.className = 'bi bi-pause-fill';
                    }

                    return;
                }

                // Dừng audio cũ nếu đang phát
                if (currentAudio) {
                    currentAudio.pause();

                    if (currentButton) {
                        const oldIcon = currentButton.querySelector('i');

                        if (oldIcon) {
                            oldIcon.className = 'bi bi-play-fill';
                        }
                    }

                    if (currentProgressFill) {
                        currentProgressFill.style.width = '0%';
                    }
                }

                // Tạo audio mới
                currentAudio = new Audio(url);
                currentAudio._url = url;

                currentButton = this;
                currentProgressFill = progressFill;

                if (iconEl) {
                    iconEl.className = 'bi bi-pause-fill';
                }

                currentAudio.addEventListener('timeupdate', function () {
                    if (this.duration && progressFill) {
                        const percent = (this.currentTime / this.duration) * 100;
                        progressFill.style.width = percent + '%';
                    }
                });

                currentAudio.addEventListener('ended', function () {
                    if (iconEl) {
                        iconEl.className = 'bi bi-play-fill';
                    }

                    if (progressFill) {
                        progressFill.style.width = '0%';
                    }

                    currentAudio = null;
                    currentButton = null;
                    currentProgressFill = null;
                });

                currentAudio.addEventListener('error', function () {
                    if (iconEl) {
                        iconEl.className = 'bi bi-play-fill';
                    }

                    if (progressFill) {
                        progressFill.style.width = '0%';
                    }

                    alert('Không thể phát audio. Kiểm tra lại AudioUrl trong database.');

                    currentAudio = null;
                    currentButton = null;
                    currentProgressFill = null;
                });

                currentAudio.play().catch(function () {
                    if (iconEl) {
                        iconEl.className = 'bi bi-play-fill';
                    }

                    alert('Không thể phát audio. Kiểm tra lại AudioUrl trong database.');
                });
            });
        });

    // ==========================================================
    // Nút Practice của từng Exercise (render inline trong trang)
    // ==========================================================
    const practiceBase = '/learn/Course';

    document.querySelectorAll('.btn-practice').forEach(function (button) {
        button.addEventListener('click', function () {
            const exerciseId = this.getAttribute('data-exercise-id');
            const exerciseTitle = this.getAttribute('data-exercise-title') || 'Luyện tập';
            if (!exerciseId) return;

            const area = document.getElementById('practice-' + exerciseId);
            if (!area) return;

            // Bấm lại nút đang mở -> đóng lại
            if (area.classList.contains('opened')) {
                area.classList.remove('opened');
                area.innerHTML = '';
                return;
            }

            // Đóng các practice-area khác đang mở (chỉ mở 1 cái/lúc)
            document.querySelectorAll('.practice-area.opened').forEach(function (el) {
                el.classList.remove('opened');
                el.innerHTML = '';
            });

            area.classList.add('opened');
            area.innerHTML = '<div class="practice-loading"><i class="bi bi-arrow-repeat"></i> Đang tải câu hỏi...</div>';

            fetch(practiceBase + '/ExercisePractice?exerciseId=' + encodeURIComponent(exerciseId))
                .then(function (res) {
                    if (!res.ok) throw new Error('load-failed');
                    return res.json();
                })
                .then(function (data) {
                    renderPracticeBox(area, exerciseId, exerciseTitle, data.questions || []);
                })
                .catch(function () {
                    area.innerHTML =
                        '<div class="practice-warning"><i class="bi bi-exclamation-triangle"></i> Không thể tải bài luyện tập. Vui lòng thử lại.</div>';
                });
        });
    });

    // ==========================================================
    // Dựng UI bài luyện tập từ JSON
    // ==========================================================
        function renderPracticeBox(area, exerciseId, exerciseTitle, questions) {
        if (!questions.length) {
            area.innerHTML =
                '<div class="practice-box">' +
                '<div class="practice-heading"><i class="bi bi-pencil-square"></i>' + escapeHtml(exerciseTitle) + '</div>' +
                '<div class="practice-empty"><i class="bi bi-info-circle"></i> Bài tập này chưa có câu hỏi.</div>' +
                '</div>';
            return;
        }

        let html = '<div class="practice-box">';
        html += '<div class="practice-heading"><i class="bi bi-pencil-square"></i>' + escapeHtml(exerciseTitle) + '</div>';

        questions.forEach(function (q, qIndex) {
            html += '<div class="practice-question" data-question-id="' + q.questionId + '">';
            html += '<div class="practice-question-text"><span class="q-index">' + (qIndex + 1) + '</span>' + escapeHtml(q.questionText) + '</div>';
            html += '<div class="practice-options">';

            (q.options || []).forEach(function (opt) {
                html +=
                    '<label class="practice-option">' +
                    '<input type="radio" name="q-' + q.questionId + '" value="' + opt.optionId + '">' +
                    '<span>' + escapeHtml(opt.answerText) + '</span>' +
                    '</label>';
            });

            html += '</div></div>';
        });

        html += '<button type="button" class="btn-submit-practice"><i class="bi bi-check2-circle"></i> Nộp bài</button>';
        html += '<div class="practice-score-holder"></div>';
        html += '</div>';

        area.innerHTML = html;

        const submitBtn = area.querySelector('.btn-submit-practice');
        submitBtn.addEventListener('click', function () {
            submitPractice(area, exerciseId, questions, exerciseTitle);
        });
    }

    function submitPractice(area, exerciseId, questions, exerciseTitle) {
        const answers = questions.map(function (q) {
            const checked = area.querySelector('input[name="q-' + q.questionId + '"]:checked');
            return {
                questionId: q.questionId,
                optionId: checked ? parseInt(checked.value, 10) : null
            };
        });

        const submitBtn = area.querySelector('.btn-submit-practice');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Đang chấm...';

        fetch(practiceBase + '/CheckExercise', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ exerciseId: parseInt(exerciseId, 10), answers: answers })
        })
            .then(function (res) {
                if (!res.ok) throw new Error('check-failed');
                return res.json();
            })
            .then(function (data) {
                let correctCount = 0;

                (data.answers || []).forEach(function (result) {
                    const qBlock = area.querySelector('.practice-question[data-question-id="' + result.questionId + '"]');
                    if (!qBlock) return;

                    // Tô riêng ô người dùng đã chọn: xanh nếu đúng, đỏ nếu sai.
                    // Không tiết lộ đáp án đúng nếu chọn sai.
                    const selectedInput = qBlock.querySelector('input:checked');
                    if (selectedInput) {
                        const selectedOption = selectedInput.closest('.practice-option');
                        selectedOption.classList.add(result.isCorrect ? 'correct' : 'incorrect');
                    }

                    if (result.isCorrect) correctCount++;

                    // Khóa lại không cho sửa nữa sau khi nộp
                    qBlock.querySelectorAll('input').forEach(function (inp) {
                        inp.disabled = true;
                    });
                });

                const scoreHolder = area.querySelector('.practice-score-holder');
                scoreHolder.innerHTML =
                    '<div class="practice-score">' +
                    '<span><i class="bi bi-award"></i> Điểm: ' + correctCount + '/' + questions.length + '</span>' +
                    '<button type="button" class="btn-retry-practice"><i class="bi bi-arrow-repeat"></i> Làm lại</button>' +
                    '</div>';

                scoreHolder.querySelector('.btn-retry-practice').addEventListener('click', function () {
                    renderPracticeBox(area, exerciseId, exerciseTitle, questions);
                });

                submitBtn.style.display = 'none';
            })
            .catch(function () {
                alert('Không thể chấm bài. Vui lòng thử lại.');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-check2-circle"></i> Nộp bài';
            });
    }
    function escapeHtml(str) {
        if (!str) return '';
        return str
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

        // ==========================================================
        // Đánh dấu hoàn thành bài học
        // ==========================================================
        const completeBtn = document.getElementById('btnCompleteLesson');
        if (completeBtn) {
            completeBtn.addEventListener('click', function () {
                if (completeBtn.classList.contains('completed')) return;

                const lessonId = parseInt(completeBtn.getAttribute('data-lesson-id'), 10);
                completeBtn.disabled = true;

                fetch('/learn/Course/UpdateProgress', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ lessonId: lessonId, isCompleted: true })
                })
                    .then(function (res) {
                        if (!res.ok) throw new Error('Không thể cập nhật tiến độ.');
                        return res.json();
                    })
                    .then(function () {
                        completeBtn.classList.add('completed');
                        const icon = completeBtn.querySelector('i');
                        const label = completeBtn.querySelector('.btn-complete-label');
                        if (icon) icon.className = 'bi bi-check-circle-fill';
                        if (label) label.textContent = 'Đã hoàn thành';

                        const currentLessonItem = document.querySelector('.lesson-list-item.active');
                        if (currentLessonItem) {
                            currentLessonItem.classList.add('completed');
                            const statusIcon = currentLessonItem.querySelector('.lesson-status-icon i');
                            if (statusIcon) statusIcon.className = 'bi bi-check-circle-fill';
                        }
                    })
                    .catch(function () {
                        completeBtn.disabled = false;
                        alert('Không thể lưu tiến độ. Vui lòng thử lại.');
                    });
            });
        }

    })();
</script>
