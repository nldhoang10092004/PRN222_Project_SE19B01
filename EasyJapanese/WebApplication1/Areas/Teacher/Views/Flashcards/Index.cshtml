@model IEnumerable<CoreLibrary.Data.Entities.Flashcard>
@{
    Layout = "~/Areas/Teacher/Views/Shared/_TeacherLayout.cshtml";
    var courses = ViewBag.Courses as List<CoreLibrary.Data.Entities.Course> ?? new List<CoreLibrary.Data.Entities.Course>();
    int? selectedCourseId = ViewBag.SelectedCourseId;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="mb-1 fw-bold">Kho thẻ Flashcards</h3>
        <p class="text-muted small mb-0">Quản lý thẻ từ vựng/mẫu câu cho các khóa học bạn phụ trách.</p>
    </div>
    @if (courses.Any())
    {
        <div class="d-flex gap-2">
            <button class="btn btn-jp-outline" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                <i class="bi bi-file-earmark-excel-fill text-success me-1"></i> Nhập Excel
            </button>
            <button class="btn btn-jp-primary" data-bs-toggle="modal" data-bs-target="#createFlashcardModal">
                <i class="bi bi-plus-lg me-1"></i> Thêm Flashcard mới
            </button>
        </div>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 jp-omni-card rounded-4 p-4 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-9">
            <label class="form-label small fw-bold text-muted">Lọc theo Khóa học</label>
            <select name="courseId" class="form-select rounded-3">
                <option value="">Tất cả các khóa học của tôi</option>
                @foreach (var c in courses)
                {
                    <option value="@c.CourseId" selected="@(selectedCourseId == c.CourseId)">@c.Title</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-jp-primary w-100 rounded-3">Lọc danh sách</button>
        </div>
    </form>
</div>

<div class="row g-4">
    @foreach (var fc in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 jp-omni-card rounded-4 h-100">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1 fw-semibold small">
                                @fc.Course?.Title
                            </span>
                            <div class="dropdown">
                                <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical fs-5"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm">
                                    <li>
                                        <button class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#editFlashcardModal-@fc.FlashcardId">
                                            <i class="bi bi-pencil me-2 text-muted"></i> Chỉnh sửa
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-action="Delete" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa thẻ Flashcard này?');">
                                            <input type="hidden" name="flashcardId" value="@fc.FlashcardId" />
                                            <button type="submit" class="dropdown-item py-2 text-danger">
                                                <i class="bi bi-trash3 me-2"></i> Xóa thẻ
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Flashcard Content -->
                        <div class="my-4 text-center py-3 border rounded-3 bg-light bg-opacity-50 position-relative">
                            <div class="small text-muted mb-1">Mặt trước</div>
                            <h4 class="fw-bold text-dark font-monospace mb-3">@fc.FrontText</h4>
                            <hr class="my-2 border-dashed">
                            <div class="small text-muted mb-1">Mặt sau</div>
                            <p class="mb-0 fw-semibold text-danger">@fc.BackText</p>
                        </div>
                    </div>

                    <div class="text-muted small text-end">
                        Đã tạo: @fc.CreatedAt.ToString("dd/MM/yyyy")
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit Modal -->
        <div class="modal fade" id="editFlashcardModal-@fc.FlashcardId" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow-lg">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold">Chỉnh sửa Flashcard</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form asp-action="Edit" method="post">
                        <input type="hidden" name="FlashcardId" value="@fc.FlashcardId" />
                        <div class="modal-body p-4">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Khóa học liên kết</label>
                                <select name="CourseId" class="form-select rounded-3" required>
                                    @foreach (var c in courses)
                                    {
                                        <option value="@c.CourseId" selected="@(fc.CourseId == c.CourseId)">@c.Title</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Mặt trước (Từ vựng/Câu tiếng Nhật)</label>
                                <input type="text" name="FrontText" class="form-control rounded-3" value="@fc.FrontText" placeholder="Ví dụ: 食べる" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Mặt sau (Giải nghĩa/Cách đọc)</label>
                                <input type="text" name="BackText" class="form-control rounded-3" value="@fc.BackText" placeholder="Ví dụ: Ăn (Taberu)" required />
                            </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-jp-primary rounded-3">Cập nhật</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="bi bi-postcard fs-1 mb-3"></i>
            <h5>Chưa có thẻ Flashcard nào</h5>
            <p class="small">Chọn bộ lọc khóa học hoặc bấm "Thêm Flashcard mới" để bắt đầu soạn từ vựng.</p>
        </div>
    }
</div>

<!-- Create Modal -->
<div class="modal fade" id="createFlashcardModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Tạo Flashcard mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Khóa học liên kết</label>
                        <select name="CourseId" class="form-select rounded-3" required>
                            @foreach (var c in courses)
                            {
                                <option value="@c.CourseId" selected="@(selectedCourseId == c.CourseId)">@c.Title</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Mặt trước (Từ vựng/Câu tiếng Nhật)</label>
                        <input type="text" name="FrontText" class="form-control rounded-3" placeholder="Ví dụ: 食べる" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Mặt sau (Giải nghĩa/Cách đọc)</label>
                        <input type="text" name="BackText" class="form-control rounded-3" placeholder="Ví dụ: Ăn (Taberu)" required />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-jp-primary rounded-3">Tạo thẻ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Import Excel Modal -->
<div class="modal fade" id="importExcelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-excel-fill text-success me-2"></i>Nhập từ Excel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Chọn khóa học muốn nhập</label>
                        <select name="courseId" class="form-select rounded-3" required>
                            @foreach (var c in courses)
                            {
                                <option value="@c.CourseId" selected="@(selectedCourseId == c.CourseId)">@c.Title</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Chọn file Excel (.xlsx)</label>
                        <input type="file" name="excelFile" class="form-control rounded-3" accept=".xlsx" required />
                    </div>
                    <div class="bg-light p-3 rounded-3 small text-muted">
                        <div class="fw-bold mb-1"><i class="bi bi-info-circle me-1"></i>Cấu trúc file Excel mẫu:</div>
                        <ul class="mb-2 ps-3">
                            <li>Cột A (Dòng 2 trở đi): Mặt trước (Tiếng Nhật)</li>
                            <li>Cột B (Dòng 2 trở đi): Mặt sau (Tiếng Việt)</li>
                            <li>Dòng 1 là dòng tiêu đề (Header), hệ thống sẽ tự động bỏ qua.</li>
                        </ul>
                        <div class="text-end">
                            <a href="/templates/flashcards_template.xlsx" download class="btn btn-sm btn-link text-decoration-none p-0 text-success fw-bold"><i class="bi bi-download me-1"></i>Tải file Excel mẫu</a>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-jp-primary rounded-3">Bắt đầu nhập</button>
                </div>
            </form>
        </div>
    </div>
</div>
