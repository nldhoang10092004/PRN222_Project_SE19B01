@model IEnumerable<CoreLibrary.Data.Entities.Course>
@{
    ViewData["Title"] = "Danh Sách Khóa Học";
    var currentLevel = ViewBag.CurrentLevel as string ?? "";
    var currentPrice = ViewBag.CurrentPrice as string ?? "";
    var currentSort = ViewBag.CurrentSort as string ?? "level";
    var currentQuery = ViewBag.CurrentQuery as string ?? "";
    var hasFilter = !string.IsNullOrEmpty(currentLevel)
        || !string.IsNullOrEmpty(currentPrice)
        || (!string.IsNullOrEmpty(currentSort) && currentSort != "level")
        || !string.IsNullOrEmpty(currentQuery);

    bool hasMembership = ViewBag.HasMembership ?? false;
    string? recommendedLevelName = ViewBag.RecommendedLevelName as string;
    var enrolledIds = (ViewBag.EnrolledCourseIds as HashSet<int>) ?? new HashSet<int>();

    var groups = (Model ?? Enumerable.Empty<CoreLibrary.Data.Entities.Course>())
        .ToList();

    string BuildUrl(string? level = null, string? price = null, bool resetLevel = false, bool resetPrice = false)
    {
        var l = resetLevel ? null : (level ?? currentLevel);
        var p = resetPrice ? null : (price ?? currentPrice);
        var s = currentSort == "level" ? null : currentSort;
        var qs = new System.Collections.Generic.List<string>();
        if (!string.IsNullOrEmpty(l)) qs.Add("level=" + Uri.EscapeDataString(l));
        if (!string.IsNullOrEmpty(p)) qs.Add("price=" + Uri.EscapeDataString(p));
        if (!string.IsNullOrEmpty(s)) qs.Add("sort=" + Uri.EscapeDataString(s));
        if (!string.IsNullOrEmpty(currentQuery)) qs.Add("q=" + Uri.EscapeDataString(currentQuery));
        return "/learn/Course" + (qs.Count > 0 ? "?" + string.Join("&", qs) : "");
    }
}

@section Styles {
    @await Html.PartialAsync("_CourseStyle")
    <style>
        .hj-filter-bar {
            background: #fff;
            border: 1px solid var(--color-border);
            border-radius: 16px;
            padding: 1.25rem 1.5rem;
            box-shadow: var(--shadow-sm);
            margin-bottom: 2rem;
        }

        .hj-filter-row {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem 1.5rem;
            align-items: flex-end;
        }

        .hj-filter-group {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            min-width: 0;
        }

        .hj-filter-label {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: #6c757d;
        }

        .hj-filter-options {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
        }

        .hj-filter-chip {
            padding: 0.4rem 0.9rem;
            border-radius: 999px;
            border: 1px solid var(--color-border);
            background: #fff;
            color: var(--color-text);
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.15s;
        }

            .hj-filter-chip:hover {
                border-color: var(--color-primary);
                color: var(--color-primary);
            }

            .hj-filter-chip.active {
                background: var(--color-primary);
                border-color: var(--color-primary);
                color: #fff;
            }

        .hj-search-input {
            border: 1px solid var(--color-border);
            border-radius: 10px;
            padding: 0.55rem 0.9rem;
            font-size: 0.9rem;
            min-width: 220px;
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

            .hj-search-input:focus {
                border-color: var(--color-primary);
                box-shadow: 0 0 0 3px rgba(200, 16, 46, 0.1);
            }

        .hj-sort-select {
            border: 1px solid var(--color-border);
            border-radius: 10px;
            padding: 0.55rem 2rem 0.55rem 0.9rem;
            font-size: 0.9rem;
            background: #fff;
            cursor: pointer;
            min-width: 200px;
        }

        .hj-filter-clear {
            font-size: 0.85rem;
            color: #6c757d;
            text-decoration: none;
            padding: 0.55rem 0.75rem;
        }

        .hj-filter-clear:hover {
            color: var(--color-primary);
        }

        .hj-result-meta {
            font-size: 0.875rem;
            color: #6c757d;
            margin-bottom: 1rem;
        }
    </style>
}

<!-- ═══ HERO — full width ═══ -->
<div class="hj-hero">
    <div class="hj-hero-kanji">学</div>
    <div class="container">
        <p class="hj-hero-eyebrow">講座 — Khóa học</p>
        <h1 class="hj-hero-title">Danh sách khóa học</h1>
        <p class="hj-hero-sub">
            @if (!hasMembership)
            {
                <text>Đăng ký membership để mở khoá toàn bộ nội dung N5 → N1.</text>
            }
            else if (recommendedLevelName != null)
            {
                <text>Trình độ gợi ý của bạn: <strong>@recommendedLevelName</strong> — nhưng bạn có thể học bất kỳ cấp độ nào.</text>
            }
            else
            {
                <text>Lựa chọn khoá học phù hợp với mục tiêu — học từ N5 đến N1.</text>
            }
        </p>
    </div>
</div>

<div class="container py-4" style="max-width: 1100px;">
    <!-- Filter / Sort / Search -->
    <form method="get" action="/learn/Course" class="hj-filter-bar">
        <div class="hj-filter-row">
            <div class="hj-filter-group" style="flex: 1 1 320px;">
                <label class="hj-filter-label" for="course-search">Tìm kiếm</label>
                <input id="course-search" name="q" type="search" class="hj-search-input"
                       placeholder="Tên hoặc mô tả khóa học..." value="@currentQuery" />
            </div>

            <div class="hj-filter-group" style="flex: 2 1 480px;">
                <span class="hj-filter-label">Cấp độ</span>
                <div class="hj-filter-options">
                    <a class="hj-filter-chip @(string.IsNullOrEmpty(currentLevel) ? "active" : "")"
                       href="@BuildUrl(resetLevel: true)">Tất cả</a>
                    @foreach (var lv in new[] { "N5", "N4", "N3", "N2", "N1" })
                    {
                        var active = string.Equals(currentLevel, lv, StringComparison.OrdinalIgnoreCase);
                        <a class="hj-filter-chip @(active ? "active" : "")"
                           href="@BuildUrl(level: lv)">@lv</a>
                    }
                </div>
            </div>

            <div class="hj-filter-group">
                <span class="hj-filter-label">Học phí</span>
                <div class="hj-filter-options">
                    <a class="hj-filter-chip @(string.IsNullOrEmpty(currentPrice) ? "active" : "")"
                       href="@BuildUrl(resetPrice: true)">Tất cả</a>
                    @if (hasMembership)
                    {
                        <a class="hj-filter-chip @(string.Equals(currentPrice, "paid", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                           href="@BuildUrl(price: "paid")">Trả phí</a>
                    }
                    <a class="hj-filter-chip @(string.Equals(currentPrice, "free", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                       href="@BuildUrl(price: "free")">Miễn phí</a>
                </div>
            </div>

            <div class="hj-filter-group">
                <label class="hj-filter-label" for="course-sort">Sắp xếp</label>
                <select id="course-sort" name="sort" class="hj-sort-select" onchange="this.form.submit()">
                    <option value="level" selected="@(currentSort == "level")">Theo cấp độ (N5 → N1)</option>
                    <option value="name" selected="@(currentSort == "name")">Tên A → Z</option>
                    <option value="name-desc" selected="@(currentSort == "name-desc")">Tên Z → A</option>
                </select>
            </div>

            @if (hasFilter)
            {
                <div class="hj-filter-group">
                    <span class="hj-filter-label">&nbsp;</span>
                    <a href="/learn/Course" class="hj-filter-clear">Xóa bộ lọc</a>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(currentLevel)) { <input type="hidden" name="level" value="@currentLevel" /> }
        @if (!string.IsNullOrEmpty(currentPrice)) { <input type="hidden" name="price" value="@currentPrice" /> }
        @if (!string.IsNullOrEmpty(currentQuery)) { <input type="hidden" name="q" value="@currentQuery" /> }
    </form>

    <p class="hj-result-meta">
        Tìm thấy <strong>@(Model?.Count() ?? 0)</strong> khóa học
        @if (hasFilter) { <span>phù hợp với bộ lọc</span> }
    </p>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4 justify-content-center">
            @foreach (var course in Model)
            {
                var levelClass = (course.Level?.LevelName ?? "n5").ToLower();
                var isEnrolled = enrolledIds.Contains(course.CourseId);
                var isAccessible = course.IsFree || hasMembership;

                <div class="col-md-4">
                    <div class="hj-course-card @(isAccessible ? "" : "hj-locked") fade-in">
                        <div class="hj-course-thumb">
                            <span class="hj-level-badge">@course.Level?.LevelName</span>
                            @if (!isAccessible)
                            {
                                <span class="hj-locked-badge">🔒 Membership</span>
                            }
                            @if (course.IsFree)
                            {
                                <span class="hj-free-badge">Miễn phí</span>
                            }
                            <span>@course.Level?.LevelName</span>
                        </div>
                        <div class="hj-course-body">
                            <h3 class="hj-course-title">@course.Title</h3>
                            <p class="hj-course-desc">
                                @(string.IsNullOrEmpty(course.Description)
                                    ? "Khóa học đang cập nhật mô tả."
                                    : course.Description)
                            </p>

                            <hr class="hj-divider" />

                            <div class="hj-mentor-row">
                                @if (!string.IsNullOrEmpty(course.Mentor?.AvatarUrl))
                                {
                                    <img src="@course.Mentor.AvatarUrl"
                                         class="hj-mentor-avt"
                                         alt="@course.Mentor.FullName" />
                                }
                                else
                                {
                                    <div class="hj-mentor-avt-fallback">
                                        @(course.Mentor?.FullName?.Substring(0, 1).ToUpper() ?? "?")
                                    </div>
                                }
                                <div>
                                    <div class="hj-mentor-name">@(course.Mentor?.FullName ?? "Đang cập nhật")</div>
                                    <div class="hj-mentor-exp">@(course.Mentor?.Expertise ?? "Giảng viên Hi Japan!")</div>
                                </div>
                            </div>

                            @if (isAccessible)
                            {
                                <a href="/learn/Course/Detail/@course.CourseId"
                                   class="btn-hj-course @(isEnrolled ? "enrolled" : "")">
                                    @(isEnrolled ? "Tiếp tục học" : "Vào học ngay")
                                </a>
                            }
                            else
                            {
                                <a href="/learn/Membership/Plans" class="btn-hj-course">
                                    Mở khoá membership
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!hasMembership)
        {
            <div class="text-center pt-2 pb-4">
                <p class="text-muted mb-3" style="font-size:14px;">
                    Đăng ký membership để mở khoá tất cả khoá học N5 → N1.
                </p>
                <a href="/learn/Membership/Plans"
                   class="btn-hj-course d-inline-block"
                   style="width:auto;padding:11px 32px;background:var(--color-primary);color:#fff;border-color:var(--color-primary);">
                    Xem gói học
                </a>
            </div>
        }
    }
    else
    {
        <div class="row">
            <div class="col-12 text-center text-muted py-5">
                <p class="mt-3">
                    @if (hasFilter)
                    {
                        <span>Không tìm thấy khóa học phù hợp với bộ lọc hiện tại.</span>
                    }
                    else
                    {
                        <span>Hiện chưa có khóa học nào. Vui lòng quay lại sau!</span>
                    }
                </p>
                @if (hasFilter)
                {
                    <a href="/learn/Course" class="btn-hj-course d-inline-block" style="width:auto; padding:0.5rem 1.5rem;">Xóa bộ lọc</a>
                }
            </div>
        </div>
    }
</div>