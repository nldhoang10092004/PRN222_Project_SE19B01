    }

        .hj-chatbot-input-bar input {
            min-width: 0;
            flex: 1;
            border: 1px solid var(--color-border, #e4e0db);
            border-radius: 999px;
            padding: 9px 16px;
            font-size: 13.5px;
            outline: none;
        }

            .hj-chatbot-input-bar input:focus {
                border-color: var(--color-primary, #c8102e);
                box-shadow: 0 0 0 3px rgba(200,16,46,.08);
            }

            .hj-chatbot-input-bar input:disabled {
                background: #f3f4f6;
            }

        .hj-chatbot-input-bar button {
