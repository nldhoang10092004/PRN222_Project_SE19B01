@model WebApplication1.Areas.Learner.Models.ReadingResultViewModel
@{
    ViewData["Title"] = "Kết quả - " + Model.Title;
    Layout = "~/Areas/Learner/Views/Shared/_LearnerLayout.cshtml";
}

<main class="hj-content">
    <div class="container py-5">

        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/learn/Practice">Luyện tập</a></li>
                <li class="breadcrumb-item"><a href="/learn/Practice/Reading">Luyện Đọc</a></li>
                <li class="breadcrumb-item active" aria-current="page">Kết quả</li>
            </ol>
        </nav>

        <h2 class="fw-bold mb-4" style="color:var(--color-navy);">Kết quả - @Model.Title</h2>

        <!-- Điểm số -->
        <div class="card border-0 shadow-sm mb-5">
            <div class="card-body p-5 text-center">
                <h3 class="fw-bold mb-3" style="color:var(--color-primary);">
                    @Model.ScorePercent.ToString("0.0")%
                </h3>
                <p class="mb-3">
                    <span class="badge bg-success" style="font-size:1.1rem;">
                        @Model.CorrectCount đúng
                    </span>
                    <span class="badge bg-danger ms-2" style="font-size:1.1rem;">
                        @(Model.TotalQuestions - Model.CorrectCount) sai
                    </span>
                </p>
                <p class="text-muted mb-0">
                    Bạn đã trả lời đúng @Model.CorrectCount/@Model.TotalQuestions câu hỏi
                </p>
            </div>
        </div>

        <!-- Chi tiết câu hỏi -->
        <h5 class="fw-bold mb-4" style="color:var(--color-navy);">Chi tiết câu hỏi</h5>

        @for (int i = 0; i < Model.Results.Count; i++)
        {
            var result = Model.Results[i];
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <p class="fw-semibold mb-0">
                            <span class="badge @(result.IsCorrect ? "bg-success" : "bg-danger") me-2">
                                Câu @(i + 1)
                            </span>
                            @result.QuestionText
                        </p>
                        @if (result.IsCorrect)
                        {
                            <span class="badge bg-success">✓ Đúng</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">✗ Sai</span>
                        }
                    </div>

                    <div class="mt-3">
                        <p class="mb-2">
                            <strong>Bạn đã chọn:</strong>
                            <span class="@(result.IsCorrect ? "text-success" : "text-danger")">
                                @result.SelectedAnswer
                            </span>
                        </p>
                        @if (!result.IsCorrect)
                        {
                            <p class="mb-0">
                                <strong>Đáp án đúng:</strong>
                                <span class="text-success">@result.CorrectAnswer</span>
                            </p>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="d-flex gap-3 mt-5">
            <a href="/learn/Practice/ReadingDetail/@Model.ExerciseId" class="btn btn-danger btn-lg">
                Làm lại
            </a>
            <a href="/learn/Practice/Reading" class="btn btn-light btn-lg">
                Quay lại danh sách
            </a>
        </div>

    </div>
</main>
