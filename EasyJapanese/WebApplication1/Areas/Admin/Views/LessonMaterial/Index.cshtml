@model IEnumerable<CoreLibrary.Data.Entities.LessonMaterial>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0 fw-bold">Quản lý Tài liệu Bài học</h3>
    <a href="/admin/lesson-materials/create" class="btn btn-danger">Thêm Tài liệu mới</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <form method="get" class="mb-4 d-flex gap-2">
            <input type="text" name="searchString" value="@ViewData["SearchString"]" class="form-control" placeholder="Tìm kiếm tên tài liệu..." style="max-width: 300px;">
            <input type="number" name="lessonId" value="@ViewData["LessonId"]" class="form-control" placeholder="ID Bài học..." style="max-width: 150px;">
            <button type="submit" class="btn btn-danger">Tìm kiếm</button>
            <a href="/admin/lesson-materials" class="btn btn-light">Xóa bộ lọc</a>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Tên Tài liệu</th>
                        <th>Bài học</th>
                        <th>Loại File</th>
                        <th>Thứ tự</th>
                        <th>Ngày tạo</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MaterialId</td>
                            <td>
                                <a href="@item.Url" target="_blank" class="text-decoration-none">
                                    @item.Title
                                </a>
                            </td>
                            <td>@item.Lesson.Title</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.FileType))
                                {
                                    <span class="badge bg-secondary">@item.FileType</span>
                                }
                            </td>
                            <td>@item.SortOrder</td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a href="/admin/lesson-materials/edit/@item.MaterialId" class="btn btn-sm btn-outline-primary">Sửa</a>
                                <form method="post" action="/admin/lesson-materials/delete/@item.MaterialId" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa tài liệu này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
