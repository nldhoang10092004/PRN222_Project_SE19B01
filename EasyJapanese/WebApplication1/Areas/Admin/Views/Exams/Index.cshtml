@model IEnumerable<CoreLibrary.Data.Entities.PlacementTest>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold">Quản lý Đề thi Đánh giá</h3>
        <p class="text-muted small mb-0">Thiết lập và quản lý các bài kiểm tra năng lực đầu vào của học viên.</p>
    </div>
    <button class="btn btn-jp-primary" data-bs-toggle="modal" data-bs-target="#createTestModal">
        <i class="bi bi-plus-lg me-1"></i> Tạo đề thi mới
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    @foreach (var test in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 jp-omni-card h-100 rounded-4">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge @(test.IsActive ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary") rounded-pill px-3 py-2 fw-semibold">
                            @(test.IsActive ? "Đang hoạt động" : "Tạm ẩn")
                        </span>
                        <div class="dropdown">
                            <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical fs-5"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm">
                                <li>
                                    <button class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#editTestModal-@test.TestId">
                                        <i class="bi bi-pencil me-2 text-muted"></i> Chỉnh sửa
                                    </button>
                                </li>
                                <li>
                                    <form asp-action="ToggleStatus" method="post" class="d-inline">
                                        <input type="hidden" name="testId" value="@test.TestId" />
                                        <button type="submit" class="dropdown-item py-2">
                                            <i class="bi @(test.IsActive ? "bi-eye-slash" : "bi-eye") me-2 text-muted"></i> @(test.IsActive ? "Tạm ẩn" : "Kích hoạt")
                                        </button>
                                    </form>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-action="Delete" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đề thi này và toàn bộ câu hỏi liên quan?');">
                                        <input type="hidden" name="testId" value="@test.TestId" />
                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                            <i class="bi bi-trash3 me-2"></i> Xóa đề thi
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-2">@test.Title</h5>
                    <p class="text-muted small flex-grow-1">@(string.IsNullOrEmpty(test.Description) ? "Chưa có mô tả cho đề thi này." : test.Description)</p>

                    <div class="border-top border-light pt-3 mt-3">
                        <div class="row g-2 text-center">
                            <div class="col-4 border-end">
                                <span class="d-block text-muted small">Thời gian</span>
                                <span class="fw-bold text-dark">@test.Duration phút</span>
                            </div>
                            <div class="col-4 border-end">
                                <span class="d-block text-muted small">Điểm đạt</span>
                                <span class="fw-bold text-dark">@test.PassScore đ</span>
                            </div>
                            <div class="col-4">
                                <span class="d-block text-muted small">Câu hỏi</span>
                                <span class="fw-bold text-dark">@(test.Questions?.Count ?? 0) câu</span>
                            </div>
                        </div>
                    </div>

                    <a href="/admin/exams/questions/@test.TestId" class="btn btn-jp-outline w-100 mt-4 text-decoration-none">
                        <i class="bi bi-gear-fill me-1"></i> Quản lý câu hỏi
                    </a>
                </div>
            </div>
        </div>

        <!-- Edit Modal -->
        <div class="modal fade" id="editTestModal-@test.TestId" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow-lg">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold">Chỉnh sửa đề thi</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form asp-action="Edit" method="post">
                        <input type="hidden" name="testId" value="@test.TestId" />
                        <div class="modal-body p-4">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Tiêu đề đề thi</label>
                                <input type="text" name="title" class="form-control rounded-3" value="@test.Title" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Mô tả ngắn</label>
                                <textarea name="description" class="form-control rounded-3" rows="3">@test.Description</textarea>
                            </div>
                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="form-label small fw-bold text-muted">Thời gian (phút)</label>
                                    <input type="number" name="duration" class="form-control rounded-3" value="@test.Duration" min="1" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-bold text-muted">Điểm chuẩn qua môn</label>
                                    <input type="number" name="passScore" class="form-control rounded-3" value="@test.PassScore" min="1" required />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-jp-primary rounded-3">Cập nhật</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="bi bi-journal-x fs-1 mb-3"></i>
            <h5>Chưa có đề thi đánh giá nào</h5>
            <p class="small">Hãy tạo đề thi đầu tiên bằng cách nhấn nút "Tạo đề thi mới" phía trên.</p>
        </div>
    }
</div>

<!-- Create Modal -->
<div class="modal fade" id="createTestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Tạo đề thi đánh giá mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Tiêu đề đề thi</label>
                        <input type="text" name="title" class="form-control rounded-3" placeholder="Ví dụ: Đề thi đánh giá trình độ N3 đầu vào" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Mô tả ngắn</label>
                        <textarea name="description" class="form-control rounded-3" placeholder="Nhập mô tả chi tiết đề thi hoặc lưu ý cho học viên..." rows="3"></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Thời gian (phút)</label>
                            <input type="number" name="duration" class="form-control rounded-3" value="45" min="1" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Điểm chuẩn qua môn</label>
                            <input type="number" name="passScore" class="form-control rounded-3" value="50" min="1" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-jp-primary rounded-3">Tạo đề thi</button>
                </div>
            </form>
        </div>
    </div>
</div>
