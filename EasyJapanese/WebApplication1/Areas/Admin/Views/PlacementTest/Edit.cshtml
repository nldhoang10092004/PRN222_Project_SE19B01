@model CoreLibrary.Data.Entities.PlacementTest
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">
    <h3 class="mb-0 fw-bold">Chỉnh sửa Bài test</h3>
    <p class="text-muted">Cập nhật thông tin bài test</p>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <form method="post" asp-action="Edit" asp-route-id="@Model.TestId">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.TestId)

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold">Tên bài test <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">Mô tả</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Duration" class="form-label fw-semibold">Thời gian làm bài (phút) <span class="text-danger">*</span></label>
                    <input asp-for="Duration" type="number" class="form-control" min="1" max="300" required />
                    <span asp-validation-for="Duration" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="PassScore" class="form-label fw-semibold">Điểm đạt <span class="text-danger">*</span></label>
                    <input asp-for="PassScore" type="number" class="form-control" min="0" max="100" required />
                    <span asp-validation-for="PassScore" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-4">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label">
                        Bài test đang hoạt động (học viên có thể làm bài)
                    </label>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Lưu thay đổi</button>
                <a href="/admin/placement-tests/manage-questions/@Model.TestId" class="btn btn-primary">Quản lý câu hỏi</a>
                <a href="/admin/placement-tests" class="btn btn-light">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
