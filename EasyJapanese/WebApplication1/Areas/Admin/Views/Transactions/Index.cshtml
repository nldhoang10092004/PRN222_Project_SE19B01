@model IEnumerable<CoreLibrary.Data.Entities.Transaction>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold">Danh sách Giao dịch</h3>
        <p class="text-muted small mb-0">Quản lý hóa đơn và lịch sử giao dịch thanh toán gói VIP của hệ thống.</p>
    </div>
</div>

<div class="card border-0 jp-omni-card rounded-4 p-4 mb-4">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label small fw-bold text-muted">Tìm kiếm</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 rounded-start-3 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="searchString" class="form-control bg-light border-start-0 rounded-end-3" placeholder="Tên học viên, email hoặc mã giao dịch..." value="@ViewData["SearchString"]">
            </div>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-bold text-muted">Trạng thái</label>
            <select name="statusFilter" class="form-select rounded-3">
                <option value="">Tất cả trạng thái</option>
                <option value="Paid" selected="@(ViewData["StatusFilter"]?.ToString() == "Paid" || ViewData["StatusFilter"]?.ToString() == "Completed")">Thành công</option>
                <option value="Pending" selected="@(ViewData["StatusFilter"]?.ToString() == "Pending")">Đang chờ</option>
                <option value="Failed" selected="@(ViewData["StatusFilter"]?.ToString() == "Failed")">Thất bại</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-jp-primary flex-grow-1 rounded-3">Lọc kết quả</button>
            <a href="/admin/transactions" class="btn btn-light rounded-3"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<div class="card border-0 jp-omni-card rounded-4 p-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4 text-muted fw-semibold small text-uppercase">Mã tham chiếu</th>
                    <th class="text-muted fw-semibold small text-uppercase">Học viên</th>
                    <th class="text-muted fw-semibold small text-uppercase">Gói hội viên</th>
                    <th class="text-muted fw-semibold small text-uppercase">Tổng thanh toán</th>
                    <th class="text-muted fw-semibold small text-uppercase">Thời gian</th>
                    <th class="text-muted fw-semibold small text-uppercase">Trạng thái</th>
                    <th class="pe-4 text-center text-muted fw-semibold small text-uppercase">Chi tiết</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tx in Model)
                {
                    <tr>
                        <td class="ps-4 font-monospace fw-bold text-dark">
                            @(string.IsNullOrEmpty(tx.PaymentRef) ? $"TX-{tx.TransactionId}" : tx.PaymentRef)
                        </td>
                        <td>
                            <div class="d-flex flex-column">
                                <span class="fw-bold">@tx.Student.FullName</span>
                                <span class="text-muted small">@tx.Student.StudentNavigation?.Email</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1 fw-bold">
                                @tx.Plan.PlanName
                            </span>
                        </td>
                        <td class="fw-extrabold text-dark">
                            @tx.FinalAmount.ToString("N0")đ
                        </td>
                        <td class="text-muted small">
                            @tx.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td>
                            @if (tx.PaymentStatus == "Paid" || tx.PaymentStatus == "Completed")
                            {
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 fw-bold">
                                    Thành công
                                </span>
                            }
                            else if (tx.PaymentStatus == "Pending")
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-1 fw-bold">
                                    Đang chờ
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1 fw-bold">
                                    Thất bại
                                </span>
                            }
                        </td>
                        <td class="pe-4 text-center">
                            <button class="btn btn-sm btn-jp-outline px-3 py-1" onclick="showTransactionDetail(@tx.TransactionId)">
                                <i class="bi bi-eye"></i> Xem
                            </button>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 mb-2 d-block"></i>
                             Không tìm thấy giao dịch nào phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Container for Details -->
<div class="modal fade" id="transactionDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg" id="transactionDetailContent">
            <!-- Loaded via AJAX -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showTransactionDetail(id) {
            fetch('/admin/transactions/details/' + id)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('transactionDetailContent').innerHTML = html;
                    var modal = new bootstrap.Modal(document.getElementById('transactionDetailModal'));
                    modal.show();
                });
        }
    </script>
}
