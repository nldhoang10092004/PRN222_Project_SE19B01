        color: #6b7280;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s, color .15s;
    }

        .hj-chatbot-tab i {
            margin-right: 5px;
        }

        .hj-chatbot-tab:hover {
