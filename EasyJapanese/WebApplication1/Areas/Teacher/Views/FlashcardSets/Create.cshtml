@model CoreLibrary.Data.Entities.FlashcardSet
@{
    Layout = "~/Areas/Teacher/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/teacher/flashcard-sets">Bộ Flashcards</a></li>
                <li class="breadcrumb-item active">Tạo mới</li>
            </ol>
        </nav>
        <h3 class="fw-bold">Tạo Bộ Flashcards Mới</h3>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form method="post" action="/teacher/flashcard-sets/create">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Tiêu đề bộ flashcards <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control" placeholder="Ví dụ: N5 Kanji - Bộ 1" required maxlength="200" />
                            <div class="form-text">Tên gọi của bộ flashcards (tối đa 200 ký tự)</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Mô tả</label>
                            <textarea name="Description" class="form-control" rows="4" placeholder="Mô tả ngắn về nội dung bộ flashcards này..."></textarea>
                            <div class="form-text">Giải thích ngắn gọn về bộ flashcards (không bắt buộc)</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Khóa học</label>
                            <select name="CourseId" class="form-select">
                                <option value="">Không gắn khóa học cụ thể</option>
                                @foreach (var course in ViewBag.Courses)
                                {
                                    <option value="@course.CourseId">@course.Title</option>
                                }
                            </select>
                            <div class="form-text">Chọn khóa học mà bộ flashcards này thuộc về (không bắt buộc)</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">URL hình ảnh thumbnail</label>
                            <input type="url" name="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                            <div class="form-text">Link ảnh đại diện cho bộ flashcards (không bắt buộc)</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-2"></i>Tạo bộ flashcards
                            </button>
                            <a href="/teacher/flashcard-sets" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-2"></i>Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Hướng dẫn</h6>
                    <ul class="small text-muted mb-0">
                        <li class="mb-2">Sau khi tạo bộ, bạn có thể thêm các flashcard vào bộ</li>
                        <li class="mb-2">Mỗi bộ có thể chứa nhiều flashcard với nội dung mặt trước/sau</li>
                        <li class="mb-2">Có thể import hàng loạt flashcard từ file Excel</li>
                        <li>Học viên sẽ thấy bộ flashcards trong khóa học tương ứng</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
