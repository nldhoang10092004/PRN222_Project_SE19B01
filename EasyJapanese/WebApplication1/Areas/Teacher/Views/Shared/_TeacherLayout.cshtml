@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Admin Dashboard CSS (Dùng chung) -->
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}

<div class="admin-dashboard-layout jp-bg-pattern">
    <!-- Sidebar -->
    <div class="admin-sidebar shadow-sm">
        <div class="p-4">
            <div class="mb-4">
                <h5 class="fw-bold mb-1" style="color: var(--color-primary);"><i class="bi bi-mortarboard-fill me-2"></i>Giảng viên</h5>
                <p class="text-muted small fw-semibold mb-0" style="letter-spacing: 0.5px;">EasyJapanese System</p>
            </div>
            
            <nav class="nav flex-column jp-sidebar-nav mt-3">
                    <a href="/Teacher/Dashboard" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill me-3"></i> Tổng quan
                    </a>
                    <a href="/Teacher/Courses" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Courses" ? "active" : "")">
                        <i class="bi bi-journal-code me-3"></i> Khóa học của tôi
                    </a>
                    <a href="/Teacher/Lessons" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Lessons" ? "active" : "")">
                        <i class="bi bi-play-btn-fill me-3"></i> Bài học (Video)
                    </a>
                    <a href="/Teacher/Flashcards" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Flashcards" ? "active" : "")">
                        <i class="bi bi-collection-fill me-3"></i> Bộ Flashcard
                    </a>
                    <a href="/Teacher/Quizzes" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Quizzes" ? "active" : "")">
                        <i class="bi bi-ui-checks me-3"></i> Bài tập (Quizzes)
                    </a>
                    <a href="/Teacher/Reviews" class="nav-link jp-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reviews" ? "active" : "")">
                        <i class="bi bi-star-fill me-3"></i> Đánh giá học viên
                    </a>
                </nav>
            </div>
        </div>

        <!-- Main Content -->
        <div class="admin-main-content">
            @RenderBody()
        </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
