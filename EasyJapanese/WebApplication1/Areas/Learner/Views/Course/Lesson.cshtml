@model CoreWeb.Areas.Learner.Models.LessonViewModel

@{
    ViewData["Title"] = Model.LessonTitle + " - Hi Japan!";
}

@section Styles {
    @await Html.PartialAsync("_LessonStyle")
}

<div class="lesson-shell">

    <!-- ═══════════════════════════════════════
         SIDEBAR
    ═══════════════════════════════════════ -->
    <aside class="lesson-sidebar" id="lessonSidebar">
        <div class="sidebar-toggle" id="sidebarToggle">
            <span class="sidebar-toggle-label">Nội dung bài học</span>
            <div class="sidebar-toggle-icon">
                <i class="bi bi-layout-sidebar-reverse" id="toggleIcon"></i>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="sidebar-section-label">Bài giảng</div>

            <div class="sidebar-nav-item active" data-panel="panel-summary">
                <span class="sidebar-nav-icon">
                    <i class="bi bi-file-text"></i>
                </span>
                <span class="sidebar-nav-label">Tóm tắt</span>
            </div>

            @if (Model.VocabularyItems.Any())
            {
                <div class="sidebar-nav-item" data-panel="panel-vocab">
                    <span class="sidebar-nav-icon">
                        <i class="bi bi-card-text"></i>
                    </span>
                    <span class="sidebar-nav-label">Từ vựng</span>
                    <span class="sidebar-count">@Model.VocabularyItems.Count</span>
                </div>
            }

            @if (Model.KanjiItems.Any())
            {
                <div class="sidebar-nav-item" data-panel="panel-kanji">
                    <span class="sidebar-nav-icon">
                        <i class="bi bi-translate"></i>
                    </span>
                    <span class="sidebar-nav-label">Kanji</span>
                    <span class="sidebar-count">@Model.KanjiItems.Count</span>
                </div>
            }

            @if (Model.GrammarItems.Any() ||
                        Model.ReadingItems.Any() ||
                        Model.ListeningItems.Any())
            {
                <div class="sidebar-section-label" style="margin-top:8px;">
                    Luyện tập
                </div>
            }

            @if (Model.GrammarItems.Any())
            {
                <div class="sidebar-nav-item" data-panel="panel-grammar">
                    <span class="sidebar-nav-icon">
                        <i class="bi bi-journal-text"></i>
                    </span>
                    <span class="sidebar-nav-label">Ngữ pháp</span>
                    <span class="sidebar-count">@Model.GrammarItems.Count</span>
                </div>
            }

            @if (Model.ReadingItems.Any())
            {
                <div class="sidebar-nav-item" data-panel="panel-reading">
                    <span class="sidebar-nav-icon">
                        <i class="bi bi-book"></i>
                    </span>
                    <span class="sidebar-nav-label">Đọc hiểu</span>
                    <span class="sidebar-count">@Model.ReadingItems.Count</span>
                </div>
            }

            @if (Model.ListeningItems.Any())
            {
                <div class="sidebar-nav-item" data-panel="panel-listening">
                    <span class="sidebar-nav-icon">
                        <i class="bi bi-headphones"></i>
                    </span>
                    <span class="sidebar-nav-label">Luyện nghe</span>
                    <span class="sidebar-count">@Model.ListeningItems.Count</span>
                </div>
            }
        </nav>
    </aside>

    <!-- ═══════════════════════════════════════
         MAIN
    ═══════════════════════════════════════ -->
    <main class="lesson-main">

        <a href="/learn/Course/Detail/@Model.CourseId" class="lesson-back">
            <i class="bi bi-arrow-left"></i>
            @Model.CourseTitle
        </a>

        <div class="lesson-header">
            <div>
                <span class="lesson-level">
                    @Model.LevelName
                </span>

                <h1 class="lesson-title">@Model.LessonTitle</h1>
            </div>

            <div class="lesson-header-actions">
                <button type="button"
                        id="btnCompleteLesson"
                        class="btn-complete-lesson @(Model.IsCompleted ? "completed" : "")"
                        data-lesson-id="@Model.LessonId"
                        @(Model.IsCompleted ? "disabled" : "")>
                    <i class="bi bi-@(Model.IsCompleted ? "check-circle-fill" : "check-circle")"></i>
                    <span class="btn-complete-label">@(Model.IsCompleted ? "Đã hoàn thành" : "Đánh dấu hoàn thành")</span>
                </button>

                <!-- Quiz này là quiz cả Course -->
                <a asp-area="Learner"
                   asp-controller="Quiz"
                   asp-action="Start"
                   asp-route-courseId="@Model.CourseId"
                   class="btn-quiz">
                    Làm Quiz cuối khóa
                    <i class="bi bi-patch-check"></i>
                </a>
            </div>
        </div>

        <!-- ═══ VIDEO ═══ -->
        <div class="lesson-video-wrap">
            @if (!string.IsNullOrEmpty(Model.VideoUrl))
            {
                <iframe src="@Model.VideoUrl"
                        allowfullscreen>
                </iframe>
            }
            else
            {
                <div class="lesson-video-placeholder">
                    <div class="play-btn">
                        <i class="bi bi-play-fill"></i>
                    </div>

                    <p>
                        Video bài giảng đang được cập nhật
                    </p>
                </div>
            }
        </div>

        <!-- ═══════════════════════════════════════
             PANEL: SUMMARY
        ═══════════════════════════════════════ -->
        <div id="panel-summary" class="lesson-panel active">
            <div class="panel-title">
                <i class="bi bi-file-text"></i>
                Tóm tắt bài học
            </div>

            @if (!string.IsNullOrEmpty(Model.Content))
            {
                <div class="lesson-content">
                    @Html.Raw(Model.Content.Replace("\n", "<br/>"))
                </div>
            }
            else
            {
                <div class="panel-empty">
                    <i class="bi bi-file-earmark-text"></i>
                    Nội dung bài học đang được cập nhật.
                </div>
            }
        </div>

        <!-- ═══════════════════════════════════════
             PANEL: VOCABULARY
        ═══════════════════════════════════════ -->
        @if (Model.VocabularyItems.Any())
        {
            <div id="panel-vocab" class="lesson-panel">
                <div class="panel-title">
                    <i class="bi bi-card-text"></i>
                    Từ vựng
                </div>

                @foreach (var item in Model.VocabularyItems)
                {
                    <div class="exercise-block">

                        <div class="exercise-block-header">
                            <div>
                                <div class="vocab-title">@item.Title</div>

                                @if (!string.IsNullOrEmpty(item.Content))
                                {
                                    <div class="vocab-content">
                                        @item.Content
                                    </div>
                                }
                            </div>

                            <button type="button"
                                    class="btn-practice"
                                    data-exercise-id="@item.ExerciseId"
                                    data-exercise-title="@item.Title">
                                <i class="bi bi-pencil-square"></i>
                                Luyện tập
                            </button>
                        </div>

                        <div id="practice-@item.ExerciseId"
                             class="practice-area">
                        </div>

                    </div>
                }
            </div>
        }

        <!-- ═══════════════════════════════════════
             PANEL: KANJI
        ═══════════════════════════════════════ -->
        @if (Model.KanjiItems.Any())
        {
            <div id="panel-kanji" class="lesson-panel">
                <div class="panel-title">
                    <i class="bi bi-translate"></i>
                    Kanji trong bài
                </div>

                <div class="kanji-grid">
                    @foreach (var item in Model.KanjiItems)
                    {
                        <div class="kanji-card">

                            <div class="kanji-char">
                                @item.Title
                            </div>

                            @if (!string.IsNullOrEmpty(item.Content))
                            {
                                <div class="kanji-meta">
                                    @item.Content
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(item.StrokeOrderUrl))
                            {
                                <div class="kanji-stroke-section">
                                    <div class="kanji-stroke-label">Thứ tự nét viết:</div>
                                    <img src="@item.StrokeOrderUrl"
                                         alt="Stroke order - @item.Title"
                                         class="kanji-stroke-gif" />
                                </div>
                            }

                            <button type="button"
                                    class="btn-practice kanji-practice"
                                    data-exercise-id="@item.ExerciseId"
                                    data-exercise-title="@item.Title">
                                <i class="bi bi-pencil-square"></i>
                                Luyện tập
                            </button>

                            <div id="practice-@item.ExerciseId"
                                 class="practice-area">
                            </div>

                        </div>
                    }
                </div>
            </div>
        }

        <!-- ═══════════════════════════════════════
             PANEL: GRAMMAR
        ═══════════════════════════════════════ -->
        @if (Model.GrammarItems.Any())
        {
            <div id="panel-grammar" class="lesson-panel">
                <div class="panel-title">
                    <i class="bi bi-journal-text"></i>
                    Ngữ pháp
                </div>

                @{
                    int grammarIndex = 1;
                }

                @foreach (var item in Model.GrammarItems)
                {
                    <div class="grammar-item">

                        <div class="grammar-title">
                            @grammarIndex. @item.Title
                        </div>

                        @if (!string.IsNullOrEmpty(item.Content))
                        {
                            <div class="grammar-content">
                                @Html.Raw(item.Content.Replace("\n", "<br/>"))
                            </div>
                        }

                        <button type="button"
                                class="btn-practice"
                                data-exercise-id="@item.ExerciseId"
                                data-exercise-title="@item.Title">
                            <i class="bi bi-pencil-square"></i>
                            Luyện tập ngữ pháp
                        </button>

                        <div id="practice-@item.ExerciseId"
                             class="practice-area">
                        </div>

                    </div>

                    grammarIndex++;
                }
            </div>
        }

        <!-- ═══════════════════════════════════════
             PANEL: READING
        ═══════════════════════════════════════ -->
        @if (Model.ReadingItems.Any())
        {
            <div id="panel-reading" class="lesson-panel">
                <div class="panel-title">
                    <i class="bi bi-book"></i>
                    Đọc hiểu
                </div>

                @foreach (var item in Model.ReadingItems)
                {
                    <div class="reading-item">

                        <div class="reading-title">
                            @item.Title
                        </div>

                        @if (!string.IsNullOrEmpty(item.Content))
                        {
                            <div class="reading-passage">
                                @Html.Raw(item.Content.Replace("\n", "<br/>"))
                            </div>
                        }

                        <button type="button"
                                class="btn-practice"
                                data-exercise-id="@item.ExerciseId"
                                data-exercise-title="@item.Title">
                            <i class="bi bi-pencil-square"></i>
                            Làm bài đọc hiểu
                        </button>

                        <div id="practice-@item.ExerciseId"
                             class="practice-area">
                        </div>

                    </div>
                }
            </div>
        }

        <!-- ═══════════════════════════════════════
             PANEL: LISTENING
        ═══════════════════════════════════════ -->
        @if (Model.ListeningItems.Any())
        {
            <div id="panel-listening" class="lesson-panel">
                <div class="panel-title">
                    <i class="bi bi-headphones"></i>
                    Luyện nghe
                </div>

                @foreach (var item in Model.ListeningItems)
                {
                    <div class="audio-card">

                        <button class="audio-play-btn"
                                type="button"
                                @(string.IsNullOrEmpty(item.AudioUrl) ? "disabled" : "")
                                data-audio="@(item.AudioUrl ?? "")"
                                title="@(string.IsNullOrEmpty(item.AudioUrl) ? "Audio đang cập nhật" : "Phát audio")">
                            <i class="bi bi-play-fill"></i>
                        </button>

                        <div class="audio-info">
                            <div class="audio-title">@item.Title</div>

                            @if (!string.IsNullOrEmpty(item.Content))
                            {
                                <div class="audio-content">
                                    @item.Content
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(item.AudioUrl))
                            {
                                <div class="audio-progress">
                                    <div class="audio-progress-fill"></div>
                                </div>
                            }
                            else
                            {
                                <div class="audio-content">
                                    Audio đang được cập nhật
                                </div>
                            }

                            <button type="button"
                                    class="btn-practice"
                                    data-exercise-id="@item.ExerciseId"
                                    data-exercise-title="@item.Title">
                                <i class="bi bi-pencil-square"></i>
                                Làm bài nghe
                            </button>

                            <div id="practice-@item.ExerciseId"
                                 class="practice-area">
                            </div>
                        </div>

                    </div>
                }
            </div>
        }

    </main>
</div>

@section Scripts {
    @await Html.PartialAsync("_LessonScript")
}