@model WebApplication1.Areas.Learner.Controllers.ListeningDetailViewModel
@{
    ViewData["Title"] = $"{Model.Title} - Luyện Nghe Tiếng Nhật";
}

<div class="container-fluid px-4 px-lg-5 py-4" style="max-width: 1400px; margin: 0 auto;">
    <!-- Navigation Back & Header -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <a href="/learn/Practice/Listening" class="btn btn-sm btn-light border rounded-pill px-3 py-2 fw-semibold text-secondary shadow-sm transition-all hover-red">
            <i class="bi bi-arrow-left me-1"></i> Quay lại Trung tâm Luyện Nghe
        </a>
        @if (Model.BestScore.HasValue)
        {
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-bold fs-6">
                <i class="bi bi-trophy-fill me-1 text-warning"></i> Kết quả tốt nhất: @Model.BestScore%
            </span>
        }
    </div>

    <!-- Header Card -->
    <div class="card border-0 rounded-4 shadow-sm mb-4 bg-white">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-danger text-white rounded-pill px-3 py-1 fw-bold">
                    JLPT @Model.LevelName
                </span>
                <span class="badge bg-light text-secondary rounded-pill px-3 py-1 font-monospace">
                    <i class="bi bi-headphones me-1 text-danger"></i> LISTENING EXERCISE
                </span>
            </div>
            <h1 class="fw-extrabold text-dark fs-3 mb-2">@Model.Title</h1>
            @if (!string.IsNullOrEmpty(Model.CourseTitle))
            {
                <div class="text-muted small">
                    <i class="bi bi-journal-text me-1 text-danger"></i> @Model.CourseTitle
                    @if (!string.IsNullOrEmpty(Model.LessonTitle))
                    {
                        <span> • @Model.LessonTitle</span>
                    }
                </div>
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Panel: Audio Control Suite & Questions -->
        <div class="col-lg-8">
            <!-- Audio Suite Card -->
            <div class="card border-0 rounded-4 shadow-lg mb-4 overflow-hidden" style="background: #0f172a; border: 1px solid #1e293b;">
                <div class="card-body p-4 text-white">
                    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="bg-danger bg-opacity-20 p-2 rounded-circle text-danger d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                <i class="bi bi-disc-fill fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold small text-uppercase tracking-wider text-white">AUDIO PLAYER</div>
                                <div class="text-white-50" style="font-size: 11px;">Trình phát âm thanh chất lượng cao</div>
                            </div>
                        </div>

                        <!-- Speed selector -->
                        <div class="d-flex align-items-center gap-2">
                            <span class="small text-white-50">Tốc độ:</span>
                            <select id="playbackSpeed" class="form-select form-select-sm bg-dark text-white border-secondary rounded-pill px-3" style="width: auto;">
                                <option value="0.8">0.8x (Chậm)</option>
                                <option value="1.0" selected>1.0x (Chuẩn)</option>
                                <option value="1.2">1.2x (Nhanh)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="audio-progress-container mb-3" id="audioProgressContainer">
                        <div class="audio-progress-bar" id="audioProgressBar"></div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div class="small text-white-50 font-monospace fs-6">
                            <span id="currentTime" class="text-white fw-bold">00:00</span> / <span id="totalDuration">00:00</span>
                        </div>

                        <div class="d-flex align-items-center gap-3">
                            <button id="btnRewind" type="button" class="btn btn-outline-light btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;" title="Lùi lại 5 giây">
                                <i class="bi bi-arrow-counterclockwise fs-5"></i>
                            </button>
                            <button id="btnPlayPause" type="button" class="btn btn-danger rounded-circle shadow-lg d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;" title="Phát / Tạm dừng">
                                <i class="bi bi-play-fill fs-2 ms-0.5" id="playIcon"></i>
                            </button>
                        </div>

                        <div>
                            @if (!string.IsNullOrEmpty(Model.Content))
                            {
                                <button id="btnToggleTranscript" type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1.5 fw-semibold">
                                    <i class="bi bi-file-text me-1"></i> <span id="transcriptBtnText">Xem kịch bản</span>
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Transcript Box -->
                    @if (!string.IsNullOrEmpty(Model.Content))
                    {
                        <div id="transcriptBox" class="mt-4 p-3.5 rounded-3 bg-dark text-white-50 border border-secondary d-none">
                            <div class="fw-bold text-white mb-2 small d-flex align-items-center gap-2">
                                <i class="bi bi-chat-quote text-danger fs-5"></i> Kịch bản bài nghe (Transcript):
                            </div>
                            <div class="small lh-lg text-light font-jp">
                                @Html.Raw(Model.Content.Replace("\n", "<br/>"))
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Questions Form Card -->
            <div class="card border-0 rounded-4 shadow-sm bg-white">
                <div class="card-header bg-white border-bottom pt-4 px-4 pb-3 d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-pencil-square text-danger"></i> Câu Hỏi Luyện Nghe
                    </h5>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 fw-bold">
                        @Model.Questions.Count câu hỏi
                    </span>
                </div>

                <div class="card-body p-4">
                    @if (Model.Questions.Any())
                    {
                        <form id="listeningForm">
                            @for (int i = 0; i < Model.Questions.Count; i++)
                            {
                                var q = Model.Questions[i];
                                <div class="question-block mb-4 p-4 rounded-4 bg-light-subtle border" data-question-id="@q.QuestionId">
                                    <div class="fw-bold text-dark mb-3 d-flex align-items-start gap-2">
                                        <span class="badge bg-danger text-white rounded-circle p-2 d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 28px; height: 28px; font-size: 13px;">
                                            @(i + 1)
                                        </span>
                                        <span class="fs-6 text-dark mt-0.5 font-jp">@q.QuestionText</span>
                                    </div>

                                    <div class="options-group d-flex flex-column gap-2 ms-md-4">
                                        @foreach (var opt in q.Options)
                                        {
                                            <label class="option-item p-3 rounded-3 border bg-white cursor-pointer transition-all d-flex align-items-center gap-3">
                                                <input type="radio" name="q_@q.QuestionId" value="@opt.OptionId" class="form-check-input mt-0" />
                                                <span class="text-dark small fw-medium font-jp">@opt.AnswerText</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="d-grid mt-4">
                                <button id="btnSubmitListening" type="button" class="btn btn-danger btn-lg rounded-pill fw-bold shadow-sm py-3" style="background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);">
                                    <i class="bi bi-check2-circle me-1"></i> Nộp Bài Luyện Nghe
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-info-circle fs-2 d-block mb-2 text-danger opacity-50"></i>
                            Bài tập nghe này chưa có câu hỏi đính kèm.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Panel: Rules & Attempt Results -->
        <div class="col-lg-4">
            <div class="card border-0 rounded-4 shadow-sm bg-white sticky-top" style="top: 80px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-lightbulb-fill text-warning"></i> Hướng Dẫn Luyện Nghe
                    </h6>
                    <ul class="text-secondary small ps-3 mb-4 space-y-2 lh-lg">
                        <li>Nghe thật kỹ đoạn hội thoại audio trước khi trả lời.</li>
                        <li>Có thể tua lại 5s hoặc giảm tốc độ nghe xuống <strong>0.8x</strong> nếu quá nhanh.</li>
                        <li>Nộp bài để xem điểm số thực tế và lưu lịch sử vào hệ thống.</li>
                        <li>Sau khi nộp bài, bạn có thể bấm <strong>"Xem kịch bản"</strong> để kiểm tra từ vựng.</li>
                    </ul>

                    <div id="resultCard" class="d-none alert alert-success rounded-4 border-0 p-4 text-center shadow-sm">
                        <i class="bi bi-trophy-fill text-warning display-5 d-block mb-2"></i>
                        <h6 class="fw-bold mb-1">Kết Quả Bài Làm</h6>
                        <div class="fs-2 fw-extrabold text-success mb-1" id="scoreText">0/0</div>
                        <div class="small text-muted mb-3" id="percentText">Đạt 0%</div>
                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-4 py-2 fw-bold" onclick="location.reload();">
                            <i class="bi bi-arrow-repeat me-1"></i> Làm lại bài nghe
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .audio-progress-container {
        height: 8px;
        background: rgba(255,255,255,0.15);
        border-radius: 4px;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }
    .audio-progress-bar {
        height: 100%;
        width: 0%;
        background: #dc2626;
        border-radius: 4px;
        transition: width 0.1s linear;
    }
    .hover-red:hover {
        border-color: #fca5a5 !important;
        color: #dc2626 !important;
        background: #fef2f2 !important;
    }
    .option-item {
        border-color: #e2e8f0 !important;
        transition: all .15s ease;
    }
    .option-item:hover {
        border-color: #dc2626 !important;
        background-color: #fef2f2 !important;
    }
    .option-item.correct {
        border-color: #16a34a !important;
        background-color: #f0fdf4 !important;
        color: #16a34a !important;
        font-weight: bold;
    }
    .option-item.incorrect {
        border-color: #dc2626 !important;
        background-color: #fef2f2 !important;
        color: #dc2626 !important;
    }
</style>

@section Scripts {
    <script>
        (function() {
            const audioUrl = "@Model.AudioUrl";
            const textContent = "@Html.Raw(Model.Content ?? Model.Title)";
            const exerciseId = @Model.ExerciseId;

            const btnPlayPause = document.getElementById('btnPlayPause');
            const playIcon = document.getElementById('playIcon');
            const btnRewind = document.getElementById('btnRewind');
            const playbackSpeed = document.getElementById('playbackSpeed');
            const audioProgressContainer = document.getElementById('audioProgressContainer');
            const audioProgressBar = document.getElementById('audioProgressBar');
            const currentTimeEl = document.getElementById('currentTime');
            const totalDurationEl = document.getElementById('totalDuration');
            const btnToggleTranscript = document.getElementById('btnToggleTranscript');
            const transcriptBox = document.getElementById('transcriptBox');
            const btnSubmitListening = document.getElementById('btnSubmitListening');

            let audio = null;
            let isSpeech = false;
            let speechUtterance = null;

            function formatTime(sec) {
                if (isNaN(sec) || !isFinite(sec)) return "00:00";
                const m = Math.floor(sec / 60);
                const s = Math.floor(sec % 60);
                return (m < 10 ? "0" + m : m) + ":" + (s < 10 ? "0" + s : s);
            }

            if (audioUrl && audioUrl.trim() !== '') {
                audio = new Audio(audioUrl);
                audio.addEventListener('loadedmetadata', function() {
                    totalDurationEl.textContent = formatTime(audio.duration);
                });
                audio.addEventListener('timeupdate', function() {
                    if (audio.duration) {
                        const pct = (audio.currentTime / audio.duration) * 100;
                        audioProgressBar.style.width = pct + '%';
                        currentTimeEl.textContent = formatTime(audio.currentTime);
                    }
                });
                audio.addEventListener('ended', function() {
                    playIcon.className = 'bi bi-play-fill fs-2 ms-0.5';
                });
            } else {
                isSpeech = true;
                totalDurationEl.textContent = "TTS";
            }

            btnPlayPause.addEventListener('click', function() {
                if (!isSpeech && audio) {
                    if (audio.paused) {
                        audio.playbackRate = parseFloat(playbackSpeed.value);
                        audio.play().then(() => {
                            playIcon.className = 'bi bi-pause-fill fs-2';
                        }).catch(() => {
                            speakText();
                        });
                    } else {
                        audio.pause();
                        playIcon.className = 'bi bi-play-fill fs-2 ms-0.5';
                    }
                } else {
                    speakText();
                }
            });

            function speakText() {
                if ('speechSynthesis' in window) {
                    if (window.speechSynthesis.speaking) {
                        window.speechSynthesis.cancel();
                        playIcon.className = 'bi bi-play-fill fs-2 ms-0.5';
                        return;
                    }
                    const cleanText = textContent.replace(/<[^>]*>?/gm, '');
                    speechUtterance = new SpeechSynthesisUtterance(cleanText);
                    speechUtterance.lang = 'ja-JP';
                    speechUtterance.rate = parseFloat(playbackSpeed.value);
                    speechUtterance.onend = function() {
                        playIcon.className = 'bi bi-play-fill fs-2 ms-0.5';
                    };
                    window.speechSynthesis.speak(speechUtterance);
                    playIcon.className = 'bi bi-pause-fill fs-2';
                }
            }

            btnRewind.addEventListener('click', function() {
                if (!isSpeech && audio) {
                    audio.currentTime = Math.max(0, audio.currentTime - 5);
                }
            });

            playbackSpeed.addEventListener('change', function() {
                if (!isSpeech && audio) {
                    audio.playbackRate = parseFloat(this.value);
                }
            });

            if (audioProgressContainer) {
                audioProgressContainer.addEventListener('click', function(e) {
                    if (!isSpeech && audio && audio.duration) {
                        const rect = this.getBoundingClientRect();
                        const pos = (e.clientX - rect.left) / rect.width;
                        audio.currentTime = pos * audio.duration;
                    }
                });
            }

            if (btnToggleTranscript && transcriptBox) {
                btnToggleTranscript.addEventListener('click', function() {
                    const isHidden = transcriptBox.classList.contains('d-none');
                    if (isHidden) {
                        transcriptBox.classList.remove('d-none');
                        document.getElementById('transcriptBtnText').textContent = 'Ẩn kịch bản';
                    } else {
                        transcriptBox.classList.add('d-none');
                        document.getElementById('transcriptBtnText').textContent = 'Xem kịch bản';
                    }
                });
            }

            if (btnSubmitListening) {
                btnSubmitListening.addEventListener('click', function() {
                    const questionBlocks = document.querySelectorAll('.question-block');
                    if (questionBlocks.length === 0) return;

                    let correctCount = 0;
                    const answers = [];

                    questionBlocks.forEach(block => {
                        const qId = block.getAttribute('data-question-id');
                        const selectedOption = block.querySelector(`input[name="q_${qId}"]:checked`);
                        const optVal = selectedOption ? parseInt(selectedOption.value) : 0;

                        answers.push({
                            questionId: parseInt(qId),
                            selectedOptionId: optVal
                        });
                    });

                    fetch('/learn/Practice/SubmitListening', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            exerciseId: exerciseId,
                            answers: answers
                        })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            btnSubmitListening.disabled = true;
                            btnSubmitListening.innerHTML = '<i class="bi bi-check-all me-1"></i> Đã Chấm Điểm';

                            if (data.details) {
                                data.details.forEach(detail => {
                                    const block = document.querySelector(`.question-block[data-question-id="${detail.questionId}"]`);
                                    if (block) {
                                        const options = block.querySelectorAll('.option-item');
                                        options.forEach(opt => {
                                            const radio = opt.querySelector('input[type="radio"]');
                                            const optId = parseInt(radio.value);

                                            if (optId === detail.correctOptionId) {
                                                opt.classList.add('correct');
                                                opt.innerHTML += ' <span class="badge bg-success ms-auto"><i class="bi bi-check-lg me-1"></i>Đáp án đúng</span>';
                                            } else if (optId === detail.userOptionId && !detail.isCorrect) {
                                                opt.classList.add('incorrect');
                                                opt.innerHTML += ' <span class="badge bg-danger ms-auto"><i class="bi bi-x-lg me-1"></i>Bạn chọn sai</span>';
                                            }
                                        });
                                    }
                                });
                            }

                            const resultCard = document.getElementById('resultCard');
                            document.getElementById('scoreText').textContent = `${data.correctAnswers}/${data.totalQuestions} câu`;
                            document.getElementById('percentText').textContent = `Đạt ${data.score}%`;
                            resultCard.classList.remove('d-none');
                            resultCard.scrollIntoView({ behavior: 'smooth' });
                        }
                    })
                    .catch(err => {
                        console.error("Lỗi nộp bài nghe:", err);
                    });
                });
            }
        })();
    </script>
}
