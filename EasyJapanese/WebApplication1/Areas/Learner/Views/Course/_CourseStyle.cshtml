<style>
    /* ── TOKENS (khớp với style.css chung) ── */
    :root {
        --color-primary: #C8102E;
        --color-navy: #1a2744;
        --color-navy-light: #eef0f6;
        --color-bg: #f7f5f2;
        --color-border: #e4e0db;
        --color-text: #1a1a1a;
        --shadow-sm: 0 1px 4px rgba(0,0,0,.06);
        --shadow-md: 0 4px 16px rgba(0,0,0,.08);
        --radius-full: 9999px;
    }

    /* ── HERO BANNER ── */
    .hj-hero {
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-navy) 100%);
        padding: 44px 0 48px;
        position: relative;
        overflow: hidden;
        margin-bottom: 36px;
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
    }

        .hj-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            opacity: .10;
            background-image: radial-gradient(circle at 0 60px, transparent 22px, #fff 23px, #fff 24px, transparent 25px), radial-gradient(circle at 50px 60px, transparent 22px, #fff 23px, #fff 24px, transparent 25px), radial-gradient(circle at 100px 60px, transparent 22px, #fff 23px, #fff 24px, transparent 25px);
            background-size: 100px 60px;
            pointer-events: none;
        }

    .hj-hero-kanji {
        position: absolute;
        right: 40px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 130px;
        font-weight: 800;
        color: rgba(255,255,255,.08);
        line-height: 1;
        pointer-events: none;
        user-select: none;
        font-family: 'Outfit', serif;
    }

    .hj-hero-eyebrow {
        font-size: 12px;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: rgba(255,255,255,.6);
        margin-bottom: 8px;
    }

    .hj-hero-title {
        font-family: 'Outfit', sans-serif;
        font-size: 32px;
        font-weight: 800;
        color: #fff;
        margin-bottom: 8px;
    }

    .hj-hero-sub {
        font-size: 15px;
        color: rgba(255,255,255,.85);
        max-width: 520px;
        line-height: 1.6;
        margin: 0;
    }

    /* thêm vào _CourseStyle.cshtml */
    .hj-course-list-section {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        background: var(--color-bg);
        padding: 8px 0 56px;
    }

    .hj-level-group {
        margin-bottom: 40px;
    }

    .hj-level-group-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .hj-level-group-badge {
        background: var(--color-primary);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        padding: 3px 12px;
        border-radius: var(--radius-full);
    }

    .hj-level-group-title {
        font-family: 'Outfit',sans-serif;
        font-weight: 800;
        font-size: 20px;
        color: var(--color-navy);
    }

    .hj-level-group-line {
        flex: 1;
        height: 1px;
        background: var(--color-border);
    }

    .hj-course-card.hj-locked {
        opacity: .85;
    }

    .hj-locked-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: var(--color-navy);
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 11px;
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* ── COURSE CARD ── */
    .hj-course-card {
        background: #fff;
        border: 1px solid var(--color-border);
        border-radius: 18px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        box-shadow: var(--shadow-sm);
        transition: transform .2s, box-shadow .2s;
    }

        .hj-course-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }

    /* Thumbnail placeholder (gradient đỏ-navy, chữ kanji) */
    .hj-course-thumb {
        height: 180px;
        background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-primary) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 52px;
        font-weight: 800;
        color: rgba(255,255,255,.45);
        font-family: 'Outfit', serif;
        position: relative;
        flex-shrink: 0;
    }

    /* Badge level (N5/N4/N3…) — top-left */
    .hj-level-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(255,255,255,.95);
        color: var(--color-navy);
        font-size: 11.5px;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: var(--radius-full);
        letter-spacing: .03em;
    }

    /* Badge "Miễn phí" — top-right */
    .hj-free-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: #198754;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 11px;
        border-radius: var(--radius-full);
    }

    /* Card body */
    .hj-course-body {
        padding: 20px 20px 22px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .hj-course-title {
        font-family: 'Outfit', sans-serif;
        font-size: 17px;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: 8px;
        line-height: 1.35;
    }

    .hj-course-desc {
        font-size: 13.5px;
        color: #6b7280;
        line-height: 1.65;
        flex-grow: 1;
        margin-bottom: 16px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Divider giống gốc nhưng màu brand */
    .hj-divider {
        border: none;
        border-top: 1px dashed var(--color-border);
        margin: 14px 0;
    }

    /* Mentor row */
    .hj-mentor-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
    }

    .hj-mentor-avt {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        border: 1.5px solid var(--color-border);
        flex-shrink: 0;
    }

    .hj-mentor-avt-fallback {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--color-navy-light);
        color: var(--color-navy);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
        flex-shrink: 0;
    }

    .hj-mentor-name {
        font-size: 13px;
        font-weight: 600;
        color: var(--color-text);
        line-height: 1.3;
    }

    .hj-mentor-exp {
        font-size: 11.5px;
        color: #9ca3af;
        margin-top: 1px;
    }

    /* CTA button — đỏ outline, hover fill */
    .btn-hj-course {
        display: block;
        width: 100%;
        padding: 10px 16px;
        border-radius: var(--radius-full);
        border: 1.5px solid var(--color-primary);
        color: var(--color-primary);
        font-weight: 600;
        font-size: 14px;
        text-align: center;
        text-decoration: none;
        transition: background .15s, color .15s;
        background: transparent;
    }

        .btn-hj-course:hover {
            background: var(--color-primary);
            color: #fff;
        }

        .btn-hj-course.enrolled {
            background: var(--color-primary);
            color: #fff;
        }

    /* Enrolled badge inline */
    .hj-enrolled-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        font-weight: 600;
        color: #198754;
        margin-bottom: 10px;
    }

    /* Empty state */
    .hj-empty {
        border: 1px dashed var(--color-border);
        border-radius: 16px;
        background: #fff;
    }

    /* Anim */
    .fade-in {
        animation: fadeUp .4s ease both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .d1 {
        animation-delay: .05s
    }

    .d2 {
        animation-delay: .10s
    }

    .d3 {
        animation-delay: .15s
    }

    .d4 {
        animation-delay: .20s
    }

    .d5 {
        animation-delay: .25s
    }

    .d6 {
        animation-delay: .30s
    }
</style>