@model CoreLibrary.Data.Entities.PlacementTest
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex align-items-center mb-4">
    <a href="/admin/exams" class="btn btn-sm btn-light rounded-circle me-3" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;">
        <i class="bi bi-arrow-left fs-5"></i>
    </a>
    <div>
        <h3 class="mb-1 fw-bold">Biên tập Câu hỏi đề thi</h3>
        <p class="text-muted small mb-0">Đề thi: <span class="text-dark fw-bold">@Model.Title</span> (@(Model.Questions?.Count ?? 0) câu hỏi hiện có)</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- List Questions -->
    <div class="col-lg-8">
        <div class="d-flex flex-column gap-4">
            @{ int index = 1; }
            @foreach (var q in Model.Questions.OrderBy(x => x.QuestionId))
            {
                var optsList = q.AnswerOptions.ToList();
                int correctIdx = optsList.FindIndex(o => o.IsCorrect);
                if (correctIdx < 0) correctIdx = 0;

                <div class="card border-0 jp-omni-card rounded-4 p-4 shadow-sm">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-semibold">
                            Câu hỏi @index (@q.Points điểm)
                        </span>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editModal_@q.QuestionId">
                                <i class="bi bi-pencil me-1"></i>Sửa
                            </button>
                            <form asp-action="DeleteQuestion" asp-route-testId="@Model.TestId" method="post" onsubmit="return confirm('Bạn chắc chắn muốn xóa câu hỏi này?');" class="m-0">
                                <input type="hidden" name="questionId" value="@q.QuestionId" />
                                <button type="submit" class="btn btn-link text-danger p-0 ms-2">
                                    <i class="bi bi-trash3-fill fs-5"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 text-dark">@q.QuestionText</h5>

                    <div class="d-flex flex-column gap-2 mt-2">
                        @foreach (var opt in q.AnswerOptions)
                        {
                            <div class="d-flex align-items-center p-3 rounded-3" style="background-color: @(opt.IsCorrect ? "#e8f5e9" : "#f8f9fa") !important; border: 1px solid @(opt.IsCorrect ? "#2e7d32" : "#e0e0e0") !important; border-left: @(opt.IsCorrect ? "5px solid #2e7d32" : "1px solid #e0e0e0") !important;">
                                <i class="bi @(opt.IsCorrect ? "bi-check-circle-fill" : "bi-circle") me-3 fs-5" style="color: @(opt.IsCorrect ? "#2e7d32" : "#6c757d") !important;"></i>
                                <span class="fs-6 fw-semibold" style="color: @(opt.IsCorrect ? "#1b5e20" : "#212529") !important;">@opt.AnswerText</span>
                                @if (opt.IsCorrect)
                                {
                                    <span class="badge ms-auto px-3 py-1 small fw-bold" style="background-color: #2e7d32 !important; color: #ffffff !important;">Đáp án đúng</span>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Modal Sửa câu hỏi -->
                <div class="modal fade" id="editModal_@q.QuestionId" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                            <div class="modal-header bg-primary text-white py-3">
                                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Sửa câu hỏi #@index</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <form asp-action="EditQuestion" asp-route-testId="@Model.TestId" method="post">
                                <input type="hidden" name="questionId" value="@q.QuestionId" />
                                <div class="modal-body p-4">
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-muted">Nội dung câu hỏi</label>
                                        <textarea name="questionText" class="form-control rounded-3 text-dark bg-white" rows="3" required style="color: #212529 !important; background-color: #ffffff !important;">@q.QuestionText</textarea>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-muted">Số điểm</label>
                                        <input type="number" name="points" class="form-control rounded-3 text-dark bg-white" value="@q.Points" min="1" required style="color: #212529 !important; background-color: #ffffff !important;" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-muted d-block mb-2">Các lựa chọn & Chọn 1 đáp án đúng</label>
                                        <div class="d-flex flex-column gap-3">
                                            @for (int i = 0; i < 4; i++)
                                            {
                                                var val = i < optsList.Count ? optsList[i].AnswerText : "";
                                                bool isCorrectOpt = (i == correctIdx);
                                                <div class="input-group">
                                                    <div class="input-group-text border-end-0" style="background-color: @(isCorrectOpt ? "#e8f5e9" : "#f8f9fa") !important; border-color: @(isCorrectOpt ? "#2e7d32" : "#ced4da") !important;">
                                                        <input type="radio" name="correctIndex" value="@i" @(isCorrectOpt ? "checked" : "") class="form-check-input me-2" id="edit_opt_@(q.QuestionId)_@i" />
                                                        <label class="form-check-label small fw-bold" for="edit_opt_@(q.QuestionId)_@i" style="color: @(isCorrectOpt ? "#2e7d32" : "#6c757d") !important;">
                                                            @(isCorrectOpt ? "Đúng" : $"Đáp án {i+1}")
                                                        </label>
                                                    </div>
                                                    <input type="text" name="options" class="form-control fw-semibold" value="@val" placeholder="Nhập đáp án @(i+1)..." required style="color: #212529 !important; background-color: #ffffff !important; border-color: @(isCorrectOpt ? "#2e7d32" : "#ced4da") !important;" />
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer bg-light py-3">
                                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Cập nhật câu hỏi</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                index++;
            }

            @if (!Model.Questions.Any())
            {
                <div class="card border-0 jp-omni-card rounded-4 p-5 text-center text-muted">
                    <i class="bi bi-patch-question fs-1 mb-3"></i>
                    <h5>Đề thi chưa có câu hỏi nào</h5>
                    <p class="small mb-0">Hãy soạn thảo câu hỏi mới ở khung biên soạn bên phải.</p>
                </div>
            }
        </div>
    </div>

    <!-- Create Question Sidebar -->
    <div class="col-lg-4">
        <div class="card border-0 jp-omni-card rounded-4 p-4 sticky-top" style="top: 100px; z-index: 5;">
            <h5 class="fw-bold mb-4"><i class="bi bi-plus-circle-fill text-danger me-2"></i>Thêm câu hỏi mới</h5>
            <form asp-action="CreateQuestion" asp-route-testId="@Model.TestId" method="post">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted">Nội dung câu hỏi</label>
                    <textarea name="questionText" class="form-control rounded-3 text-dark bg-white" rows="3" placeholder="Nhập câu hỏi..." required style="color: #212529 !important; background-color: #ffffff !important;"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted">Số điểm</label>
                    <input type="number" name="points" class="form-control rounded-3 text-dark bg-white" value="10" min="1" required style="color: #212529 !important; background-color: #ffffff !important;" />
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted d-block mb-2">Các lựa chọn & Chọn 1 đáp án đúng</label>
                    <div class="d-flex flex-column gap-3">
                        @for (int i = 0; i < 4; i++)
                        {
                            <div class="input-group">
                                <div class="input-group-text bg-light border-end-0 text-muted">
                                    <input type="radio" name="correctIndex" value="@i" @(i == 0 ? "checked" : "") class="form-check-input me-2" id="create_opt_@i" />
                                    <label class="form-check-label small fw-bold" for="create_opt_@i">
                                        @(i == 0 ? "Đúng" : $"Đáp án {i+1}")
                                    </label>
                                </div>
                                <input type="text" name="options" class="form-control text-dark bg-white" placeholder="Nhập đáp án @(i+1)..." required style="color: #212529 !important; background-color: #ffffff !important;" />
                            </div>
                        }
                    </div>
                </div>

                <button type="submit" class="btn btn-jp-primary w-100 py-2.5 rounded-3 fw-bold">
                    <i class="bi bi-check-lg me-1"></i> Lưu câu hỏi
                </button>
            </form>
        </div>
    </div>
</div>
