        margin-top: 8px;
    }

    .audio-progress-fill {
        height: 100%;
        border-radius: 4px;
        background: var(--color-primary);
        width: 0%;
        transition: width .2s linear;
    }

    /* ═══ TÀI LIỆU ═══ */
    .material-card {
        display: flex;
        align-items: center;
        gap: 14px;
        background: var(--color-bg-soft);
        border: 1px solid var(--color-border);
